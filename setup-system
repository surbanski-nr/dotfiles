#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-system [--offline-release]

Install the approved operating-system packages on Debian 13, Ubuntu 24.04,
Ubuntu 26.04 or Amazon Linux 2023. This is the only setup entry point that
uses root privileges. With no flag, install packages for connected setup.
--offline-release installs only system prerequisites for a prepared release.
Both modes need access to the operating-system package repositories.
EOF
}

main() {
  MODE=connected
  case ${1:-} in
    '') ;;
    --offline-release)
      (($# == 1)) || report_error '--offline-release takes no arguments'
      MODE=runtime
      ;;
    -h | --help) (($# == 1)) || report_error 'help takes no arguments'; usage; return 0 ;;
    *) report_error "unexpected argument: $1" ;;
  esac
  # shellcheck source=system.env
  source "$REPO_DIR/system.env"
  validate_host
  install_packages
  verify_packages
}

validate_host() {
  local os_release_file=${SETUP_SYSTEM_OS_RELEASE_FILE:-/etc/os-release}

  [[ $(uname -s) == Linux ]] || report_error 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || report_error 'only Linux x86-64 is supported'
  [[ -r $os_release_file ]] || report_error "cannot read $os_release_file"
  # shellcheck disable=SC1090
  source "$os_release_file"
  case "${ID:-}:${VERSION_ID:-}" in
    debian:13 | ubuntu:24.04 | ubuntu:26.04 | amzn:2023)
      PLATFORM="$ID:$VERSION_ID"
      ;;
    *) report_error "unsupported distribution: ${ID:-unknown} ${VERSION_ID:-unknown}" ;;
  esac
  if ((EUID != 0)); then require_command sudo; fi
}

install_packages() {
  local -a root_command=()

  if ((EUID != 0)); then root_command=(sudo --); fi
  install_system_packages "$PLATFORM" "$MODE" false "${root_command[@]}"
}

verify_packages() {
  local command_name
  local -a commands=("${SYSTEM_RUNTIME_COMMANDS[@]}")

  if [[ $MODE == connected ]]; then
    commands+=("${SYSTEM_CONNECTED_COMMANDS[@]}")
  fi
  for command_name in "${commands[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 ||
      report_error "package installation did not provide $command_name"
  done
  if [[ $MODE == connected ]]; then
    printf 'setup-system: connected packages ready on %s\n' "$PLATFORM"
  else
    printf 'setup-system: offline-release prerequisites ready on %s\n' "$PLATFORM"
  fi
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
main "$@"
