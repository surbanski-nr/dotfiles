#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-system

Install normal host packages for setup-tools and setup-asdf on Debian 13,
Ubuntu 24.04, Ubuntu 26.04 or Amazon Linux 2023. Install Docker when absent;
leave existing container runtimes unchanged. Uses sudo for OS changes.
Network failures and timeouts are warnings; other errors stop setup.
For a prepared release, use dotfiles-release setup instead.
EOF
}

case ${1:-} in
  '') (($# == 0)) || { usage >&2; exit 2; } ;;
  -h | --help) (($# == 1)) || { usage >&2; exit 2; }; usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=system.env
source "$REPO_DIR/system.env"
# shellcheck source=scripts/setup-system-lib
source "$REPO_DIR/scripts/setup-system-lib"
setup_system setup
