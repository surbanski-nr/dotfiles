#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-system [--runtime]

Install the approved operating-system packages on Debian 13, Ubuntu 24.04,
Ubuntu 26.04 or Amazon Linux 2023. This is the only setup entry point that
uses root privileges. --runtime installs only prerequisites for a prepared
offline release.
EOF
}

main() {
  MODE=connected
  case ${1:-} in
    '') ;;
    --runtime) (($# == 1)) || setup_die '--runtime takes no arguments'; MODE=runtime ;;
    -h | --help) (($# == 1)) || setup_die 'help takes no arguments'; usage; return 0 ;;
    *) setup_die "unexpected argument: $1" ;;
  esac
  validate_host
  install_packages
  verify_packages
}

validate_host() {
  [[ $(uname -s) == Linux ]] || setup_die 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || setup_die 'only Linux x86-64 is supported'
  [[ -r /etc/os-release ]] || setup_die 'cannot read /etc/os-release'
  # shellcheck disable=SC1091
  source /etc/os-release
  case "${ID:-}:${VERSION_ID:-}" in
    debian:13 | ubuntu:24.04 | ubuntu:26.04 | amzn:2023)
      PLATFORM="$ID:$VERSION_ID"
      ;;
    *) setup_die "unsupported distribution: ${ID:-unknown} ${VERSION_ID:-unknown}" ;;
  esac
  if ((EUID != 0)); then setup_need sudo; fi
}

as_root() {
  if ((EUID == 0)); then "$@"; else sudo -- "$@"; fi
}

install_packages() {
  setup_system_package_list "$PLATFORM" "$MODE"
  case $PLATFORM in
    debian:* | ubuntu:*)
      as_root env DEBIAN_FRONTEND=noninteractive apt-get update
      as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y \
        "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
    amzn:2023)
      if [[ $MODE == connected ]]; then
        if rpm -q gnupg2-minimal >/dev/null 2>&1; then
          as_root dnf swap -y gnupg2-minimal gnupg2
        else
          as_root dnf install -y gnupg2
        fi
      fi
      as_root dnf install -y --allowerasing "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
  esac
}

verify_packages() {
  local command_name

  for command_name in bash cmp find flock git ip tar timeout unzip xz; do
    command -v "$command_name" >/dev/null 2>&1 ||
      setup_die "package installation did not provide $command_name"
  done
  if [[ $MODE == connected ]]; then
    for command_name in curl file gpg gpg-agent htop jq make mc python3 tmux vi vim; do
      command -v "$command_name" >/dev/null 2>&1 ||
        setup_die "package installation did not provide $command_name"
    done
  fi
  printf 'setup-system: %s packages ready on %s\n' "$MODE" "$PLATFORM"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
SETUP_PROGRAM=setup-system
PLATFORM=
MODE=
declare -a SETUP_SYSTEM_PACKAGES=()
main "$@"
