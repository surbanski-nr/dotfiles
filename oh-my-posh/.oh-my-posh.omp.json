{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/v30.6.5/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "{{ if .SSHSession }} {{ end }}{{ .UserName }} ",
          "foreground": "lightYellow",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "style": "full"
          },
          "template": "<#ffffff>in</> {{ .Path }} ",
          "foreground": "cyan",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "branch_icon": "<#ff94df><b> </b></>",
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "<#ffffff>on</> {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "#ff94df",
          "type": "git",
          "style": "plain"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": "󰇥  ",
          "foreground": "#ffffff",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if .Error }}#e91e63{{ end }}"
          ]
        },
        {
          "template": "",
          "foreground": "#ffff66",
          "type": "root",
          "style": "plain"
        },
        {
          "options": {
            "display_error": true
          },
          "template": "{{ if .Env.POSH_KUBE }}󱃾 {{ .Context }}::{{ if .Namespace }}{{ .Namespace }}{{ else }}default{{ end }}{{ end }}",
          "foreground": "lightBlue",
          "type": "kubectl",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "❯",
          "foreground": "lightGreen",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
