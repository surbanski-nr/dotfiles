# Trusted, secret-free Bash data used by the setup and release scripts.

declare -ga OFFLINE_TOOLS=(
  nvim
  nodejs
  python
  rg
  tmux
  oh-my-posh
  k9s
  zoxide
  kubectx
  kubens
  task
  fzf
  terraform
)

KUBECTX_VERSION=0.11.0
PYTHON_STANDALONE_BUILD=20260127
PIP_TOOLS_VERSION=7.6.1

