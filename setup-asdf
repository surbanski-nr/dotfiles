#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-asdf [NAME ...]

Install the pinned asdf executable, pin the selected project-tool plugins,
install every listed version and set the first version as the home default.

Names: terraform kubectl helm python nodejs terragrunt
EOF
}

main() {
  local -a requested=()

  while (($#)); do
    case $1 in
      -h | --help) usage; return 0 ;;
      --*) report_error "unknown option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done
  load_config
  if ((${#requested[@]} == 0)); then
    requested=("${ASDF_TOOLS[@]}")
  fi
  validate_host
  normalize_requested "${requested[@]}"
  preflight
  install_asdf
  export PATH="$BIN_DIR:$ASDF_DATA_DIR/shims:$PATH"
  reconcile_tools "${NORMALIZED_TOOLS[@]}"
}

load_config() {
  # shellcheck source=versions.env
  source "$REPO_DIR/versions.env"
  validate_tool_config
  select_default_release TOOL_RELEASES asdf
  ASDF_VERSION=$RELEASE_VERSION
  BIN_DIR=${SETUP_ASDF_BIN_DIR:-$HOME/bin}
  ASDF_DATA_DIR=${ASDF_DATA_DIR:-$HOME/.asdf}
  export ASDF_DATA_DIR
  STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/setup-asdf
}

validate_host() {
  [[ $(uname -s) == Linux ]] || report_error 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || report_error 'only Linux x86-64 is supported'
  for command_name in awk cmp curl find git sha256sum tar mktemp mv ln readlink; do
    require_command "$command_name"
  done
}

normalize_requested() {
  local name
  local allowed
  local supported
  local seen=' '

  NORMALIZED_TOOLS=()
  for name in "$@"; do
    supported=0
    for allowed in "${ASDF_TOOLS[@]}"; do
      if [[ $name == "$allowed" ]]; then supported=1; break; fi
    done
    ((supported == 1)) || report_error "unknown project tool: $name"
    if [[ $seen != *" $name "* ]]; then
      NORMALIZED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

plugin_spec() {
  local name=$1

  [[ -v ASDF_PLUGINS[$name] ]] ||
    report_error "missing asdf plugin mapping for $name" || return
  IFS='|' read -r PLUGIN_REPO PLUGIN_COMMIT <<<"${ASDF_PLUGINS[$name]}"
  release_versions TOOL_RELEASES "$name" || return
  TOOL_VERSIONS=("${RELEASE_VERSIONS[@]}")
}

preflight_asdf_link() {
  local link="$BIN_DIR/asdf"
  local state=$STATE_DIR/asdf-target
  local target version output recorded extra actual install_state

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    if [[ ! -e $state && ! -L $state ]]; then
      [[ $target == "asdf-$ASDF_VERSION" ]] ||
        report_error "legacy asdf target is not the current pinned version: $link -> $target"
      [[ -f $BIN_DIR/$target && -x $BIN_DIR/$target && ! -L $BIN_DIR/$target ]] ||
        report_error "invalid legacy asdf target: $BIN_DIR/$target"
      output=$("$BIN_DIR/$target" version 2>&1) ||
        report_error "legacy asdf target failed: $BIN_DIR/$target"
      [[ $output == *"$ASDF_VERSION"* ]] ||
        report_error "legacy asdf target did not report $ASDF_VERSION"
      LEGACY_ASDF_TARGET=$target
      return
    fi
    [[ -f $state && ! -L $state ]] || report_error "invalid asdf ownership state: $state"
    IFS=$'\t' read -r recorded extra <"$state" || report_error "empty asdf state: $state"
    [[ -z $extra && $recorded =~ ^asdf-v?[0-9]+([.][0-9]+){1,3}$ ]] ||
      report_error "invalid asdf state: $state"
    [[ $recorded == "$target" ]] ||
      report_error "managed asdf link differs from recorded target: $link"
    [[ $target =~ ^asdf-v?([0-9]+([.][0-9]+){1,3})$ ]] ||
      report_error "refusing foreign link: $link -> $target"
    version=${BASH_REMATCH[1]}
    [[ -f $BIN_DIR/$target && -x $BIN_DIR/$target && ! -L $BIN_DIR/$target ]] ||
      report_error "invalid managed asdf target: $BIN_DIR/$target"
    output=$("$BIN_DIR/$target" version 2>&1) ||
      report_error "managed asdf target failed: $BIN_DIR/$target"
    [[ $output == *"$version"* ]] ||
      report_error "managed asdf target did not report $version"
    install_state=$STATE_DIR/installations/$target.sha256
    [[ -f $install_state && ! -L $install_state ]] ||
      report_error "asdf installation has no ownership state: $BIN_DIR/$target"
    actual=$(sha256sum "$BIN_DIR/$target" | awk '{print $1}')
    [[ $(<"$install_state") == "$actual" ]] ||
      report_error "managed asdf target was modified: $BIN_DIR/$target"
  elif [[ -e $link ]]; then
    report_error "refusing unmanaged path: $link"
  elif [[ -e $state || -L $state ]]; then
    report_error "asdf ownership state exists without its managed link: $state"
  fi
  if [[ -e $BIN_DIR/asdf-$ASDF_VERSION || -L $BIN_DIR/asdf-$ASDF_VERSION ]]; then
    [[ -f $BIN_DIR/asdf-$ASDF_VERSION && -x $BIN_DIR/asdf-$ASDF_VERSION &&
      ! -L $BIN_DIR/asdf-$ASDF_VERSION ]] ||
      report_error "invalid asdf installation: $BIN_DIR/asdf-$ASDF_VERSION"
    install_state=$STATE_DIR/installations/asdf-$ASDF_VERSION.sha256
    if [[ $LEGACY_ASDF_TARGET != "asdf-$ASDF_VERSION" ]]; then
      [[ -f $install_state && ! -L $install_state ]] ||
        report_error "refusing unmanaged asdf installation: $BIN_DIR/asdf-$ASDF_VERSION"
      actual=$(sha256sum "$BIN_DIR/asdf-$ASDF_VERSION" | awk '{print $1}')
      [[ $(<"$install_state") == "$actual" ]] ||
        report_error "managed asdf installation was modified: $BIN_DIR/asdf-$ASDF_VERSION"
    fi
  fi
}

preflight_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local remote

  plugin_spec "$name"
  if [[ -e $directory || -L $directory ]]; then
    [[ -d $directory/.git && ! -L $directory ]] ||
      report_error "asdf plugin is not a Git checkout: $directory"
    remote=$(git -C "$directory" remote get-url origin)
    [[ $remote == "$PLUGIN_REPO" || ${remote%.git} == "${PLUGIN_REPO%.git}" ]] ||
      report_error "$name plugin uses unexpected origin: $remote"
    if ! git -C "$directory" diff --quiet --ignore-submodules -- ||
      ! git -C "$directory" diff --cached --quiet --ignore-submodules --; then
      report_error "$name plugin checkout has local changes"
    fi
  fi
}

preflight_project_command() {
  local name=$1
  local command_name=$name
  local path

  case $name in
    nodejs) command_name=node ;;
  esac
  path="$BIN_DIR/$command_name"
  if [[ -e $path || -L $path ]]; then
    report_error "$name conflicts with the direct launcher: $path"
  fi
}

preflight() {
  local name

  if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
    [[ -d $BIN_DIR && ! -L $BIN_DIR ]] || report_error "invalid bin directory: $BIN_DIR"
  fi
  if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
    [[ -d $STATE_DIR && ! -L $STATE_DIR ]] || report_error "invalid state directory: $STATE_DIR"
  fi
  preflight_asdf_link
  for name in "${NORMALIZED_TOOLS[@]}"; do
    preflight_project_command "$name"
    preflight_plugin "$name"
  done
  mkdir -p "$BIN_DIR" "$STATE_DIR"
  mkdir -- "$STATE_DIR/lock" 2>/dev/null ||
    report_error 'another setup-asdf process is running'
  LOCK_DIR=$STATE_DIR/lock
}

install_asdf() {
  local destination="$BIN_DIR/asdf-$ASDF_VERSION"
  local link="$BIN_DIR/asdf"
  local archive
  local executable
  local output
  local stage
  local state="$STATE_DIR/asdf-target"
  local install_state="$STATE_DIR/installations/asdf-$ASDF_VERSION.sha256"
  local state_temporary digest

  select_release TOOL_RELEASES asdf "$ASDF_VERSION"
  artifact_layout asdf "$ASDF_VERSION" "$RELEASE_ASSET"

  if [[ -f $destination && -z $LEGACY_ASDF_TARGET ]]; then
    output=$("$destination" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      report_error "existing asdf binary did not report $ASDF_VERSION"
  else
    stage=$(mktemp -d "$BIN_DIR/.setup-asdf.XXXXXX")
    TEMP_PATHS+=("$stage")
    archive="$stage/$RELEASE_ASSET"
    executable="$stage/asdf-$ASDF_VERSION"
    download_file "$RELEASE_URL" "$archive"
    prepare_artifact TOOL_RELEASES asdf "$ASDF_VERSION" "$archive" "$stage"
    output=$("$executable" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      report_error "downloaded asdf did not report $ASDF_VERSION"
    if [[ -n $LEGACY_ASDF_TARGET ]]; then
      cmp -s "$executable" "$destination" ||
        report_error 'legacy asdf binary does not match the verified upstream archive'
    else
      mv -- "$executable" "$destination"
    fi
    mkdir -p "$STATE_DIR/installations"
    digest=$(sha256sum "$destination" | awk '{print $1}')
    state_temporary=$(mktemp "$STATE_DIR/installations/.asdf-install.XXXXXX")
    TEMP_PATHS+=("$state_temporary")
    printf '%s\n' "$digest" >"$state_temporary"
    chmod 0600 "$state_temporary"
    mv -T -- "$state_temporary" "$install_state"
    if [[ -n $LEGACY_ASDF_TARGET ]]; then
      printf 'setup-asdf: adopted verified legacy asdf %s\n' "$ASDF_VERSION"
    else
      printf 'setup-asdf: installed asdf %s\n' "$ASDF_VERSION"
    fi
  fi
  temporary_link="$BIN_DIR/.asdf.link.$$"
  state_temporary=$(mktemp "$STATE_DIR/.asdf-state.XXXXXX")
  TEMP_PATHS+=("$state_temporary")
  printf '%s\n' "asdf-$ASDF_VERSION" >"$state_temporary"
  chmod 0600 "$state_temporary"
  ln -s -- "asdf-$ASDF_VERSION" "$temporary_link"
  TEMP_PATHS+=("$temporary_link")
  mv -T -- "$temporary_link" "$link"
  mv -T -- "$state_temporary" "$state"
}

pin_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local current

  plugin_spec "$name"
  if [[ ! -d $directory ]]; then
    "$BIN_DIR/asdf" plugin add "$name" "$PLUGIN_REPO"
  fi
  current=$(git -C "$directory" rev-parse HEAD)
  if [[ $current != "$PLUGIN_COMMIT" ]]; then
    git -C "$directory" fetch --depth 1 origin "$PLUGIN_COMMIT"
    git -C "$directory" checkout --detach "$PLUGIN_COMMIT"
  fi
  [[ $(git -C "$directory" rev-parse HEAD) == "$PLUGIN_COMMIT" ]] ||
    report_error "failed to pin $name plugin"
}

reconcile_tool() {
  local name=$1
  local version
  local -a versions=()

  plugin_spec "$name"
  versions=("${TOOL_VERSIONS[@]}")
  pin_plugin "$name"
  for version in "${versions[@]}"; do
    if "$BIN_DIR/asdf" list "$name" "$version" 2>/dev/null |
      awk -v wanted="$version" '{sub(/^[* ]+/, ""); if ($1 == wanted) found=1} END {exit !found}'; then
      printf 'setup-asdf: reuse %s %s\n' "$name" "$version"
    else
      "$BIN_DIR/asdf" install "$name" "$version"
      printf 'setup-asdf: installed %s %s\n' "$name" "$version"
    fi
    "$BIN_DIR/asdf" reshim "$name" "$version"
  done
}

select_tool() {
  local name=$1
  local first

  plugin_spec "$name"
  first=${TOOL_VERSIONS[0]}
  "$BIN_DIR/asdf" set -u "$name" "$first"
  printf 'setup-asdf: selected %s %s for home\n' "$name" "$first"
}

reconcile_tools() {
  local name
  for name in "$@"; do reconcile_tool "$name"; done
  for name in "$@"; do select_tool "$name"; done
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then find "$path" -depth -delete; fi
  done
  if [[ -n ${LOCK_DIR:-} && -d $LOCK_DIR && ! -L $LOCK_DIR ]]; then
    rmdir -- "$LOCK_DIR"
  fi
  exit "$status"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
PROGRAM=setup-asdf
declare -a NORMALIZED_TOOLS=()
declare -a TEMP_PATHS=()
BIN_DIR=
STATE_DIR=
LOCK_DIR=
LEGACY_ASDF_TARGET=
PLUGIN_REPO=
PLUGIN_COMMIT=
declare -a TOOL_VERSIONS=()
temporary_link=
ASDF_VERSION=
RELEASE_VERSION=
RELEASE_URL=
RELEASE_SHA256=
RELEASE_ASSET=
trap cleanup EXIT
main "$@"
