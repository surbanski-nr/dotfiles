#!/usr/bin/env bash

set -euo pipefail

usage() {
  local -a names=()
  cat <<'EOF'
Usage: setup-asdf [NAME ...]

Install the pinned asdf executable, pin the selected project-tool plugins,
install every listed version and set the first version as the home default.

EOF
  mapfile -t names < <(printf '%s\n' "${!ASDF_PLUGINS[@]}" | LC_ALL=C sort)
  printf 'Names:'
  printf ' %s' "${names[@]}"
  printf '\n'
}

main() {
  local -a requested=()

  while (($#)); do
    case $1 in
      -h | --help)
        usage
        return 0
        ;;
      --*) report_error "unknown option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done
  load_config
  if ((${#requested[@]} == 0)); then
    mapfile -t requested < <(printf '%s\n' "${!ASDF_PLUGINS[@]}" | LC_ALL=C sort)
  fi
  validate_host
  select_requested_tools "${requested[@]}"
  preflight
  install_asdf
  export PATH="$BIN_DIR:$ASDF_DATA_DIR/shims:$PATH"
  reconcile_tools "${SELECTED_TOOLS[@]}"
}

load_config() {
  # shellcheck source=system.env
  source "$REPO_DIR/system.env"
  validate_tool_config
  select_default_release TOOL_RELEASES asdf
  ASDF_VERSION=$RELEASE_VERSION
  BIN_DIR=${SETUP_ASDF_BIN_DIR:-$HOME/bin}
  ASDF_DATA_DIR=${ASDF_DATA_DIR:-$HOME/.asdf}
  export ASDF_DATA_DIR
  STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/setup-asdf
}

validate_host() {
  [[ $(uname -s) == Linux ]] || report_error 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || report_error 'only Linux x86-64 is supported'
  require_setup_commands setup-asdf
}

# Validate supported plugin names and deduplicate requests before reconciliation.
select_requested_tools() {
  local name
  local seen=' '

  SELECTED_TOOLS=()
  for name in "$@"; do
    if [[ ! -v ASDF_PLUGINS[$name] ]]; then
      report_error "unknown project tool: $name"
      return 1
    fi
    if [[ $seen != *" $name "* ]]; then
      SELECTED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

plugin_spec() {
  local name=$1

  if [[ ! -v ASDF_PLUGINS[$name] ]]; then
    report_error "missing asdf plugin mapping for $name"
    return 1
  fi
  IFS='|' read -r PLUGIN_REPO PLUGIN_COMMIT <<<"${ASDF_PLUGINS[$name]}"
  release_versions TOOL_RELEASES "$name" || return
  TOOL_VERSIONS=("${RELEASE_VERSIONS[@]}")
}

# Verify retained payloads by recorded content, not just plausible version output.
verify_asdf_payload() {
  local target=$1
  local executable="$BIN_DIR/$target"
  local record="$STATE_DIR/installations/$target.sha256"
  local actual recorded

  if [[ ! -f $executable || ! -x $executable || -L $executable ]]; then
    report_error "invalid managed asdf target: $executable"
    return 1
  fi
  if [[ ! -f $record || -L $record ]]; then
    report_error "refusing unmanaged asdf installation: $executable"
    return 1
  fi
  recorded=$(<"$record")
  validate_digest asdf-installation "$recorded" || return
  actual=$(sha256sum "$executable" | awk '{print $1}') || return
  if [[ $actual != "$recorded" ]]; then
    report_error "managed asdf installation was modified: $executable"
    return 1
  fi
}

# Legacy adoption is deliberately narrow and later requires byte-for-byte
# comparison with the checksum-verified upstream executable.
preflight_legacy_asdf() {
  local target=$1 output

  if [[ $target != "asdf-$ASDF_VERSION" ]]; then
    report_error "legacy asdf target is not the current pinned version: $BIN_DIR/asdf -> $target"
    return 1
  fi
  if [[ ! -f $BIN_DIR/$target || ! -x $BIN_DIR/$target || -L $BIN_DIR/$target ]]; then
    report_error "invalid legacy asdf target: $BIN_DIR/$target"
    return 1
  fi
  output=$("$BIN_DIR/$target" version 2>&1) || return
  if [[ $output != *"$ASDF_VERSION"* ]]; then
    report_error "legacy asdf target did not report $ASDF_VERSION"
    return 1
  fi
  LEGACY_ASDF_TARGET=$target
}

# Distinguish a fresh home, verified managed selection, and eligible legacy link.
preflight_asdf_link() {
  local link="$BIN_DIR/asdf" state="$STATE_DIR/asdf-target"
  local target recorded

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    if [[ ! -e $state && ! -L $state ]]; then
      preflight_legacy_asdf "$target"
      return
    fi
    if [[ ! -f $state || -L $state ]]; then
      report_error "invalid asdf ownership state: $state"
      return 1
    fi
    recorded=$(<"$state")
    if [[ ! $recorded =~ ^asdf-v?[0-9]+([.][0-9]+){1,3}$ ]]; then
      report_error "invalid asdf state: $state"
      return 1
    fi
    if [[ $recorded != "$target" ]]; then
      report_error "managed asdf link differs from recorded target: $link"
      return 1
    fi
    verify_asdf_payload "$target"
  elif [[ -e $link ]]; then
    report_error "refusing unmanaged path: $link"
    return 1
  elif [[ -e $state || -L $state ]]; then
    report_error "asdf ownership state exists without its managed link: $state"
    return 1
  fi

  target="asdf-$ASDF_VERSION"
  if [[ $LEGACY_ASDF_TARGET == "$target" ]]; then return 0; fi
  if [[ -e $BIN_DIR/$target || -L $BIN_DIR/$target ]]; then
    verify_asdf_payload "$target"
  fi
}

# Reject foreign repositories and tracked edits before asdf can update a plugin.
preflight_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local remote

  plugin_spec "$name"
  if [[ ! -e $directory && ! -L $directory ]]; then return 0; fi
  if [[ ! -d $directory/.git || -L $directory ]]; then
    report_error "asdf plugin is not a Git checkout: $directory"
    return 1
  fi
  remote=$(git -C "$directory" remote get-url origin)
  if [[ ${remote%.git} != "${PLUGIN_REPO%.git}" ]]; then
    report_error "$name plugin uses unexpected origin: $remote"
    return 1
  fi
  if ! git -C "$directory" diff --quiet --ignore-submodules --; then
    report_error "$name plugin checkout has local changes"
    return 1
  fi
  if ! git -C "$directory" diff --cached --quiet --ignore-submodules --; then
    report_error "$name plugin checkout has local changes"
    return 1
  fi
}

preflight_project_command() {
  local name=$1
  local command_name=$name
  local path

  case $name in
    nodejs) command_name=node ;;
  esac
  path="$BIN_DIR/$command_name"
  if [[ -e $path || -L $path ]]; then
    report_error "$name conflicts with the direct launcher: $path"
  fi
}

preflight() {
  local name

  if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
    [[ -d $BIN_DIR && ! -L $BIN_DIR ]] || report_error "invalid bin directory: $BIN_DIR"
  fi
  if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
    [[ -d $STATE_DIR && ! -L $STATE_DIR ]] || report_error "invalid state directory: $STATE_DIR"
  fi
  if [[ -L $STATE_DIR/installations ||
    ( -e $STATE_DIR/installations && ! -d $STATE_DIR/installations ) ]]; then
    report_error "invalid asdf installation state directory: $STATE_DIR/installations"
    return 1
  fi
  mkdir -p "$BIN_DIR" "$STATE_DIR"
  acquire_setup_lock "$STATE_DIR/lock" 'another setup-asdf process is running'
  for name in "${SELECTED_TOOLS[@]}"; do
    preflight_project_command "$name"
    preflight_plugin "$name"
  done
  recover_asdf_publication
  preflight_asdf_link
}

# Publish small ownership records atomically; a failed rename leaves the old one.
write_asdf_record() {
  local path=$1 value=$2 temporary
  temporary=$(mktemp "$STATE_DIR/.asdf-state.XXXXXX")
  TEMP_PATHS+=("$temporary")
  printf '%s\n' "$value" >"$temporary"
  chmod 0600 "$temporary"
  mv -T -- "$temporary" "$path"
}

# A journal bridges the link/ownership-record renames. Retry may finish only the
# recorded old or new selection; an unrelated link is never replaced.
recover_asdf_publication() {
  local recovering=${1:-true}
  local pending="$STATE_DIR/pending-selection" state="$STATE_DIR/asdf-target"
  local target previous extra current=- recorded=- temporary

  if [[ ! -e $pending && ! -L $pending ]]; then return 0; fi
  if [[ ! -f $pending || -L $pending || $(wc -l <"$pending") != 1 ]]; then
    report_error "invalid asdf selection journal: $pending"
    return 1
  fi
  IFS=$'\t' read -r target previous extra <"$pending"
  if [[ -n $extra || ! $target =~ ^asdf-v?[0-9]+([.][0-9]+){1,3}$ ||
    ( $previous != - && ! $previous =~ ^asdf-v?[0-9]+([.][0-9]+){1,3}$ ) ]]; then
    report_error "invalid asdf selection journal: $pending"
    return 1
  fi
  if [[ -L $BIN_DIR/asdf ]]; then
    current=$(readlink -- "$BIN_DIR/asdf")
  elif [[ -e $BIN_DIR/asdf ]]; then
    report_error "refusing unmanaged path: $BIN_DIR/asdf"
    return 1
  fi
  if [[ -e $state || -L $state ]]; then
    if [[ ! -f $state || -L $state ]]; then
      report_error "invalid asdf ownership state: $state"
      return 1
    fi
    recorded=$(<"$state")
  fi
  if [[ ( $current != "$previous" && $current != "$target" ) ||
    ( $recorded != "$previous" && $recorded != "$target" ) ]]; then
    report_error 'asdf selection changed outside the pending operation'
    return 1
  fi
  verify_asdf_payload "$target"
  temporary="$BIN_DIR/.asdf.link.$$"
  ln -s -- "$target" "$temporary"
  TEMP_PATHS+=("$temporary")
  mv -T -- "$temporary" "$BIN_DIR/asdf"
  write_asdf_record "$state" "$target"
  unlink -- "$pending"
  if [[ $recovering == true ]]; then
    printf 'setup-asdf: recovered selection %s\n' "$target"
  fi
}

install_asdf() {
  local destination="$BIN_DIR/asdf-$ASDF_VERSION"
  local link="$BIN_DIR/asdf"
  local archive
  local executable
  local output
  local stage
  local state="$STATE_DIR/asdf-target"
  local install_state="$STATE_DIR/installations/asdf-$ASDF_VERSION.sha256"
  local digest previous=-

  select_release TOOL_RELEASES asdf "$ASDF_VERSION"
  artifact_layout asdf "$ASDF_VERSION" "$RELEASE_ASSET"

  if [[ -f $destination && -z $LEGACY_ASDF_TARGET ]]; then
    output=$("$destination" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      report_error "existing asdf binary did not report $ASDF_VERSION"
  else
    stage=$(mktemp -d "$BIN_DIR/.setup-asdf.XXXXXX")
    TEMP_PATHS+=("$stage")
    archive="$stage/$RELEASE_ASSET"
    executable="$stage/asdf-$ASDF_VERSION"
    download_file "$RELEASE_URL" "$archive"
    prepare_artifact TOOL_RELEASES asdf "$ASDF_VERSION" "$archive" "$stage"
    output=$("$executable" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      report_error "downloaded asdf did not report $ASDF_VERSION"
    if [[ -n $LEGACY_ASDF_TARGET ]]; then
      cmp -s "$executable" "$destination" ||
        report_error 'legacy asdf binary does not match the verified upstream archive'
    fi
    mkdir -p "$STATE_DIR/installations"
    digest=$(sha256sum "$executable" | awk '{print $1}')
    if [[ -e $install_state || -L $install_state ]]; then
      if [[ ! -f $install_state || -L $install_state || $(<"$install_state") != "$digest" ]]; then
        report_error "asdf installation digest differs: $install_state"
        return 1
      fi
    fi
    # Record verified ownership before moving the binary so a failed publication
    # is retryable without treating our own executable as an unmanaged file.
    write_asdf_record "$install_state" "$digest"
    if [[ -z $LEGACY_ASDF_TARGET ]]; then mv -- "$executable" "$destination"; fi
    if [[ -n $LEGACY_ASDF_TARGET ]]; then
      printf 'setup-asdf: adopted verified legacy asdf %s\n' "$ASDF_VERSION"
    else
      printf 'setup-asdf: installed asdf %s\n' "$ASDF_VERSION"
    fi
  fi
  if [[ -L $link ]]; then previous=$(readlink -- "$link"); fi
  if [[ $previous == "asdf-$ASDF_VERSION" && -z $LEGACY_ASDF_TARGET ]]; then return 0; fi
  # Verified legacy adoption establishes the old selection before journaling it.
  if [[ -n $LEGACY_ASDF_TARGET ]]; then write_asdf_record "$state" "$previous"; fi
  write_asdf_record "$STATE_DIR/pending-selection" "asdf-$ASDF_VERSION"$'\t'"$previous"
  recover_asdf_publication false
}

pin_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local current

  plugin_spec "$name"
  if [[ ! -d $directory ]]; then
    "$BIN_DIR/asdf" plugin add "$name" "$PLUGIN_REPO"
  fi
  current=$(git -C "$directory" rev-parse HEAD)
  if [[ $current != "$PLUGIN_COMMIT" ]]; then
    git -C "$directory" fetch --depth 1 origin "$PLUGIN_COMMIT"
    git -C "$directory" checkout --detach "$PLUGIN_COMMIT"
  fi
  [[ $(git -C "$directory" rev-parse HEAD) == "$PLUGIN_COMMIT" ]] ||
    report_error "failed to pin $name plugin"
}

# asdf owns provider downloads and runtime recovery; reshim also runs on reuse.
reconcile_tool() {
  local name=$1
  local version
  local -a versions=()

  plugin_spec "$name"
  versions=("${TOOL_VERSIONS[@]}")
  pin_plugin "$name"
  for version in "${versions[@]}"; do
    if "$BIN_DIR/asdf" list "$name" "$version" 2>/dev/null |
      awk -v wanted="$version" '{sub(/^[* ]+/, ""); if ($1 == wanted) found=1} END {exit !found}'; then
      printf 'setup-asdf: reuse %s %s\n' "$name" "$version"
    else
      "$BIN_DIR/asdf" install "$name" "$version"
      printf 'setup-asdf: installed %s %s\n' "$name" "$version"
    fi
    "$BIN_DIR/asdf" reshim "$name" "$version"
  done
}

select_tool() {
  local name=$1
  local first

  plugin_spec "$name"
  first=${TOOL_VERSIONS[0]}
  "$BIN_DIR/asdf" set -u "$name" "$first"
  printf 'setup-asdf: selected %s %s for home\n' "$name" "$first"
}

reconcile_tools() {
  local name
  for name in "$@"; do reconcile_tool "$name"; done
  for name in "$@"; do select_tool "$name"; done
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then find "$path" -depth -delete; fi
  done
  release_setup_locks
  exit "$status"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
# shellcheck source=versions.env
source "$REPO_DIR/versions.env"
# Traps need empty cleanup collections even when --help does no setup work.
declare -a TEMP_PATHS=()
declare -a HELD_LOCK_FDS=()
LEGACY_ASDF_TARGET=
trap cleanup EXIT
main "$@"
