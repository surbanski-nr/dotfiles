#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-asdf [NAME ...]

Install the pinned asdf executable, pin the selected project-tool plugins,
install every listed version and set the first version as the home default.

Names: terraform kubectl helm python nodejs terragrunt
EOF
}

main() {
  local -a requested=()

  while (($#)); do
    case $1 in
      -h | --help) usage; return 0 ;;
      --*) setup_die "unknown option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done
  if ((${#requested[@]} == 0)); then
    requested=(terraform kubectl helm python nodejs terragrunt)
  fi

  load_config
  validate_host
  normalize_requested "${requested[@]}"
  preflight
  install_asdf
  export PATH="$BIN_DIR:$ASDF_DATA_DIR/shims:$PATH"
  reconcile_tools "${NORMALIZED_TOOLS[@]}"
}

load_config() {
  # shellcheck source=versions.env
  source "$REPO_DIR/versions.env"
  setup_validate_versions
  BIN_DIR=${SETUP_ASDF_BIN_DIR:-$HOME/bin}
  ASDF_DATA_DIR=${ASDF_DATA_DIR:-$HOME/.asdf}
  export ASDF_DATA_DIR
  STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/setup-asdf
}

validate_host() {
  [[ $(uname -s) == Linux ]] || setup_die 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || setup_die 'only Linux x86-64 is supported'
  for command_name in awk curl find git sha256sum tar mktemp mv ln readlink; do
    setup_need "$command_name"
  done
}

normalize_requested() {
  local name
  local seen=' '

  NORMALIZED_TOOLS=()
  for name in "$@"; do
    case $name in
      terraform | kubectl | helm | python | nodejs | terragrunt) ;;
      *) setup_die "unknown project tool: $name" ;;
    esac
    if [[ $seen != *" $name "* ]]; then
      NORMALIZED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

plugin_spec() {
  case $1 in
    terraform)
      PLUGIN_REPO=$ASDF_TERRAFORM_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_TERRAFORM_PLUGIN_COMMIT
      TOOL_VERSIONS=("${TERRAFORM_VERSIONS[@]}")
      ;;
    kubectl)
      PLUGIN_REPO=$ASDF_KUBECTL_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_KUBECTL_PLUGIN_COMMIT
      TOOL_VERSIONS=("${KUBECTL_VERSIONS[@]}")
      ;;
    helm)
      PLUGIN_REPO=$ASDF_HELM_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_HELM_PLUGIN_COMMIT
      TOOL_VERSIONS=("${HELM_VERSIONS[@]}")
      ;;
    python)
      PLUGIN_REPO=$ASDF_PYTHON_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_PYTHON_PLUGIN_COMMIT
      TOOL_VERSIONS=("${PYTHON_VERSIONS[@]}")
      ;;
    nodejs)
      PLUGIN_REPO=$ASDF_NODEJS_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_NODEJS_PLUGIN_COMMIT
      TOOL_VERSIONS=("${NODEJS_VERSIONS[@]}")
      ;;
    terragrunt)
      PLUGIN_REPO=$ASDF_TERRAGRUNT_PLUGIN_REPO
      PLUGIN_COMMIT=$ASDF_TERRAGRUNT_PLUGIN_COMMIT
      TOOL_VERSIONS=("${TERRAGRUNT_VERSIONS[@]}")
      ;;
    *) setup_die "missing asdf plugin mapping for $1" ;;
  esac
}

preflight_asdf_link() {
  local link="$BIN_DIR/asdf"
  local state=$STATE_DIR/asdf-target
  local target version output recorded extra actual install_state

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    [[ -f $state && ! -L $state ]] || setup_die "asdf link has no ownership state: $link"
    IFS=$'\t' read -r recorded extra <"$state" || setup_die "empty asdf state: $state"
    [[ -z $extra && $recorded =~ ^asdf-v?[0-9]+([.][0-9]+){1,3}$ ]] ||
      setup_die "invalid asdf state: $state"
    [[ $recorded == "$target" ]] ||
      setup_die "managed asdf link differs from recorded target: $link"
    [[ $target =~ ^asdf-v?([0-9]+([.][0-9]+){1,3})$ ]] ||
      setup_die "refusing foreign link: $link -> $target"
    version=${BASH_REMATCH[1]}
    [[ -f $BIN_DIR/$target && -x $BIN_DIR/$target && ! -L $BIN_DIR/$target ]] ||
      setup_die "invalid managed asdf target: $BIN_DIR/$target"
    output=$("$BIN_DIR/$target" version 2>&1) ||
      setup_die "managed asdf target failed: $BIN_DIR/$target"
    [[ $output == *"$version"* ]] ||
      setup_die "managed asdf target did not report $version"
    install_state=$STATE_DIR/installations/$target.sha256
    [[ -f $install_state && ! -L $install_state ]] ||
      setup_die "asdf installation has no ownership state: $BIN_DIR/$target"
    actual=$(sha256sum "$BIN_DIR/$target" | awk '{print $1}')
    [[ $(<"$install_state") == "$actual" ]] ||
      setup_die "managed asdf target was modified: $BIN_DIR/$target"
  elif [[ -e $link ]]; then
    setup_die "refusing unmanaged path: $link"
  elif [[ -e $state || -L $state ]]; then
    setup_die "asdf ownership state exists without its managed link: $state"
  fi
  if [[ -e $BIN_DIR/asdf-$ASDF_VERSION || -L $BIN_DIR/asdf-$ASDF_VERSION ]]; then
    [[ -f $BIN_DIR/asdf-$ASDF_VERSION && -x $BIN_DIR/asdf-$ASDF_VERSION &&
      ! -L $BIN_DIR/asdf-$ASDF_VERSION ]] ||
      setup_die "invalid asdf installation: $BIN_DIR/asdf-$ASDF_VERSION"
    install_state=$STATE_DIR/installations/asdf-$ASDF_VERSION.sha256
    [[ -f $install_state && ! -L $install_state ]] ||
      setup_die "refusing unmanaged asdf installation: $BIN_DIR/asdf-$ASDF_VERSION"
    actual=$(sha256sum "$BIN_DIR/asdf-$ASDF_VERSION" | awk '{print $1}')
    [[ $(<"$install_state") == "$actual" ]] ||
      setup_die "managed asdf installation was modified: $BIN_DIR/asdf-$ASDF_VERSION"
  fi
}

preflight_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local remote

  plugin_spec "$name"
  if [[ -e $directory || -L $directory ]]; then
    [[ -d $directory/.git && ! -L $directory ]] ||
      setup_die "asdf plugin is not a Git checkout: $directory"
    remote=$(git -C "$directory" remote get-url origin)
    [[ $remote == "$PLUGIN_REPO" || ${remote%.git} == "${PLUGIN_REPO%.git}" ]] ||
      setup_die "$name plugin uses unexpected origin: $remote"
    if ! git -C "$directory" diff --quiet --ignore-submodules -- ||
      ! git -C "$directory" diff --cached --quiet --ignore-submodules --; then
      setup_die "$name plugin checkout has local changes"
    fi
  fi
}

preflight_project_command() {
  local name=$1
  local command_name=$name
  local path

  case $name in
    nodejs) command_name=node ;;
  esac
  path="$BIN_DIR/$command_name"
  if [[ -e $path || -L $path ]]; then
    setup_die "$name conflicts with the direct launcher: $path"
  fi
}

preflight() {
  local name

  if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
    [[ -d $BIN_DIR && ! -L $BIN_DIR ]] || setup_die "invalid bin directory: $BIN_DIR"
  fi
  if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
    [[ -d $STATE_DIR && ! -L $STATE_DIR ]] || setup_die "invalid state directory: $STATE_DIR"
  fi
  preflight_asdf_link
  for name in "${NORMALIZED_TOOLS[@]}"; do
    preflight_project_command "$name"
    preflight_plugin "$name"
  done
  mkdir -p "$BIN_DIR" "$STATE_DIR"
  mkdir -- "$STATE_DIR/lock" 2>/dev/null ||
    setup_die 'another setup-asdf process is running'
  LOCK_DIR=$STATE_DIR/lock
}

install_asdf() {
  local destination="$BIN_DIR/asdf-$ASDF_VERSION"
  local link="$BIN_DIR/asdf"
  local asset="asdf-v${ASDF_VERSION}-linux-amd64.tar.gz"
  local url="https://github.com/asdf-vm/asdf/releases/download/v${ASDF_VERSION}/$asset"
  local archive
  local executable
  local output
  local stage
  local state="$STATE_DIR/asdf-target"
  local install_state="$STATE_DIR/installations/asdf-$ASDF_VERSION.sha256"
  local state_temporary digest

  if [[ -f $destination ]]; then
    output=$("$destination" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      setup_die "existing asdf binary did not report $ASDF_VERSION"
  else
    stage=$(mktemp -d "$BIN_DIR/.setup-asdf.XXXXXX")
    TEMP_PATHS+=("$stage")
    archive="$stage/$asset"
    executable="$stage/asdf"
    setup_download "$url" "$archive"
    setup_verify_sha256 "$archive" "$ASDF_SHA256"
    tar -xOzf "$archive" -- asdf >"$executable"
    chmod 0755 "$executable"
    output=$("$executable" version 2>&1)
    [[ $output == *"$ASDF_VERSION"* ]] ||
      setup_die "downloaded asdf did not report $ASDF_VERSION"
    mv -- "$executable" "$destination"
    mkdir -p "$STATE_DIR/installations"
    digest=$(sha256sum "$destination" | awk '{print $1}')
    state_temporary=$(mktemp "$STATE_DIR/installations/.asdf-install.XXXXXX")
    TEMP_PATHS+=("$state_temporary")
    printf '%s\n' "$digest" >"$state_temporary"
    chmod 0600 "$state_temporary"
    mv -T -- "$state_temporary" "$install_state"
    printf 'setup-asdf: installed asdf %s\n' "$ASDF_VERSION"
  fi
  temporary_link="$BIN_DIR/.asdf.link.$$"
  state_temporary=$(mktemp "$STATE_DIR/.asdf-state.XXXXXX")
  TEMP_PATHS+=("$state_temporary")
  printf '%s\n' "asdf-$ASDF_VERSION" >"$state_temporary"
  chmod 0600 "$state_temporary"
  ln -s -- "asdf-$ASDF_VERSION" "$temporary_link"
  TEMP_PATHS+=("$temporary_link")
  mv -T -- "$temporary_link" "$link"
  mv -T -- "$state_temporary" "$state"
}

pin_plugin() {
  local name=$1
  local directory="$ASDF_DATA_DIR/plugins/$name"
  local current

  plugin_spec "$name"
  if [[ ! -d $directory ]]; then
    "$BIN_DIR/asdf" plugin add "$name" "$PLUGIN_REPO"
  fi
  current=$(git -C "$directory" rev-parse HEAD)
  if [[ $current != "$PLUGIN_COMMIT" ]]; then
    git -C "$directory" fetch --depth 1 origin "$PLUGIN_COMMIT"
    git -C "$directory" checkout --detach "$PLUGIN_COMMIT"
  fi
  [[ $(git -C "$directory" rev-parse HEAD) == "$PLUGIN_COMMIT" ]] ||
    setup_die "failed to pin $name plugin"
}

reconcile_tool() {
  local name=$1
  local version
  local -a versions=()

  plugin_spec "$name"
  versions=("${TOOL_VERSIONS[@]}")
  pin_plugin "$name"
  for version in "${versions[@]}"; do
    if "$BIN_DIR/asdf" list "$name" "$version" 2>/dev/null |
      awk -v wanted="$version" '{sub(/^[* ]+/, ""); if ($1 == wanted) found=1} END {exit !found}'; then
      printf 'setup-asdf: reuse %s %s\n' "$name" "$version"
    else
      "$BIN_DIR/asdf" install "$name" "$version"
      printf 'setup-asdf: installed %s %s\n' "$name" "$version"
    fi
    "$BIN_DIR/asdf" reshim "$name" "$version"
  done
}

select_tool() {
  local name=$1
  local first

  plugin_spec "$name"
  first=${TOOL_VERSIONS[0]}
  "$BIN_DIR/asdf" set -u "$name" "$first"
  printf 'setup-asdf: selected %s %s for home\n' "$name" "$first"
}

reconcile_tools() {
  local name
  for name in "$@"; do reconcile_tool "$name"; done
  for name in "$@"; do select_tool "$name"; done
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then find "$path" -depth -delete; fi
  done
  if [[ -n ${LOCK_DIR:-} && -d $LOCK_DIR && ! -L $LOCK_DIR ]]; then
    rmdir -- "$LOCK_DIR"
  fi
  exit "$status"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
SETUP_PROGRAM=setup-asdf
declare -a NORMALIZED_TOOLS=()
declare -a TEMP_PATHS=()
BIN_DIR=
STATE_DIR=
LOCK_DIR=
PLUGIN_REPO=
PLUGIN_COMMIT=
declare -a TOOL_VERSIONS=()
temporary_link=
trap cleanup EXIT
main "$@"
