# tools bundled by build-dotfiles-release for disconnected hosts.
declare -ga OFFLINE_RELEASE_TOOLS=(
  nvim
  nodejs
  python
  rg
  tmux
  oh-my-posh
  k9s
  zoxide
  kubectx
  kubens
  task
  fzf
  terraform
  kubectl
  helm
  fd
  go
  kind
  uv
  actionlint
  shellcheck
  yamllint
  gh
  htop
  kubeconform
  kyverno
  trivy
)

# tools installed by setup-tools for machines with open internet access; Python runtime installation delegates to uv.
declare -ga TOOLS=(
  actionlint
  gh
  htop
  kyverno
  task
  trivy
  k9s
  kubeconform
  shellcheck
  oh-my-posh
  kubectx
  kubens
  rg
  zoxide
  uv
  python
  nvim
  kubectl
  helm
  fd
  go
  kind
  tmux
)

KUBECTX_VERSION=0.11.0
PYTHON_STANDALONE_BUILD=20260127
PIP_TOOLS_VERSION=7.6.1

