#!/usr/bin/env bash
# bstow - GNU Stow clone in pure Bash
# Usage: bstow [stow|unstow|restow] package1 package2 ...

set -euo pipefail

# Configuration
STOW_DIR="${STOW_DIR:-$PWD}"
TARGET_DIR="${TARGET_DIR:-$HOME}"
VERBOSE="${VERBOSE:-0}"
DRY_RUN="${DRY_RUN:-0}"
FORCE="${FORCE:-0}"
STATE_DIR="${BSTOW_STATE_DIR:-}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log() {
    if [[ $VERBOSE -eq 1 ]]; then
        printf '%b[INFO]%b %s\n' "$BLUE" "$NC" "$*" >&2
    fi
}

success() {
    printf '%b[OK]%b %s\n' "$GREEN" "$NC" "$*" >&2
}

warn() {
    printf '%b[!]%b %s\n' "$YELLOW" "$NC" "$*" >&2
}

error() {
    printf '%b[ERROR]%b %s\n' "$RED" "$NC" "$*" >&2
}

preview() {
    printf '[DRY-RUN] %s\n' "$*" >&2
}

resolve_link_target() {
    local dest="$1"
    local target
    target="$(readlink -- "$dest")"

    if [[ $target == /* ]]; then
        realpath -m -- "$target"
    else
        realpath -m -- "$(dirname -- "$dest")/$target"
    fi
}

link_points_to() {
    local dest="$1"
    local expected_src="$2"
    local current_resolved
    local expected_resolved

    [[ -L $dest ]] || return 1
    current_resolved="$(resolve_link_target "$dest")"
    expected_resolved="$(realpath -m -- "$expected_src")"
    [[ $current_resolved == "$expected_resolved" ]]
}

common_directory() {
    local left="$1"
    local right="$2"

    if [[ $left == . || $right == . ]]; then
        printf '.\n'
        return
    fi

    while [[ $right != "$left" && $right != "$left/"* ]]; do
        if [[ $left == */* ]]; then
            left="${left%/*}"
        else
            left=.
        fi
    done
    printf '%s\n' "$left"
}

package_scan_roots() {
    local package_dir="$1"
    local file
    local rel_path
    local parent
    local group
    local current
    declare -A common_by_group=()

    while IFS= read -r -d '' file; do
        rel_path="${file#"$package_dir"/}"
        if [[ $rel_path == */* ]]; then
            parent="${rel_path%/*}"
            group="${parent%%/*}"
        else
            parent=.
            group=.
        fi

        current="${common_by_group[$group]:-}"
        if [[ -z $current ]]; then
            common_by_group[$group]="$parent"
        else
            common_by_group[$group]="$(common_directory "$current" "$parent")"
        fi
    done < <(find "$package_dir" -type f -print0)

    for current in "${common_by_group[@]}"; do
        if [[ $current == . ]]; then
            printf '%s\0%s\0' "$TARGET_DIR" 1
        else
            printf '%s\0%s\0' "$TARGET_DIR/$current" 0
        fi
    done
}

managed_link_source() {
    local link="$1"
    local package_dir="$2"
    local source
    local rel_path

    source="$(resolve_link_target "$link")"
    if [[ $source != "$package_dir/"* ]]; then
        return 1
    fi

    rel_path="${source#"$package_dir"/}"
    if [[ $link != "$TARGET_DIR/$rel_path" ]]; then
        return 1
    fi

    printf '%s\n' "$source"
}

find_managed_links() {
    local package_dir="$1"
    local root
    local shallow
    local link

    while IFS= read -r -d '' root && IFS= read -r -d '' shallow; do
        [[ -d $root ]] || continue
        if [[ $shallow -eq 1 ]]; then
            while IFS= read -r -d '' link; do
                if managed_link_source "$link" "$package_dir" >/dev/null; then
                    printf '%s\0' "$link"
                fi
            done < <(find "$root" -xdev -maxdepth 1 -type l -print0)
        else
            while IFS= read -r -d '' link; do
                if managed_link_source "$link" "$package_dir" >/dev/null; then
                    printf '%s\0' "$link"
                fi
            done < <(find "$root" -xdev -type l -print0)
        fi
    done < <(package_scan_roots "$package_dir")
}

package_state_file() {
    local package="$1"
    local name="${package##*/}"
    local checksum
    name="${name//[^a-zA-Z0-9_.-]/_}"
    checksum="$(printf '%s' "$package" | cksum)"
    checksum="${checksum%% *}"
    printf '%s/%s-%s.links\n' "$STATE_DIR" "${name:-package}" "$checksum"
}

valid_relative_path() {
    local path="$1"
    [[ -n $path && $path != /* && $path != .. && $path != ../* && $path != */../* && $path != */.. ]]
}

PACKAGE_STATE_SOURCE=''
PACKAGE_STATE_PATHS=()

load_package_state() {
    local package="$1"
    local state_file
    local path
    state_file="$(package_state_file "$package")"
    PACKAGE_STATE_SOURCE=''
    PACKAGE_STATE_PATHS=()

    if [[ ! -e $state_file && ! -L $state_file ]]; then
        return 1
    fi
    if [[ ! -f $state_file || -L $state_file ]]; then
        error "Invalid bstow state file: $state_file"
        return 2
    fi

    exec 3<"$state_file"
    if ! IFS= read -r -d '' PACKAGE_STATE_SOURCE <&3 || [[ $PACKAGE_STATE_SOURCE != /* ]]; then
        exec 3<&-
        error "Corrupt bstow state file: $state_file"
        return 2
    fi
    while IFS= read -r -d '' path <&3; do
        if ! valid_relative_path "$path"; then
            exec 3<&-
            error "Unsafe path in bstow state file: $state_file"
            return 2
        fi
        PACKAGE_STATE_PATHS+=("$path")
    done
    exec 3<&-
}

validate_package_state() {
    local package="$1"
    local package_dir="$2"
    local status

    if load_package_state "$package"; then
        if [[ $PACKAGE_STATE_SOURCE != "$package_dir" && $FORCE -ne 1 ]]; then
            error "Package state belongs to another source: $PACKAGE_STATE_SOURCE"
            error "Use --force only if $package_dir should take ownership"
            return 1
        fi
        return 0
    else
        status=$?
    fi
    [[ $status -eq 1 ]]
}

write_package_state() {
    local package="$1"
    local package_dir="$2"
    local state_file
    local temporary
    local file
    local rel_path
    declare -A paths=()

    state_file="$(package_state_file "$package")"
    if load_package_state "$package" && [[ $PACKAGE_STATE_SOURCE == "$package_dir" ]]; then
        for rel_path in "${PACKAGE_STATE_PATHS[@]}"; do
            paths[$rel_path]=1
        done
    fi
    while IFS= read -r -d '' file; do
        rel_path="${file#"$package_dir"/}"
        paths[$rel_path]=1
    done < <(find "$package_dir" -type f -print0)

    mkdir -p "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/.bstow-state.XXXXXX")"
    chmod 0600 "$temporary"
    {
        printf '%s\0' "$package_dir"
        for rel_path in "${!paths[@]}"; do
            printf '%s\0' "$rel_path"
        done
    } >"$temporary"
    mv -f -- "$temporary" "$state_file"
}

remove_package_state() {
    local package="$1"
    local state_file
    state_file="$(package_state_file "$package")"
    [[ -f $state_file && ! -L $state_file ]] || return 0
    rm -- "$state_file"
    rmdir "$STATE_DIR" 2>/dev/null || true
}

validate_destination() {
    local src="$1"
    local dest="$2"

    if [[ ! -e $dest && ! -L $dest ]]; then
        return 0
    fi

    if [[ -L $dest ]]; then
        if link_points_to "$dest" "$src" || [[ $FORCE -eq 1 ]]; then
            return 0
        fi

        error "Symlink exists and points elsewhere: $dest -> $(readlink -- "$dest")"
        error "Use --force only if bstow should replace that symlink"
        return 1
    fi

    error "File exists and is not a symlink: $dest"
    error "Please remove or back it up manually"
    return 1
}

validate_package() {
    local package_dir="$1"
    local file
    local rel_path
    local src
    local dest

    while IFS= read -r -d '' file; do
        rel_path="${file#"$package_dir"/}"
        src="$package_dir/$rel_path"
        dest="$TARGET_DIR/$rel_path"
        validate_destination "$src" "$dest" || return 1
    done < <(find "$package_dir" -type f -print0)
}

create_link() {
    local src="$1"
    local dest="$2"
    local parent_dir

    log "Creating link: $dest -> $src"
    validate_destination "$src" "$dest" || return 1

    if [[ -L $dest ]]; then
        if link_points_to "$dest" "$src"; then
            if [[ $DRY_RUN -eq 1 ]]; then
                preview "No change: $dest already points to $src"
            else
                log "Link already exists and is correct: $dest"
            fi
            return 0
        fi

        if [[ $DRY_RUN -eq 1 ]]; then
            preview "Would replace symlink: $dest -> $(readlink -- "$dest") with $src"
            return 0
        fi

        warn "Replacing symlink: $dest -> $(readlink -- "$dest")"
        unlink "$dest"
    fi

    parent_dir="$(dirname -- "$dest")"
    if [[ ! -d $parent_dir ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
            preview "Would create directory: $parent_dir"
        else
            log "Creating directory: $parent_dir"
            mkdir -p "$parent_dir"
        fi
    fi

    if [[ $DRY_RUN -eq 1 ]]; then
        preview "Would link: $dest -> $src"
        return 0
    fi

    ln -s "$src" "$dest"
    success "Linked: $dest -> $src"
}

# Remove symlink
remove_link() {
    local dest="$1"
    local expected_src="$2"
    
    if [[ ! -L $dest ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then
            preview "No managed link: $dest"
        else
            log "Not a symlink, skipping: $dest"
        fi
        return 0
    fi

    if ! link_points_to "$dest" "$expected_src"; then
        warn "Link points elsewhere, skipping: $dest -> $(readlink -- "$dest") (expected: $expected_src)"
        return 0
    fi

    log "Removing link: $dest"

    if [[ $DRY_RUN -eq 1 ]]; then
        preview "Would remove: $dest"
        return 0
    fi

    unlink "$dest"
    success "Removed: $dest"

    # Remove empty parent directories
    local parent_dir
    parent_dir="$(dirname -- "$dest")"
    while [[ $parent_dir != "$TARGET_DIR" && $parent_dir != / ]]; do
        if rmdir "$parent_dir" 2>/dev/null; then
            log "Removed empty directory: $parent_dir"
            parent_dir="$(dirname -- "$parent_dir")"
        else
            break
        fi
    done
}

# Stow a package
stow_package() {
    local package="$1"
    local package_dir="$STOW_DIR/$package"
    
    if [[ ! -d "$package_dir" ]]; then
        error "Package not found: $package_dir"
        return 1
    fi
    
    printf 'Stowing package: %s\n' "$package"
    validate_package_state "$package" "$package_dir" || return 1
    validate_package "$package_dir" || return 1

    while IFS= read -r -d '' file; do
        local rel_path="${file#"$package_dir"/}"
        local src="$package_dir/$rel_path"
        local dest="$TARGET_DIR/$rel_path"

        create_link "$src" "$dest" || return 1
    done < <(find "$package_dir" -type f -print0)

    if [[ $DRY_RUN -ne 1 ]]; then
        write_package_state "$package" "$package_dir" || return 1
    fi
}

# Unstow a package
unstow_package() {
    local package="$1"
    local package_dir="$STOW_DIR/$package"
    
    if [[ ! -d "$package_dir" ]]; then
        error "Package not found: $package_dir"
        return 1
    fi
    
    printf 'Unstowing package: %s\n' "$package"
    validate_package_state "$package" "$package_dir" || return 1

    local managed_links=()
    local dest
    local src
    local rel_path
    local has_state=0
    if load_package_state "$package"; then
        has_state=1
        src="$PACKAGE_STATE_SOURCE"
        for rel_path in "${PACKAGE_STATE_PATHS[@]}"; do
            dest="$TARGET_DIR/$rel_path"
            remove_link "$dest" "$src/$rel_path"
        done
    else
        while IFS= read -r -d '' dest; do
            managed_links+=("$dest")
        done < <(find_managed_links "$package_dir")

        for dest in "${managed_links[@]}"; do
            src="$(resolve_link_target "$dest")"
            remove_link "$dest" "$src"
        done
    fi

    while IFS= read -r -d '' file; do
        rel_path="${file#"$package_dir"/}"
        src="$package_dir/$rel_path"
        dest="$TARGET_DIR/$rel_path"

        if [[ -L $dest ]]; then
            remove_link "$dest" "$src"
        fi
    done < <(find "$package_dir" -type f -print0)

    if [[ $has_state -eq 1 && $DRY_RUN -ne 1 ]]; then
        remove_package_state "$package"
    fi
}

preview_obsolete_links() {
    local package="$1"
    local package_dir="$2"
    local dest
    local src
    local rel_path
    local status

    if load_package_state "$package"; then
        src="$PACKAGE_STATE_SOURCE"
        for rel_path in "${PACKAGE_STATE_PATHS[@]}"; do
            if [[ ! -f $package_dir/$rel_path || -L $package_dir/$rel_path ]]; then
                dest="$TARGET_DIR/$rel_path"
                if link_points_to "$dest" "$src/$rel_path"; then
                    preview "Would remove: $dest"
                fi
            fi
        done
        return 0
    else
        status=$?
    fi
    [[ $status -eq 1 ]] || return "$status"

    while IFS= read -r -d '' dest; do
        src="$(resolve_link_target "$dest")"
        if [[ ! -f $src || -L $src ]]; then
            preview "Would remove: $dest"
        fi
    done < <(find_managed_links "$package_dir")
}

preview_restow_link() {
    local src="$1"
    local dest="$2"
    local parent_dir

    if [[ -L $dest ]]; then
        if link_points_to "$dest" "$src"; then
            preview "Would relink: $dest -> $src"
        else
            preview "Would replace symlink: $dest -> $(readlink -- "$dest") with $src"
        fi
        return 0
    fi

    parent_dir="$(dirname -- "$dest")"
    if [[ ! -d $parent_dir ]]; then
        preview "Would create directory: $parent_dir"
    fi
    preview "Would link: $dest -> $src"
}

restow_package() {
    local package="$1"
    local package_dir="$STOW_DIR/$package"

    if [[ ! -d $package_dir ]]; then
        error "Package not found: $package_dir"
        return 1
    fi

    validate_package_state "$package" "$package_dir" || return 1
    validate_package "$package_dir" || return 1

    if [[ $DRY_RUN -eq 1 ]]; then
        printf 'Restowing package: %s\n' "$package"
        preview_obsolete_links "$package" "$package_dir"
        while IFS= read -r -d '' file; do
            local rel_path="${file#"$package_dir"/}"
            preview_restow_link "$package_dir/$rel_path" "$TARGET_DIR/$rel_path"
        done < <(find "$package_dir" -type f -print0)
        return 0
    fi

    unstow_package "$package" || return 1
    stow_package "$package" || return 1
}

# Show help
show_help() {
    cat <<EOF
Usage: bstow [OPTIONS] COMMAND PACKAGES...

A simple GNU Stow clone in pure Bash.

COMMANDS:
    stow        Create symlinks for packages
    unstow      Remove symlinks for packages
    restow      Unstow and then stow packages

OPTIONS:
    -d, --dir DIR       Set stow directory (default: current directory)
    -t, --target DIR    Set target directory (default: \$HOME)
    -n, --dry-run       Preview actions without changing files
    -f, --force         Replace foreign symlinks or adopt state from another source
    -v, --verbose       Show additional diagnostic details
    -h, --help          Show this help

EXAMPLES:
    bstow stow vim nvim        # Stow vim and nvim packages
    bstow unstow bash          # Unstow bash package
    bstow --dry-run stow tmux  # Preview without changing files
    bstow restow git           # Restow git package

ENVIRONMENT:
    STOW_DIR    Stow directory (default: \$PWD)
    TARGET_DIR  Target directory (default: \$HOME)
    VERBOSE     Enable verbose output (0 or 1)
    DRY_RUN     Enable dry run mode (0 or 1)
    FORCE       Replace foreign symlinks or adopt package state (0 or 1)
    BSTOW_STATE_DIR
                Ownership state directory (default: TARGET_DIR/.local/state/bstow)

PACKAGE STRUCTURE:
    dotfiles/
    ├── bash/
    │   └── .bashrc
    ├── vim/
    │   └── .vimrc
    └── nvim/
        └── .config/
            └── nvim/
                └── init.lua

EOF
}

# Main
main() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d|--dir)
                [[ $# -ge 2 ]] || { error "$1 requires a directory"; exit 1; }
                STOW_DIR="$2"
                shift 2
                ;;
            --dir=*)
                STOW_DIR="${1#*=}"
                shift
                ;;
            -t|--target)
                [[ $# -ge 2 ]] || { error "$1 requires a directory"; exit 1; }
                TARGET_DIR="$2"
                shift 2
                ;;
            --target=*)
                TARGET_DIR="${1#*=}"
                shift
                ;;
            -n|--dry-run)
                DRY_RUN=1
                shift
                ;;
            -f|--force)
                FORCE=1
                shift
                ;;
            -v|--verbose)
                VERBOSE=1
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # Check arguments
    if [[ $# -lt 2 ]]; then
        error "Missing command or packages"
        show_help
        exit 1
    fi
    
    local command="$1"
    shift
    
    # Validate directories
    if [[ ! -d "$STOW_DIR" ]]; then
        error "Stow directory not found: $STOW_DIR"
        exit 1
    fi
    
    if [[ ! -d "$TARGET_DIR" ]]; then
        error "Target directory not found: $TARGET_DIR"
        exit 1
    fi
    
    # Convert to absolute paths
    STOW_DIR="$(cd "$STOW_DIR" && pwd)"
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
    if [[ -z $STATE_DIR ]]; then
        STATE_DIR="$TARGET_DIR/.local/state/bstow"
    else
        STATE_DIR="$(realpath -m -- "$STATE_DIR")"
    fi
    
    log "Stow directory: $STOW_DIR"
    log "Target directory: $TARGET_DIR"
    if [[ $DRY_RUN -eq 1 ]]; then
        preview "Preview only; no filesystem changes will be made"
    fi

    # Execute command for each package
    local exit_code=0
    for package in "$@"; do
        case $command in
            stow)
                stow_package "$package" || exit_code=1
                ;;
            unstow)
                unstow_package "$package" || exit_code=1
                ;;
            restow)
                restow_package "$package" || exit_code=1
                ;;
            *)
                error "Unknown command: $command"
                show_help
                exit 1
                ;;
        esac
    done
    
    exit $exit_code
}

# Run if executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
