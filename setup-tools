#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-tools [NAME ...]

Download and install selected Linux x86-64 tools under ~/bin.
For offline deployment, use the complete dotfiles release instead.
EOF
  printf 'Names:'
  printf ' %s' "${TOOLS[@]}"
  printf '\n'
}

main() {
  local -a requested=()

  while (($#)); do
    case $1 in
      -h | --help)
        usage
        return 0
        ;;
      --*) report_error "unknown option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done

  load_setup_config
  if ((${#requested[@]} == 0)); then
    requested=("${TOOLS[@]}")
  fi
  validate_host
  select_requested_tools "${requested[@]}"
  preflight "${SELECTED_TOOLS[@]}"
  install_selected_tools "${SELECTED_TOOLS[@]}"
}

load_setup_config() {
  # shellcheck source=system.env
  source "$REPO_DIR/system.env"
  # shellcheck source=tools-probes.env
  source "$REPO_DIR/tools-probes.env"
  # Task deliberately keeps its only editable pin in validation.env.
  # shellcheck source=validation.env
  source "$REPO_DIR/validation.env"
  validate_tool_config
  validate_validator_config

  BIN_DIR=${SETUP_TOOLS_BIN_DIR:-$HOME/bin}
  STATE_DIR=${SETUP_TOOLS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/setup-tools}
}

validate_host() {
  [[ $(uname -s) == Linux ]] || report_error 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || report_error 'only Linux x86-64 is supported'
  require_setup_commands setup-tools
}

# Validate names and deduplicate requests, preserving their selection order.
select_requested_tools() {
  local name
  local allowed
  local supported
  local seen=' '

  SELECTED_TOOLS=()
  for name in "$@"; do
    supported=0
    for allowed in "${TOOLS[@]}"; do
      if [[ $name == "$allowed" ]]; then supported=1; break; fi
    done
    if ((supported == 0)); then
      report_error "unknown tool: $name"
      return 1
    fi
    if [[ $seen != *" $name "* ]]; then
      SELECTED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

load_tool_versions() {
  local catalog=TOOL_RELEASES

  # Task has one shared pin for setup and repository validation.
  if [[ $1 == task ]]; then catalog=VALIDATOR_RELEASES; fi
  release_versions "$catalog" "$1" || return
  TOOL_VERSIONS=("${RELEASE_VERSIONS[@]}")
}

load_tool_release() {
  local name=$1
  local version=$2
  local catalog=TOOL_RELEASES

  if [[ $name == task ]]; then catalog=VALIDATOR_RELEASES; fi
  select_release "$catalog" "$name" "$version" || return
  if [[ $RELEASE_URL == - ]]; then
    report_error "$name $version has no direct artifact"
    return 1
  fi
  artifact_layout "$name" "$version" "$RELEASE_ASSET"
}

state_path() {
  printf '%s/%s-%s.state\n' "$STATE_DIR" "$1" "$2"
}

# Hash a deterministic tar stream of installed payloads, not the downloaded archive.
# Example for root=$HOME/bin and the two uv destinations:
# tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
#   -C "$HOME/bin" -cf - -- uv-0.12.19 uvx-0.12.19 | sha256sum | awk '{print $1}'
# Timestamps and owner/group IDs are normalized; contents, paths and modes remain.
content_digest() {
  local root=$1
  local destination
  local -a basenames=()
  shift

  for destination in "$@"; do
    basenames+=("$(basename -- "$destination")")
  done
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    -C "$root" -cf - -- "${basenames[@]}" | sha256sum | awk '{print $1}'
}

read_state() {
  local path=$1
  # Artifact hash authenticates the download; payload hash detects local edits.
  RECORDED_INSTALL_PHASE=
  RECORDED_ARTIFACT_SHA256=
  RECORDED_PAYLOAD_SHA256=
  [[ -f $path && ! -L $path && $(wc -l <"$path") == 1 ]] || return 1
  IFS=$'\t' read -r RECORDED_INSTALL_PHASE RECORDED_ARTIFACT_SHA256 \
    RECORDED_PAYLOAD_SHA256 <"$path" || return 1
  [[ $RECORDED_INSTALL_PHASE == pending || $RECORDED_INSTALL_PHASE == complete ]] || return 1
  validate_digest state-artifact "$RECORDED_ARTIFACT_SHA256" || return 1
  validate_digest state-content "$RECORDED_PAYLOAD_SHA256" || return 1
}

destinations_exist() {
  local destination
  for destination in "${SPEC_DESTS[@]}"; do
    [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]] || return 1
  done
}

# A named classification permits recovery without using error exit codes as data.
# The saved phase owns payloads; complete does not mean canonical links are selected.
classify_installation() {
  local name=$1
  local version=$2
  local expected_artifact=$3
  local path
  local actual
  local destination

  path=$(state_path "$name" "$version")
  if [[ ! -e $path && ! -L $path ]]; then
    for destination in "${SPEC_DESTS[@]}"; do
      if [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]]; then
        report_error "unmanaged versioned destination exists: $BIN_DIR/$destination"
        return 1
      fi
    done
    INSTALLATION_STATE=missing
    return 0
  fi
  if ! read_state "$path"; then
    report_error "invalid installation state: $path"
    return 1
  fi
  if [[ $RECORDED_ARTIFACT_SHA256 != "$expected_artifact" ]]; then
    report_error "state digest differs for $name $version"
    return 1
  fi
  if ! destinations_exist; then
    if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
      report_error "managed installation is incomplete: $name $version"
      return 1
    fi
    INSTALLATION_STATE=pending-incomplete
    return 0
  fi
  actual=$(content_digest "$BIN_DIR" "${SPEC_DESTS[@]}") || return
  if [[ $actual != "$RECORDED_PAYLOAD_SHA256" ]]; then
    if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
      report_error "managed installation was modified: $name $version"
      return 1
    fi
    INSTALLATION_STATE=pending-incomplete
    return 0
  fi
  if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
    INSTALLATION_STATE=complete
  else
    INSTALLATION_STATE=pending-intact
  fi
}

state_owns_link_target() {
  local name=$1
  local command_name=$2
  local target=$3
  local version
  local state
  local entry
  local actual

  case "$command_name:$target" in
    nvim:nvim-*/bin/nvim)
      version=${target#nvim-}
      version=${version%/bin/nvim}
      ;;
    "$command_name:$command_name-"*)
      version=${target#"$command_name-"}
      ;;
    *) return 1 ;;
  esac
  [[ -n $version && $version != */* ]] || return 1
  state=$(state_path "$name" "$version")
  read_state "$state" || return 1
  [[ $RECORDED_INSTALL_PHASE == complete ]] || return 1
  artifact_layout "$name" "$version" retained
  for entry in "${SPEC_LINKS[@]}"; do
    [[ $entry == "$command_name:$target" ]] || continue
    destinations_exist || return 1
    actual=$(content_digest "$BIN_DIR" "${SPEC_DESTS[@]}") || return 1
    [[ $actual == "$RECORDED_PAYLOAD_SHA256" ]]
    return
  done
  return 1
}

# Never overwrite another provider or a file this installer cannot authenticate.
preflight_link() {
  local name=$1
  local entry=$2
  local command_name=${entry%%:*}
  local link="$BIN_DIR/$command_name"
  local provider
  local target

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    if ! state_owns_link_target "$name" "$command_name" "$target"; then
      report_error "refusing foreign link: $link -> $target"
      return 1
    fi
    return 0
  fi
  if [[ -e $link ]]; then
    report_error "refusing unmanaged path: $link"
    return 1
  fi
  if ! provider=$(command -v "$command_name" 2>/dev/null); then return 0; fi
  case $provider in
    "$HOME/.asdf/shims/"* | "$HOME/.krew/bin/"* | "$HOME/.local/share/nvim2/mason/bin/"*)
      report_error "$command_name is already provided by $provider"
      return 1
      ;;
  esac
}

preflight() {
  local name
  local version
  local entry

  if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
    [[ -d $BIN_DIR && ! -L $BIN_DIR ]] || report_error "invalid bin directory: $BIN_DIR"
  fi
  if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
    [[ -d $STATE_DIR && ! -L $STATE_DIR ]] || report_error "invalid state directory: $STATE_DIR"
  fi
  if [[ -L $STATE_DIR/locks || ( -e $STATE_DIR/locks && ! -d $STATE_DIR/locks ) ]]; then
    report_error "invalid lock directory: $STATE_DIR/locks"
    return 1
  fi
  mkdir -p "$BIN_DIR" "$STATE_DIR/locks"
  # Acquire in a stable order before checking ownership to avoid check/use races.
  local -a lock_names=()
  mapfile -t lock_names < <(printf '%s\n' "$@" | LC_ALL=C sort)
  for name in "${lock_names[@]}"; do acquire_lock "$name"; done
  for name in "$@"; do
    load_tool_versions "$name"
    for version in "${TOOL_VERSIONS[@]}"; do
      load_tool_release "$name" "$version"
      classify_installation "$name" "$version" "$RELEASE_SHA256"
    done
    load_tool_release "$name" "${TOOL_VERSIONS[0]}"
    for entry in "${SPEC_LINKS[@]}"; do preflight_link "$name" "$entry"; done
  done
}

acquire_lock() {
  local name=$1
  local lock="$STATE_DIR/locks/$name.lock"

  acquire_setup_lock "$lock" "another setup-tools process owns $name"
}

write_state() {
  local name=$1
  local version=$2
  local status=$3
  local content=$4
  local artifact_digest=$5
  local path
  local temporary

  path=$(state_path "$name" "$version")
  temporary=$(mktemp "$STATE_DIR/.state.XXXXXX")
  TEMP_PATHS+=("$temporary")
  printf '%s\t%s\t%s\n' "$status" "$artifact_digest" "$content" >"$temporary"
  mv -- "$temporary" "$path"
}

# A crash between moving uv and uvx leaves a partial payload. Only remove it
# when no canonical link uses it; intact pending payloads are completed in place.
remove_incomplete_payload() {
  local destination
  local entry
  local command_name
  local link_target

  for destination in "${SPEC_DESTS[@]}"; do
    for entry in "${SPEC_LINKS[@]}"; do
      command_name=${entry%%:*}
      if [[ -L $BIN_DIR/$command_name ]]; then
        link_target=$(readlink -- "$BIN_DIR/$command_name")
        if [[ $link_target == "$destination" || $link_target == "$destination/"* ]]; then
          report_error "pending installation is active: $destination"
          return 1
        fi
      fi
    done
  done
  for destination in "${SPEC_DESTS[@]}"; do
    if [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]]; then
      find "$BIN_DIR/$destination" -depth -delete
    fi
  done
}

verify_executable() {
  local name=$1
  local executable=$2
  local version=${3#v}
  local output
  local -a arguments=()

  read -r -a arguments <<<"${TOOL_PROBE_ARGS[$name]:---version}"
  output=$("$executable" "${arguments[@]}" 2>&1)
  [[ $output == *"$version"* ]] ||
    report_error "$name executable did not report version $version: ${output%%$'\n'*}"
}

verify_staged() {
  local name=$1
  local version=$2
  local executable

  case $name in
    nvim) executable="$STAGE_DIR/${SPEC_DESTS[0]}/bin/nvim" ;;
    *) executable="$STAGE_DIR/${SPEC_DESTS[0]}" ;;
  esac
  verify_executable "$name" "$executable" "$version"
  if [[ $name == uv ]]; then
    verify_executable uvx "$STAGE_DIR/${SPEC_DESTS[1]}" "$version"
  fi
}

# Install or recover one version, without changing the selected command links.
install_version() {
  local name=$1
  local version=$2
  local input
  local content
  local destination

  load_tool_release "$name" "$version"
  classify_installation "$name" "$version" "$RELEASE_SHA256"
  case $INSTALLATION_STATE in
    complete)
      printf 'setup-tools: reuse %s %s\n' "$name" "$version"
      return
      ;;
    pending-intact)
      write_state "$name" "$version" complete "$RECORDED_PAYLOAD_SHA256" "$RELEASE_SHA256"
      printf 'setup-tools: recovered %s %s\n' "$name" "$version"
      return
      ;;
    pending-incomplete) remove_incomplete_payload ;;
    missing) ;;
  esac

  STAGE_DIR=$(mktemp -d "$BIN_DIR/.setup-tools.XXXXXX")
  TEMP_PATHS+=("$STAGE_DIR")
  input="$STAGE_DIR/$SPEC_ASSET"
  download_file "$RELEASE_URL" "$input"
  verify_sha256 "$input" "$RELEASE_SHA256"
  extract_artifact "$input" "$STAGE_DIR"
  verify_staged "$name" "$version"

  content=$(content_digest "$STAGE_DIR" "${SPEC_DESTS[@]}")
  write_state "$name" "$version" pending "$content" "$RELEASE_SHA256"
  for destination in "${SPEC_DESTS[@]}"; do
    mv -- "$STAGE_DIR/$destination" "$BIN_DIR/$destination"
  done
  write_state "$name" "$version" complete "$content" "$RELEASE_SHA256"
  printf 'setup-tools: installed %s %s\n' "$name" "$version"
}

activate_links() {
  local name=$1
  shift
  local entry
  local command_name
  local target
  local temporary
  local status
  local index
  local -a commands=()
  local -a previous_targets=()
  local -a had_previous=()

  for entry in "$@"; do
    command_name=${entry%%:*}
    target=${entry#*:}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    [[ ! -e $temporary && ! -L $temporary ]] || report_error "temporary link exists: $temporary"
    ln -s -- "$target" "$temporary"
    TEMP_PATHS+=("$temporary")
    commands+=("$command_name")
    if [[ -L $BIN_DIR/$command_name ]]; then
      had_previous+=(true)
      previous_targets+=("$(readlink -- "$BIN_DIR/$command_name")")
    else
      had_previous+=(false)
      previous_targets+=('')
    fi
  done
  for index in "${!commands[@]}"; do
    command_name=${commands[$index]}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    if mv -T -- "$temporary" "$BIN_DIR/$command_name"; then
      continue
    else
      status=$?
      for ((; index >= 0; index--)); do
        command_name=${commands[$index]}
        if [[ ${had_previous[$index]} == true ]]; then
          temporary="$BIN_DIR/.${command_name}.restore.$$"
          ln -s -- "${previous_targets[$index]}" "$temporary" || continue
          TEMP_PATHS+=("$temporary")
          mv -T -- "$temporary" "$BIN_DIR/$command_name" || true
        elif [[ -L $BIN_DIR/$command_name ]]; then
          unlink -- "$BIN_DIR/$command_name" || true
        fi
      done
      report_error "failed to select $name; restored the previous selection" || true
      return "$status"
    fi
  done
  printf 'setup-tools: selected %s\n' "$name"
}

# Reconcile every configured version, then select the first only after success.
install_selected_tools() {
  local name
  local version
  local selected

  for name in "$@"; do
    load_tool_versions "$name"
    selected=${TOOL_VERSIONS[0]}
    for version in "${TOOL_VERSIONS[@]}"; do
      install_version "$name" "$version"
    done
    load_tool_release "$name" "$selected"
    activate_links "$name" "${SPEC_LINKS[@]}"
  done
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then find "$path" -depth -delete; fi
  done
  release_setup_locks
  exit "$status"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
# Profiles are data needed by --help and by the default selection. Sourcing
# this file does not download, install or validate anything.
# shellcheck source=tools.env
source "$REPO_DIR/tools.env"
# Cleanup must also work when --help returns before any installation starts.
declare -a TEMP_PATHS=()
declare -a HELD_LOCK_FDS=()
trap cleanup EXIT
main "$@"
