#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  setup-tools [NAME ...]
  setup-tools --from DIR NAME ...

Install selected Linux x86-64 release files under ~/bin. With --from, read
only DIR/NAME/VERSION/UPSTREAM_ASSET and require at least one NAME.
EOF
  printf 'Names:'
  printf ' %s' "${DAILY_TOOLS[@]}" "${OPTIONAL_TOOLS[@]}"
  printf '\n'
}

main() {
  local from_dir=
  local from_requested=0
  local -a requested=()

  while (($#)); do
    case $1 in
      --from)
        (($# >= 2)) || setup_die '--from requires a directory'
        ((from_requested == 0)) || setup_die '--from may be supplied only once'
        [[ -n $2 ]] || setup_die '--from requires a nonempty directory'
        from_requested=1
        from_dir=$2
        shift 2
        ;;
      -h | --help)
        usage
        return 0
        ;;
      --*) setup_die "unknown option: $1" ;;
      *) requested+=("$1"); shift ;;
    esac
  done

  if ((from_requested == 1 && ${#requested[@]} == 0)); then
    setup_die '--from requires at least one tool name'
  fi
  load_setup_config
  if ((${#requested[@]} == 0)); then
    requested=("${DAILY_TOOLS[@]}")
  fi
  validate_host
  normalize_requested "${requested[@]}"
  preflight "$from_dir" "${NORMALIZED_TOOLS[@]}"
  install_requested "$from_dir" "${NORMALIZED_TOOLS[@]}"
}

load_setup_config() {
  # Task deliberately keeps its only editable pin in validation.env.
  # shellcheck source=validation.env
  source "$REPO_DIR/validation.env"
  setup_validate_tool_config
  setup_validate_validator_config

  BIN_DIR=${SETUP_TOOLS_BIN_DIR:-$HOME/bin}
  STATE_DIR=${SETUP_TOOLS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/setup-tools}
}

validate_host() {
  [[ $(uname -s) == Linux ]] || setup_die 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || setup_die 'only Linux x86-64 is supported'
  setup_need sha256sum
  setup_need tar
  setup_need mktemp
  setup_need find
  setup_need mv
  setup_need ln
  setup_need readlink
}

normalize_requested() {
  local name
  local allowed
  local supported
  local seen=' '

  NORMALIZED_TOOLS=()
  for name in "$@"; do
    supported=0
    for allowed in "${DAILY_TOOLS[@]}" "${OPTIONAL_TOOLS[@]}"; do
      if [[ $name == "$allowed" ]]; then supported=1; break; fi
    done
    ((supported == 1)) || setup_die "unknown tool: $name"
    if [[ $seen != *" $name "* ]]; then
      NORMALIZED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

load_tool_versions() {
  local catalog=TOOL_RELEASES

  [[ $1 != task ]] || catalog=VALIDATION_RELEASES
  setup_release_versions "$catalog" "$1" || return
  TOOL_VERSIONS=("${RELEASE_VERSIONS[@]}")
}

load_tool_release() {
  local name=$1
  local version=$2
  local catalog=TOOL_RELEASES

  [[ $name != task ]] || catalog=VALIDATION_RELEASES
  setup_select_release "$catalog" "$name" "$version" || return
  [[ $RELEASE_URL != - ]] ||
    setup_die "$name $version has no direct artifact" || return
  setup_artifact_layout "$name" "$version" "$RELEASE_ASSET"
}

state_path() {
  printf '%s/%s-%s.state\n' "$STATE_DIR" "$1" "$2"
}

content_digest() {
  local root=$1
  local destination
  local -a basenames=()
  shift

  for destination in "$@"; do
    basenames+=("$(basename -- "$destination")")
  done
  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    -C "$root" -cf - -- "${basenames[@]}" | sha256sum | awk '{print $1}'
}

read_state() {
  local path=$1
  STATE_STATUS=
  STATE_ARTIFACT=
  STATE_CONTENT=
  [[ -f $path && ! -L $path ]] || return 1
  IFS=$'\t' read -r STATE_STATUS STATE_ARTIFACT STATE_CONTENT <"$path" || return 1
  [[ $STATE_STATUS == pending || $STATE_STATUS == complete ]] || return 1
  setup_validate_digest state-artifact "$STATE_ARTIFACT" || return 1
  setup_validate_digest state-content "$STATE_CONTENT" || return 1
}

destinations_exist() {
  local destination
  for destination in "${SPEC_DESTS[@]}"; do
    [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]] || return 1
  done
}

installation_status() {
  local name=$1
  local version=$2
  local expected_artifact=$3
  local path
  local actual
  local destination

  path=$(state_path "$name" "$version")
  if ! read_state "$path"; then
    for destination in "${SPEC_DESTS[@]}"; do
      if [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]]; then
        setup_die "unmanaged versioned destination exists: $BIN_DIR/$destination"
        return 1
      fi
    done
    return 10
  fi
  [[ $STATE_ARTIFACT == "$expected_artifact" ]] ||
    setup_die "state digest differs for $name $version" || return
  if ! destinations_exist; then
    [[ $STATE_STATUS == pending ]] ||
      setup_die "managed installation is incomplete: $name $version" || return
    return 12
  fi
  actual=$(content_digest "$BIN_DIR" "${SPEC_DESTS[@]}")
  if [[ $actual != "$STATE_CONTENT" ]]; then
    [[ $STATE_STATUS == pending ]] ||
      setup_die "managed installation was modified: $name $version" || return
    return 12
  fi
  [[ $STATE_STATUS == complete ]] && return 0
  return 11
}

state_owns_link_target() {
  local name=$1
  local command_name=$2
  local target=$3
  local version
  local state
  local entry
  local actual

  case "$command_name:$target" in
    nvim:nvim-*/bin/nvim)
      version=${target#nvim-}
      version=${version%/bin/nvim}
      ;;
    "$command_name:$command_name-"*)
      version=${target#"$command_name-"}
      ;;
    *) return 1 ;;
  esac
  [[ -n $version && $version != */* ]] || return 1
  state=$(state_path "$name" "$version")
  read_state "$state" || return 1
  [[ $STATE_STATUS == complete ]] || return 1
  setup_artifact_layout "$name" "$version" retained
  for entry in "${SPEC_LINKS[@]}"; do
    [[ $entry == "$command_name:$target" ]] || continue
    destinations_exist || return 1
    actual=$(content_digest "$BIN_DIR" "${SPEC_DESTS[@]}") || return 1
    [[ $actual == "$STATE_CONTENT" ]]
    return
  done
  return 1
}

managed_link_target() {
  local name=$1
  local command_name=$2
  local target=$3

  state_owns_link_target "$name" "$command_name" "$target"
}

preflight_link() {
  local name=$1
  local entry=$2
  local command_name=${entry%%:*}
  local link="$BIN_DIR/$command_name"
  local provider
  local target

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    managed_link_target "$name" "$command_name" "$target" ||
      setup_die "refusing foreign link: $link -> $target"
  elif [[ -e $link ]]; then
    setup_die "refusing unmanaged path: $link"
  elif provider=$(command -v "$command_name" 2>/dev/null) &&
    [[ $provider == "$HOME/.asdf/shims/"* || $provider == "$HOME/.krew/bin/"* ||
      $provider == "$HOME/.local/share/nvim2/mason/bin/"* ]]; then
    setup_die "$command_name is already provided by $provider"
  fi
}

preflight() {
  local from_dir=$1
  local name
  local version
  local status
  local entry
  local input

  if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
    [[ -d $BIN_DIR && ! -L $BIN_DIR ]] || setup_die "invalid bin directory: $BIN_DIR"
  fi
  if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
    [[ -d $STATE_DIR && ! -L $STATE_DIR ]] || setup_die "invalid state directory: $STATE_DIR"
  fi
  [[ -n $from_dir ]] || setup_need curl

  for name in "${@:2}"; do
    load_tool_versions "$name"
    for version in "${TOOL_VERSIONS[@]}"; do
      load_tool_release "$name" "$version"
      if installation_status "$name" "$version" "$RELEASE_SHA256"; then
        status=0
      else
        status=$?
      fi
      case $status in
        0 | 11) ;;
        10 | 12)
          if [[ -n $from_dir ]]; then
            input="$from_dir/$name/$version/$SPEC_ASSET"
            [[ -f $input && ! -L $input && -r $input ]] ||
              setup_die "missing input: $input"
          fi
          ;;
        *) return "$status" ;;
      esac
    done
    load_tool_release "$name" "${TOOL_VERSIONS[0]}"
    for entry in "${SPEC_LINKS[@]}"; do preflight_link "$name" "$entry"; done
  done
  mkdir -p "$BIN_DIR" "$STATE_DIR/locks"
}

acquire_lock() {
  local name=$1
  local lock="$STATE_DIR/locks/$name.lock"

  mkdir -- "$lock" 2>/dev/null || setup_die "another setup-tools process owns $name"
  HELD_LOCKS+=("$lock")
}

write_state() {
  local name=$1
  local version=$2
  local status=$3
  local content=$4
  local artifact_digest=$5
  local path
  local temporary

  path=$(state_path "$name" "$version")
  temporary=$(mktemp "$STATE_DIR/.state.XXXXXX")
  TEMP_PATHS+=("$temporary")
  printf '%s\t%s\t%s\n' "$status" "$artifact_digest" "$content" >"$temporary"
  mv -- "$temporary" "$path"
}

remove_pending_installation() {
  local destination
  local entry
  local command_name
  local link_target

  for destination in "${SPEC_DESTS[@]}"; do
    for entry in "${SPEC_LINKS[@]}"; do
      command_name=${entry%%:*}
      if [[ -L $BIN_DIR/$command_name ]]; then
        link_target=$(readlink -- "$BIN_DIR/$command_name")
        [[ $link_target != "$destination" && $link_target != "$destination/"* ]] ||
          setup_die "pending installation is active: $destination" || return
      fi
    done
  done
  for destination in "${SPEC_DESTS[@]}"; do
    if [[ -e $BIN_DIR/$destination || -L $BIN_DIR/$destination ]]; then
      find "$BIN_DIR/$destination" -depth -delete
    fi
  done
}

verify_executable() {
  local name=$1
  local executable=$2
  local version=${3#v}
  local output
  local -a arguments=(--version)

  if [[ -v TOOL_PROBE_ARGS[$name] ]]; then
    mapfile -t arguments <<<"${TOOL_PROBE_ARGS[$name]}"
  fi
  output=$("$executable" "${arguments[@]}" 2>&1)
  [[ $output == *"$version"* ]] ||
    setup_die "$name executable did not report version $version: ${output%%$'\n'*}"
}

verify_staged() {
  local name=$1
  local version=$2
  local executable

  case $name in
    nvim) executable="$STAGE_DIR/${SPEC_DESTS[0]}/bin/nvim" ;;
    *) executable="$STAGE_DIR/${SPEC_DESTS[0]}" ;;
  esac
  verify_executable "$name" "$executable" "$version"
  if [[ $name == uv ]]; then
    verify_executable uvx "$STAGE_DIR/${SPEC_DESTS[1]}" "$version"
  fi
}

install_version() {
  local from_dir=$1
  local name=$2
  local version=$3
  local status
  local input
  local content
  local destination

  load_tool_release "$name" "$version"
  if installation_status "$name" "$version" "$RELEASE_SHA256"; then
    printf 'setup-tools: reuse %s %s\n' "$name" "$version"
    return
  else
    status=$?
  fi
  if [[ $status -eq 11 ]]; then
    content=$(content_digest "$BIN_DIR" "${SPEC_DESTS[@]}")
    write_state "$name" "$version" complete "$content" "$RELEASE_SHA256"
    printf 'setup-tools: recovered %s %s\n' "$name" "$version"
    return
  fi
  if [[ $status -eq 12 ]]; then
    remove_pending_installation
  elif [[ $status -ne 10 ]]; then
    return "$status"
  fi

  STAGE_DIR=$(mktemp -d "$BIN_DIR/.setup-tools.XXXXXX")
  TEMP_PATHS+=("$STAGE_DIR")
  if [[ -n $from_dir ]]; then
    input="$from_dir/$name/$version/$SPEC_ASSET"
  else
    input="$STAGE_DIR/$SPEC_ASSET"
    setup_download "$RELEASE_URL" "$input"
  fi
  setup_verify_sha256 "$input" "$RELEASE_SHA256"
  setup_extract_artifact "$input" "$STAGE_DIR"
  verify_staged "$name" "$version"

  content=$(content_digest "$STAGE_DIR" "${SPEC_DESTS[@]}")
  write_state "$name" "$version" pending "$content" "$RELEASE_SHA256"
  for destination in "${SPEC_DESTS[@]}"; do
    mv -- "$STAGE_DIR/$destination" "$BIN_DIR/$destination"
  done
  write_state "$name" "$version" complete "$content" "$RELEASE_SHA256"
  printf 'setup-tools: installed %s %s\n' "$name" "$version"
}

activate_links() {
  local name=$1
  shift
  local entry
  local command_name
  local target
  local temporary
  local status
  local index
  local -a commands=()
  local -a previous_targets=()
  local -a had_previous=()

  for entry in "$@"; do
    command_name=${entry%%:*}
    target=${entry#*:}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    [[ ! -e $temporary && ! -L $temporary ]] || setup_die "temporary link exists: $temporary"
    ln -s -- "$target" "$temporary"
    TEMP_PATHS+=("$temporary")
    commands+=("$command_name")
    if [[ -L $BIN_DIR/$command_name ]]; then
      had_previous+=(true)
      previous_targets+=("$(readlink -- "$BIN_DIR/$command_name")")
    else
      had_previous+=(false)
      previous_targets+=('')
    fi
  done
  for index in "${!commands[@]}"; do
    command_name=${commands[$index]}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    if mv -T -- "$temporary" "$BIN_DIR/$command_name"; then
      continue
    else
      status=$?
      for ((; index >= 0; index--)); do
        command_name=${commands[$index]}
        if [[ ${had_previous[$index]} == true ]]; then
          temporary="$BIN_DIR/.${command_name}.restore.$$"
          ln -s -- "${previous_targets[$index]}" "$temporary" || continue
          TEMP_PATHS+=("$temporary")
          mv -T -- "$temporary" "$BIN_DIR/$command_name" || true
        elif [[ -L $BIN_DIR/$command_name ]]; then
          unlink -- "$BIN_DIR/$command_name" || true
        fi
      done
      setup_die "failed to select $name; restored the previous selection" || true
      return "$status"
    fi
  done
  printf 'setup-tools: selected %s\n' "$name"
}

install_requested() {
  local from_dir=$1
  local name
  local version
  local selected

  for name in "${@:2}"; do
    acquire_lock "$name"
    load_tool_versions "$name"
    selected=${TOOL_VERSIONS[0]}
    for version in "${TOOL_VERSIONS[@]}"; do
      install_version "$from_dir" "$name" "$version"
    done
    load_tool_release "$name" "$selected"
    activate_links "$name" "${SPEC_LINKS[@]}"
  done
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then find "$path" -depth -delete; fi
  done
  for path in "${HELD_LOCKS[@]:-}"; do
    if [[ -d $path && ! -L $path ]]; then rmdir -- "$path"; fi
  done
  exit "$status"
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
# Profiles are data needed by --help and by the default selection. Sourcing
# this file does not download, install or validate anything.
# shellcheck source=versions.env
source "$REPO_DIR/versions.env"
SETUP_PROGRAM=setup-tools
declare -a NORMALIZED_TOOLS=()
declare -a TOOL_VERSIONS=()
declare -a SPEC_DESTS=()
declare -a SPEC_LINKS=()
declare -a TEMP_PATHS=()
declare -a HELD_LOCKS=()
BIN_DIR=
STATE_DIR=
STAGE_DIR=
SPEC_ASSET=
SPEC_FORMAT=
SPEC_MEMBER=
SPEC_SECOND_MEMBER=
RELEASE_VERSION=
RELEASE_URL=
RELEASE_SHA256=
RELEASE_ASSET=
declare -A TOOL_PROBE_ARGS=(
  [kubeconform]='-v'
  [kyverno]='version'
  [k9s]=$'version\n--short'
  [kubectl]=$'version\n--client'
  [helm]=$'version\n--short'
  [oh-my-posh]='version'
)
trap cleanup EXIT
main "$@"
