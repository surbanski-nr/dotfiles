#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-tools [NAME ...]

Install selected Linux x86-64 tools and tmux plugins under
${DOTFILES_RELEASE_ROOT:-~/dotfiles-releases}/online.
Activate them with: dotfiles-release set online
For offline deployment, use the complete dotfiles release instead.
EOF
  printf 'Names:'
  printf ' %s' "${TOOLS[@]}"
  printf '\n'
}

main() {
  local -a requested=()
  local full_selection=false

  while (($#)); do
    case $1 in
      -h | --help)
        usage
        return 0
        ;;
      --*)
        report_error "unknown option: $1"
        ;;
      *)
        requested+=("$1")
        shift
        ;;
    esac
  done

  load_setup_config
  if ((${#requested[@]} == 0)); then
    requested=("${TOOLS[@]}")
    full_selection=true
  fi
  validate_host
  select_requested_tools "${requested[@]}"
  printf 'setup-tools: checking requested tools\n'
  preflight "${SELECTED_TOOLS[@]}"
  install_selected_tools "${SELECTED_TOOLS[@]}"
  if [[ $full_selection == true ]]; then
    remove_unselected_commands
  fi
  finish_online_setup "$REPO_DIR"
}

load_setup_config() {
  # shellcheck source=system.env
  source "$REPO_DIR/system.env"
  validate_tool_config online

  configure_online_paths
  STATE_DIR=$ONLINE_ROOT/state/setup-tools
}

validate_host() {
  [[ $(uname -s) == Linux ]] || report_error 'only Linux is supported'
  [[ $(uname -m) == x86_64 ]] || report_error 'only Linux x86-64 is supported'
  require_setup_commands setup-tools
}

# Validate names and deduplicate requests, preserving their selection order.
select_requested_tools() {
  local name
  local allowed
  local supported
  local seen=' '

  SELECTED_TOOLS=()
  for name in "$@"; do
    supported=0
    for allowed in "${TOOLS[@]}"; do
      if [[ $name == "$allowed" ]]; then
        supported=1
        break
      fi
    done
    if ((supported == 0)); then
      report_error "unknown tool: $name"
      return 1
    fi
    if [[ $seen != *" $name "* ]]; then
      # Python setup always uses our reviewed uv, including when uv is requested later.
      if [[ $name == python && $seen != *' uv '* ]]; then
        SELECTED_TOOLS+=(uv)
        seen+='uv '
      fi
      SELECTED_TOOLS+=("$name")
      seen+="$name "
    fi
  done
}

load_tool_versions() {
  release_versions TOOL_RELEASES "$1" || return
  TOOL_VERSIONS=("${RELEASE_VERSIONS[@]}")
}

load_tool_release() {
  local name=$1
  local version=$2
  select_release TOOL_RELEASES "$name" "$version" || return
  if [[ $RELEASE_URL == - ]]; then
    report_error "$name $version has no direct artifact"
    return 1
  fi
  artifact_layout "$name" "$version" "$RELEASE_ASSET"
}

state_path() {
  printf '%s/%s-%s.state\n' "$STATE_DIR" "$1" "$2"
}

destinations_exist() {
  local destination
  for destination in "${SPEC_DESTS[@]}"; do
    if [[ ! -e $PAYLOAD_DIR/$destination && ! -L $PAYLOAD_DIR/$destination ]]; then
      return 1
    fi
  done
}

# A named classification permits recovery without using error exit codes as data.
# The saved phase owns payloads; complete does not mean canonical links are selected.
classify_installation() {
  local name=$1
  local version=$2
  local expected_artifact=$3
  local path
  local actual
  local destination
  local expected_paths recorded_paths

  path=$(state_path "$name" "$version")
  if [[ ! -e $path && ! -L $path ]]; then
    for destination in "${SPEC_DESTS[@]}"; do
      if [[ -e $PAYLOAD_DIR/$destination || -L $PAYLOAD_DIR/$destination ]]; then
        report_error "unmanaged versioned destination exists: $PAYLOAD_DIR/$destination"
        return 1
      fi
    done
    INSTALLATION_STATE=missing
    return 0
  fi
  if ! read_tool_state "$path"; then
    report_error "invalid installation state: $path"
    return 1
  fi
  expected_paths=$(
    IFS=,
    printf '%s' "${SPEC_DESTS[*]}"
  )
  recorded_paths=$(
    IFS=,
    printf '%s' "${RECORDED_PAYLOAD_PATHS[*]}"
  )
  if [[ $recorded_paths != "$expected_paths" ]]; then
    report_error "installation state has unexpected payload paths: $path"
    return 1
  fi
  if [[ $RECORDED_ARTIFACT_SHA256 != "$expected_artifact" ]]; then
    report_error "state digest differs for $name $version"
    return 1
  fi
  if ! destinations_exist; then
    if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
      report_error "managed installation is incomplete: $name $version"
      return 1
    fi
    INSTALLATION_STATE=pending-incomplete
    return 0
  fi
  actual=$(tool_content_digest "$PAYLOAD_DIR" "${SPEC_DESTS[@]}") || return
  if [[ $actual != "$RECORDED_PAYLOAD_SHA256" ]]; then
    if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
      report_error "managed installation was modified: $name $version"
      return 1
    fi
    INSTALLATION_STATE=pending-incomplete
    return 0
  fi
  if [[ $RECORDED_INSTALL_PHASE == complete ]]; then
    INSTALLATION_STATE=complete
  else
    INSTALLATION_STATE=pending-intact
  fi
}

state_owns_link_target() {
  local name=$1 command_name=$2 target=$3
  local state version entry actual

  for state in "$STATE_DIR/$name-"*.state; do
    if [[ ! -f $state || -L $state ]]; then
      continue
    fi
    version=${state##*/}
    version=${version#"$name-"}
    version=${version%.state}
    if ! read_tool_state "$state"; then
      continue
    fi
    if [[ $RECORDED_INSTALL_PHASE != complete ]]; then
      continue
    fi
    artifact_layout "$name" "$version" retained || return
    for entry in "${SPEC_LINKS[@]}"; do
      if [[ $entry != "$command_name:$target" ]]; then
        continue
      fi
      destinations_exist || return 1
      actual=$(tool_content_digest "$PAYLOAD_DIR" "${SPEC_DESTS[@]}") || return 1
      [[ $actual == "$RECORDED_PAYLOAD_SHA256" ]]
      return
    done
  done
  return 1
}

# Never overwrite another provider or a file this installer cannot authenticate.
preflight_link() {
  local name=$1
  local entry=$2
  local command_name=${entry%%:*}
  local link="$BIN_DIR/$command_name"
  local target
  local ownership_command=$command_name

  if [[ $command_name == "$name-"* ]]; then
    ownership_command=$name
  fi

  if [[ -L $link ]]; then
    target=$(readlink -- "$link")
    if ! state_owns_link_target "$name" "$ownership_command" "$target"; then
      report_error "refusing foreign link: $link -> $target"
      return 1
    fi
    return 0
  fi
  if [[ -e $link ]]; then
    report_error "refusing unmanaged path: $link"
    return 1
  fi
}

preflight() {
  local build_command
  local name
  local version
  local entry
  local -a plugins=() binary_tools=()

  for name in "$@"; do
    if [[ -v TMUX_PLUGINS[$name] ]]; then
      plugins+=("$name")
    else
      binary_tools+=("$name")
    fi
  done
  if ((${#binary_tools[@]})); then
    if [[ -e $BIN_DIR || -L $BIN_DIR ]]; then
      if [[ ! -d $BIN_DIR || -L $BIN_DIR ]]; then
        report_error "invalid bin directory: $BIN_DIR"
      fi
    fi
    if [[ -e $STATE_DIR || -L $STATE_DIR ]]; then
      if [[ ! -d $STATE_DIR || -L $STATE_DIR ]]; then
        report_error "invalid state directory: $STATE_DIR"
      fi
    fi
  fi
  if ((${#plugins[@]})); then
    require_command git || return
    require_command timeout || return
  fi
  acquire_online_setup_lock
  prepare_online_directories
  if ((${#plugins[@]})); then
    preflight_tmux_plugins "$TMUX_PLUGIN_DIR" "${plugins[@]}" || return
  fi
  if ((${#binary_tools[@]})); then
    mkdir -p "$STATE_DIR"
  fi
  for name in "${binary_tools[@]}"; do
    if [[ $name == python ]]; then
      continue
    fi
    load_tool_versions "$name"
    for version in "${TOOL_VERSIONS[@]}"; do
      load_tool_release "$name" "$version"
      if [[ $SPEC_BUILD == true ]]; then
        for build_command in cc getconf make pkg-config; do
          require_command "$build_command" || return
        done
      fi
      classify_installation "$name" "$version" "$RELEASE_SHA256"
      if [[ $name == kubectl || $name == helm ]]; then
        preflight_link "$name" "$name-$version:${SPEC_LINKS[0]#*:}"
      fi
    done
    load_tool_release "$name" "${TOOL_VERSIONS[0]}"
    for entry in "${SPEC_LINKS[@]}"; do
      preflight_link "$name" "$entry"
    done
  done
}

write_state() {
  local name=$1
  local version=$2
  local status=$3
  local content=$4
  local artifact_digest=$5
  local path
  local temporary

  path=$(state_path "$name" "$version")
  temporary=$(mktemp "$STATE_DIR/.state.XXXXXX")
  TEMP_PATHS+=("$temporary")
  printf '%s\t%s\t%s\t%s\n' "$status" "$artifact_digest" "$content" \
    "$(
      IFS=,
      printf '%s' "${SPEC_DESTS[*]}"
    )" >"$temporary"
  mv -- "$temporary" "$path"
}

# A crash between moving uv and uvx leaves a partial payload. Only remove it
# when no canonical link uses it; intact pending payloads are completed in place.
remove_incomplete_payload() {
  local destination
  local entry
  local command_name
  local link_target

  for destination in "${SPEC_DESTS[@]}"; do
    for entry in "${SPEC_LINKS[@]}"; do
      command_name=${entry%%:*}
      if [[ -L $BIN_DIR/$command_name ]]; then
        link_target=$(readlink -- "$BIN_DIR/$command_name")
        if [[ $link_target == "../tools/$destination" || $link_target == "../tools/$destination/"* ]]; then
          report_error "pending installation is active: $destination"
          return 1
        fi
      fi
    done
  done
  for destination in "${SPEC_DESTS[@]}"; do
    if [[ -e $PAYLOAD_DIR/$destination || -L $PAYLOAD_DIR/$destination ]]; then
      find "$PAYLOAD_DIR/$destination" -depth -delete
    fi
  done
}

# Install or recover one version, without changing the selected command links.
install_version() {
  local name=$1
  local version=$2
  local input
  local content

  load_tool_release "$name" "$version"
  classify_installation "$name" "$version" "$RELEASE_SHA256"
  case $INSTALLATION_STATE in
    complete)
      printf 'setup-tools: reuse %s %s\n' "$name" "$version"
      return
      ;;
    pending-intact)
      write_state "$name" "$version" complete "$RECORDED_PAYLOAD_SHA256" "$RELEASE_SHA256"
      printf 'setup-tools: recovered %s %s\n' "$name" "$version"
      return
      ;;
    pending-incomplete)
      remove_incomplete_payload
      ;;
    missing) ;;
  esac

  printf 'setup-tools: installing %s %s\n' "$name" "$version"
  STAGE_DIR=$(mktemp -d "$PAYLOAD_DIR/.setup-tools.XXXXXX")
  TEMP_PATHS+=("$STAGE_DIR")
  input="$STAGE_DIR/$SPEC_ASSET"
  download_file "$RELEASE_URL" "$input"
  prepare_tool_artifact TOOL_RELEASES "$name" "$version" "$input" "$STAGE_DIR"

  content=$(tool_content_digest "$STAGE_DIR" "${SPEC_DESTS[@]}")
  write_state "$name" "$version" pending "$content" "$RELEASE_SHA256"
  publish_tool_artifact "$STAGE_DIR" "$PAYLOAD_DIR"
  write_state "$name" "$version" complete "$content" "$RELEASE_SHA256"
  printf 'setup-tools: installed %s %s\n' "$name" "$version"
}

activate_links() {
  local name=$1
  local version=$2
  shift 2
  local entry
  local command_name
  local target
  local temporary
  local status
  local index
  local -a commands=()
  local -a previous_targets=()
  local -a had_previous=()

  for entry in "$@"; do
    preflight_link "$name" "$entry" || return
  done
  for entry in "$@"; do
    command_name=${entry%%:*}
    target=${entry#*:}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    [[ ! -e $temporary && ! -L $temporary ]] || report_error "temporary link exists: $temporary"
    ln -s -- "$target" "$temporary"
    TEMP_PATHS+=("$temporary")
    commands+=("$command_name")
    if [[ -L $BIN_DIR/$command_name ]]; then
      had_previous+=(true)
      previous_targets+=("$(readlink -- "$BIN_DIR/$command_name")")
    else
      had_previous+=(false)
      previous_targets+=('')
    fi
  done
  for index in "${!commands[@]}"; do
    command_name=${commands[$index]}
    temporary="$BIN_DIR/.${command_name}.link.$$"
    if mv -T -- "$temporary" "$BIN_DIR/$command_name"; then
      continue
    else
      status=$?
      for ((; index >= 0; index--)); do
        command_name=${commands[$index]}
        if [[ ${had_previous[$index]} == true ]]; then
          temporary="$BIN_DIR/.${command_name}.restore.$$"
          ln -s -- "${previous_targets[$index]}" "$temporary" || continue
          TEMP_PATHS+=("$temporary")
          mv -T -- "$temporary" "$BIN_DIR/$command_name" || true
        elif [[ -L $BIN_DIR/$command_name ]]; then
          unlink -- "$BIN_DIR/$command_name" || true
        fi
      done
      report_error "failed to select $name; restored the previous selection" || true
      return "$status"
    fi
  done
  printf 'setup-tools: selected %s %s\n' "$name" "$version"
}

select_runtime_tree() {
  local name=$1 version=$2 tree=${SPEC_DESTS[0]}
  local canonical command_name target temporary

  canonical=${tree%-"$version"}
  command_name=${SPEC_LINKS[0]%%:*}
  if [[ -e $PAYLOAD_DIR/$canonical || -L $PAYLOAD_DIR/$canonical ]]; then
    if [[ ! -L $PAYLOAD_DIR/$canonical ]]; then
      report_error "refusing unmanaged runtime path: $PAYLOAD_DIR/$canonical"
      return 1
    fi
    target=$(readlink -- "$PAYLOAD_DIR/$canonical")
    if ! state_owns_link_target "$name" "$command_name" "../tools/$target/bin/$command_name"; then
      report_error "refusing foreign runtime link: $PAYLOAD_DIR/$canonical"
      return 1
    fi
  fi
  temporary=$PAYLOAD_DIR/.$canonical.link.$$
  TEMP_PATHS+=("$temporary")
  ln -s -- "$tree" "$temporary"
  mv -T -- "$temporary" "$PAYLOAD_DIR/$canonical"
}

remove_unselected_commands() {
  local tool commands command_name link target

  while IFS= read -r tool; do
    if list_has TOOLS "$tool"; then
      continue
    fi
    if [[ $tool == uv ]] && list_has TOOLS python; then
      continue
    fi
    commands=$(tool_commands "$tool") || return
    if [[ -z $commands ]]; then
      continue
    fi
    while IFS= read -r command_name; do
      for link in "$BIN_DIR/$command_name" "$BIN_DIR/$command_name-"*; do
        if [[ ! -L $link ]]; then
          continue
        fi
        target=$(readlink -- "$link") || return
        if state_owns_link_target "$tool" "$command_name" "$target"; then
          unlink -- "$link" || return
          printf 'setup-tools: removed unselected command %s\n' "${link##*/}"
        fi
      done
    done <<<"$commands"
  done < <(known_tool_names)
}

# Reconcile every configured version, then select the first only after success.
install_selected_tools() {
  local name
  local version
  local selected

  for name in "$@"; do
    if [[ -v TMUX_PLUGINS[$name] ]]; then
      printf 'setup-tools: installing %s\n' "$name"
      install_tmux_plugin "$name" "$TMUX_PLUGIN_DIR" || return
      continue
    fi
    load_tool_versions "$name"
    selected=${TOOL_VERSIONS[0]}
    if [[ $name == python ]]; then
      printf 'setup-tools: installing Python %s through uv\n' "${TOOL_VERSIONS[*]}"
      "$BIN_DIR/uv" python install --no-config --no-bin "${TOOL_VERSIONS[@]}"
      "$BIN_DIR/uv" python pin --no-config --no-project --global "$selected"
      printf 'setup-tools: selected Python %s through uv\n' "$selected"
      continue
    fi
    for version in "${TOOL_VERSIONS[@]}"; do
      install_version "$name" "$version"
    done
    if [[ $name == kubectl || $name == helm ]]; then
      for version in "${TOOL_VERSIONS[@]}"; do
        load_tool_release "$name" "$version"
        activate_links "$name" "$version" "$name-$version:${SPEC_LINKS[0]#*:}"
      done
    fi
    load_tool_release "$name" "$selected"
    if [[ $SPEC_FORMAT == *-tree ]]; then
      select_runtime_tree "$name" "$selected"
      load_tool_release "$name" "$selected"
    fi
    activate_links "$name" "$selected" "${SPEC_LINKS[@]}"
  done
}

REPO_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/setup-lib
source "$REPO_DIR/scripts/setup-lib"
source "$REPO_DIR/scripts/setup-catalog-lib"
source "$REPO_DIR/scripts/setup-recipes-lib"
source "$REPO_DIR/scripts/setup-tools-lib"
# shellcheck source=scripts/setup-tmux-lib
source "$REPO_DIR/scripts/setup-tmux-lib"
# Tool lists are needed by --help and by the default selection. Sourcing
# this file does not download, install or validate anything.
# shellcheck source=tools.env
source "$REPO_DIR/tools.env"
# Cleanup must also work when --help returns before any installation starts.
declare -a TEMP_PATHS=()
trap cleanup_setup EXIT
main "$@"
