# Trusted Bash data shared by connected installation and release health.
# Arguments are whitespace-separated words, without shell quoting or expansion.
# Tools without an entry use --version.
declare -gA TOOL_PROBE_ARGS=(
  [kubeconform]='-v'
  [kyverno]='version'
  [k9s]='version --short'
  [kubectl]='version --client'
  [helm]='version --short'
  [oh-my-posh]='version'
  [tmux]='-V'
  [terraform]='version'
)
