# Version probe arguments shared by setup-tools and release health; default is --version.
declare -gA TOOL_PROBE_ARGS=(
  [kubeconform]='-v'
  [kyverno]='version'
  [k9s]='version --short'
  [kubectl]='version --client'
  [helm]='version --short'
  [oh-my-posh]='version'
  [tmux]='-V'
  [terraform]='version'
)

# Release executable|metadata version field, shared by the builder and health checks.
declare -ga RELEASE_TOOL_VERSIONS=(
  'fd|FD_VERSION'
  'nvim|NVIM_VERSION'
  'tmux|TMUX_VERSION'
  'node|NODE_VERSION'
  'npm|NPM_VERSION'
  'rg|RG_VERSION'
  'zoxide|ZOXIDE_VERSION'
  'k9s|K9S_VERSION'
  'kubectx|KUBECTX_VERSION'
  'kubens|KUBECTX_VERSION'
  'oh-my-posh|OMP_VERSION'
  'task|TASK_VERSION'
  'fzf|FZF_VERSION'
  'terraform|TERRAFORM_VERSION'
)
