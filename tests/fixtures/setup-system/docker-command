#!/usr/bin/env bash

set -euo pipefail

command_name=${0##*/}
{
  printf '%s' "$command_name"
  printf '\t%s' "$@"
  printf '\n'
} >>"$TEST_DOCKER_LOG"

if [[ ${TEST_DOCKER_TIMEOUT:-} == "$command_name" ]]; then
  exit 124
fi

case $command_name in
  curl)
    [[ ${TEST_DOCKER_FAIL:-} != curl ]] || exit 75
    if [[ ${TEST_DOCKER_NETWORK_FAIL:-0} == 1 ]]; then
      printf 'curl: (6) Could not resolve host: download.docker.com\n' >&2
      exit 6
    fi
    while (($#)); do
      case $1 in
        --output)
          printf 'fixture Docker signing key\n' >"$2"
          exit 0
          ;;
        *) shift ;;
      esac
    done
    exit 1
    ;;
  dpkg-query)
    [[ ${*: -1} == "${TEST_DOCKER_CONFLICT:-}" ]] || exit 1
    printf 'installed'
    ;;
  rpm)
    if [[ ${2:-} == gnupg2-minimal ]]; then
      [[ ${TEST_RPM_MINIMAL:-0} == 1 ]]
    else
      [[ ${2:-} == "${TEST_DOCKER_CONFLICT:-}" ]]
    fi
    ;;
  systemctl)
    [[ ${TEST_DOCKER_FAIL:-} != systemctl ]] || exit 73
    ;;
  gpg)
    [[ ${TEST_DOCKER_FAIL:-} != gpg ]] || exit 76
    ;;
  docker)
    [[ ${TEST_DOCKER_FAIL:-} != docker ]] || exit 74
    ;;
  groupadd | usermod) ;;
  *) exit 1 ;;
esac
