#!/usr/bin/env bash

set -eo pipefail

: "${TEST_REPO_DIR:?}"
: "${TEST_SCENARIO:?}"

load_aliases() {
  # shellcheck source=../../../bash/.bash_aliases
  source "$TEST_REPO_DIR/bash/.bash_aliases"
}

load_bashrc() {
  # shellcheck source=../../../bash/.bashrc
  source "$TEST_REPO_DIR/bash/.bashrc"
}

load_profile() {
  # shellcheck source=../../../bash/.bash_profile
  source "$TEST_REPO_DIR/bash/.bash_profile"
}

run_prompt_hooks() {
  local prompt_command
  for prompt_command in "${PROMPT_COMMAND[@]}"; do eval "$prompt_command"; done
}

case $TEST_SCENARIO in
  check-tools)
    load_aliases
    dotfiles-check
    ;;
  check-mc-wrapper)
    load_aliases
    shopt -s expand_aliases
    alias mc='command mc'
    dotfiles-check
    ;;
  editor)
    load_aliases
    v 'file with space'
    ;;
  fzf-preview)
    load_aliases
    ff
    ;;
  missing-kubectl)
    load_aliases
    kl pod-name
    ;;
  filter-pods)
    load_aliases
    kgp -v
    ;;
  failed-pod-list)
    load_aliases
    kpl api
    ;;
  failed-log-pipeline)
    load_aliases
    kl api
    ;;
  write-pod-logs)
    load_aliases
    kpl api
    ;;
  reload)
    load_bashrc
    load_bashrc
    load_bashrc
    ;;
  prompt-history)
    set +o history
    PROMPT_COMMAND='printf "user\n" >>"$TEST_PROMPT_LOG"'
    load_bashrc
    load_bashrc
    load_bashrc
    history -c
    history -s 'command from first shell'
    run_prompt_hooks
    printf 'command from second shell\n' >>"$HISTFILE"
    run_prompt_hooks
    HISTTIMEFORMAT='' history
    ;;
  shared-history)
    set +o history
    load_bashrc
    history -c
    history -s 'shared history seed'
    run_prompt_hooks
    for round in 1 2; do
      # shellcheck disable=SC2016
      TEST_SCENARIO=shared-history-peer TEST_HISTORY_ROUND=$round \
        bash --noprofile --norc -i -c 'source "$1"' bash-peer "${BASH_SOURCE[0]}"
      history -s "command from second shell $round"
      run_prompt_hooks
      load_bashrc
      run_prompt_hooks
    done
    HISTTIMEFORMAT='' history
    ;;
  shared-history-peer)
    set +o history
    load_bashrc
    history -c
    history -r
    history -s "command from first shell $TEST_HISTORY_ROUND"
    run_prompt_hooks
    load_bashrc
    run_prompt_hooks
    ;;
  prompt-history-array)
    set +o history
    # Exact duplicates and legacy suffixes must not discard unrelated hooks.
    # Hook variables expand at prompt time, not while constructing the array.
    # shellcheck disable=SC2016
    PROMPT_COMMAND=(
      'printf "user\n" >>"$TEST_PROMPT_LOG"'
      '_dotfiles_history_sync'
      'printf "other-user\n" >>"$TEST_PROMPT_LOG"; history -a; history -r'
      'printf "user\n" >>"$TEST_PROMPT_LOG"'
      '_dotfiles_history_sync'
    )
    load_bashrc
    load_bashrc
    load_bashrc
    history_hooks=0
    for prompt_command in "${PROMPT_COMMAND[@]}"; do
      [[ $prompt_command != _dotfiles_history_sync ]] || ((history_hooks += 1))
    done
    printf 'history_hooks=%s\n' "$history_hooks"
    history -c
    history -s 'command with array hooks'
    run_prompt_hooks
    run_prompt_hooks
    HISTTIMEFORMAT='' history
    ;;
  history-save-failure)
    set +o history
    load_bashrc
    history -c
    history -s 'command awaiting successful save'
    history_file=$HISTFILE
    HISTFILE=$HOME/missing-directory/history
    if _dotfiles_history_sync; then exit 1; fi
    HISTTIMEFORMAT='' history
    unset HISTFILE
    _dotfiles_history_sync
    HISTTIMEFORMAT='' history
    HISTFILE=$history_file
    _dotfiles_history_sync
    HISTTIMEFORMAT='' history
    ;;
  broken-integration)
    zoxide() { return 9; }
    load_bashrc
    ;;
  invalid-integration)
    zoxide() { printf 'if broken'; }
    load_bashrc
    printf 'continued=yes\n'
    ;;
  failed-agent-key)
    load_profile
    printf 'profile_status=%s sock=%s pid=%s\n' \
      "$?" "${SSH_AUTH_SOCK:-unset}" "${SSH_AGENT_PID:-unset}"
    ;;
  stale-agent-socket)
    rm -f "$HOME/.ssh/github"
    load_profile
    printf 'stale_status=%s sock=%s\n' "$?" "${SSH_AUTH_SOCK:-unset}"
    ;;
  shared-agent)
    load_bashrc
    load_bashrc
    load_bashrc
    printf 'shared_sock=%s pid=%s\n' \
      "${SSH_AUTH_SOCK:-unset}" "${SSH_AGENT_PID:-unset}"
    ;;
  independent-editors)
    shopt -s expand_aliases
    vi() { command vi "$@"; }
    alias vim='command vim'
    load_bashrc
    vi first
    eval 'vim second'
    printf 'cat=%s vi=%s vim=%s v=%s\n' \
      "$(type -t cat)" "$(type -t vi)" "$(type -t vim)" "$(type -t v)"
    ;;
  git-editor)
    load_bashrc
    load_bashrc
    git init -q "$HOME/repository"
    git -C "$HOME/repository" -c user.name=fixture \
      -c user.email=fixture@example.invalid -c commit.gpgsign=false \
      -c core.hooksPath=/dev/null commit -q --allow-empty
    [[ $(git -C "$HOME/repository" log -1 --format=%s) == 'system vi commit' ]]
    ;;
  custom-dotfiles)
    load_bashrc
    eval cddot
    printf 'dotfiles=%s pwd=%s\n' "$DOTFILES" "$PWD"
    ;;
  release-switch)
    unset DOTFILES DOTFILES_AUTO_ROOT
    source "$HOME/.bashrc"
    printf 'before=%s config=%s\n' "$(release-command)" "$(config-marker)"
    PATH="$TEST_RELEASE_A/bin:$TEST_RELEASE_A/share/nvim2/mason/bin:$TEST_RELEASE_A/share/nvim2/mason/packages/ansible-lint/venv/bin:$PATH"
    export PATH
    unlink "$HOME/dotfiles-releases/current"
    ln -s "${TEST_RELEASE_B##*/}" "$HOME/dotfiles-releases/current"
    source "$HOME/.bashrc"
    source "$HOME/.bashrc"
    hash -r
    printf 'after=%s config=%s asdf=%s\n' "$(release-command)" \
      "$(config-marker)" "$(command -v asdf-only-tool)"
    for removed in removed-release-command removed-mason-command removed-venv-command removed-script-command; do
      if command -v "$removed" >/dev/null; then exit 95; fi
    done
    unlink "$HOME/dotfiles-releases/current"
    ln -s "${TEST_RELEASE_A##*/}" "$HOME/dotfiles-releases/current"
    hash -r
    printf 'reselected=%s\n' "$(release-command)"
    ;;
  root-override)
    unset DOTFILES DOTFILES_AUTO_ROOT
    source "$TEST_CONNECTED_ROOT/bash/.bashrc"
    DOTFILES=$TEST_CUSTOM_ROOT
    export DOTFILES
    source "$TEST_RELEASE_A/dotfiles/bash/.bashrc"
    printf 'override-before=%s:%s\n' "$DOTFILES" "${DOTFILES_AUTO_ROOT:-unset}"
    DOTFILES=$TEST_SECOND_CUSTOM_ROOT
    export DOTFILES
    source "$TEST_RELEASE_B/dotfiles/bash/.bashrc"
    printf 'override-during=%s:%s\n' "$DOTFILES" "${DOTFILES_AUTO_ROOT:-unset}"
    DOTFILES=$TEST_RELEASE_A/dotfiles
    unset DOTFILES_AUTO_ROOT
    source "$TEST_CONNECTED_ROOT/bash/.bashrc"
    printf 'legacy-before-reset=%s\n' "$DOTFILES"
    unset DOTFILES DOTFILES_AUTO_ROOT
    source "$TEST_CONNECTED_ROOT/bash/.bashrc"
    printf 'legacy-after-reset=%s\n' "$DOTFILES"
    ;;
  launcher-environment)
    load_bashrc
    printf 'xdg-config=%s xdg-data=%s zoxide=%s markers=%s\n' \
      "${XDG_CONFIG_HOME:-unset}" "${XDG_DATA_HOME:-unset}" \
      "${_ZO_DATA_DIR:-unset}" \
      "${DOTFILES_LAUNCHER_XDG_CONFIG_HOME_SET:-}${DOTFILES_LAUNCHER_XDG_DATA_HOME_SET:-}${DOTFILES_LAUNCHER_ZO_DATA_DIR_SET:-}"
    printf 'go-root=%s go-toolchain=%s go-markers=%s\n' "${GOROOT:-unset}" "${GOTOOLCHAIN:-unset}" \
      "${DOTFILES_LAUNCHER_GOROOT_SET:-}${DOTFILES_LAUNCHER_GOTOOLCHAIN_SET:-}"
    ;;
  path-order)
    load_bashrc
    load_bashrc
    printf 'path=%s terraform=%s python=%s\n' "$PATH" \
      "$(command -v terraform)" "$(command -v python)"
    ;;
  fzf-init)
    load_bashrc
    declare -F __fzf_test_binding >/dev/null
    printf 'fzf-init=yes\n'
    ;;
  fzf-failure)
    load_bashrc
    printf 'continued=yes\n'
    ;;
  user-bin)
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    hash -r
    printf 'override=%s unique=%s\n' "$(path-probe)" "$(unique-user-tool)"
    printf 'asdf-only=%s\n' "$(asdf-only-tool)"
    printf 'path=%s\n' "$PATH"
    entries=0
    IFS=: read -r -a paths <<<"$PATH"
    for entry in "${paths[@]}"; do
      [[ $entry != "$HOME/bin" ]] || ((entries += 1))
    done
    [[ $entries -eq 1 ]] || exit 90
    if command -v cwd-only >/dev/null; then exit 91; fi
    export VIRTUAL_ENV="$HOME/project venv"
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    printf 'venv=%s\n' "$(path-probe)"
    unset VIRTUAL_ENV
    chmod 0644 "$HOME/bin/path-probe"
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    hash -r
    printf 'nonexecutable=%s\n' "$(path-probe)"
    chmod 0755 "$HOME/bin/path-probe"
    export DOTFILES_IGNORE_USER_BIN=1
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    hash -r
    printf 'ignored=%s\n' "$(path-probe)"
    if command -v unique-user-tool >/dev/null; then exit 92; fi
    [[ :$PATH: != *":$HOME/bin:"* ]] || exit 93
    unset DOTFILES_IGNORE_USER_BIN
    mv "$HOME/bin" "$HOME/saved-user-bin"
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    hash -r
    printf 'removed=%s\n' "$(path-probe)"
    [[ :$PATH: != *":$HOME/bin:"* ]] || exit 94
    touch "$HOME/bin"
    # shellcheck disable=SC1090
    source "$TEST_BASHRC"
    printf 'regular-file=%s\n' "$(path-probe)"
    ;;
  path-selection)
    load_bashrc
    printf 'selected=%s\n' "$(path-probe)"
    ;;
  kube-prompt-init)
    unset PROMPT_COMMAND
    load_bashrc
    load_bashrc
    printf 'kube-default=%s\n' "$(test -e "$TEST_POSH_STATE" && printf disabled || printf enabled)"
    ;;
  kube-completion)
    load_bashrc
    load_bashrc
    complete -p k
    __start_kubectl
    printf 'k-completion=%s\n' "${COMPREPLY[*]}"
    ;;
  fallback-prompt)
    load_bashrc
    printf 'prompt=%s\n' "${PS1@P}"
    ;;
  kube-prompt-toggle)
    load_aliases
    kp
    kp
    ;;
  stale-vz)
    vz() { printf 'stale-vz\n'; }
    vold() { printf 'stale-vold\n'; }
    vz >/dev/null
    vold >/dev/null
    load_aliases
    [[ $(type -t vz || true) != function ]]
    [[ $(type -t vold || true) != function ]]
    declare -F v >/dev/null
    printf 'editor=v stale=removed\n'
    ;;
  *)
    printf 'unknown test scenario: %s\n' "$TEST_SCENARIO" >&2
    exit 2
    ;;
esac
