#!/usr/bin/env bash

set -euo pipefail

case ${0##*/} in
  mv | sync | mktemp) exit 27 ;;
  flock)
    [[ -n ${TEST_FLOCK_READY:-} ]] || exit 27
    [[ ${1:-} == -u ]] || printf 'waiting\n' >"$TEST_FLOCK_READY"
    exec "$TEST_REAL_FLOCK" "$@"
    ;;
  history-command)
    printf 'check\n' >>"$HOME/archive-checks"
    ;;
  *) exit 2 ;;
esac
