#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >>"$TEST_DOCKER_LOG"
case $1 in
  run)
    if [[ " $* " == *' build '* ]]; then
      if [[ ${TEST_BUILD_FAIL:-0} == 1 ]]; then printf 'fixture build failure\n'; exit 81; fi
      for arg in "$@"; do
        if [[ $arg == *:/out ]]; then output_dir=${arg%:/out}; fi
      done
      archive=dotfiles-${COMMIT_SHA:0:12}-$PLATFORM.tar.gz
      source_archive=$TEST_BUILD_ARCHIVE
      if [[ -n ${TEST_BUILD_ARCHIVES_DIR:-} ]]; then source_archive=$TEST_BUILD_ARCHIVES_DIR/$archive; fi
      cp "$source_archive" "$output_dir/$archive"
      (cd "$output_dir" && sha256sum "$archive" >"$archive.sha256")
      printf 'fixture build succeeded\n'
    elif [[ " $* " == *' verify '* ]]; then
      [[ " $* " == *' --init '* && " $* " == *' --network none '* && " $* " == *' --user '* ]] || exit 2
      if [[ ${TEST_VERIFY_FAIL:-0} == 1 ]]; then printf 'fixture offline failure\n'; exit 82; fi
      printf 'fixture offline health succeeded\n'
    else
      printf 'fixture container started\n'
    fi
    ;;
  pull) printf 'fixture image pulled\n' ;;
  exec)
    if [[ ${TEST_PREPARE_FAIL:-0} == 1 && " $* " == *' prepare-runtime '* ]]; then
      printf 'fixture runtime preparation failure\n'
      exit 83
    fi
    ;;
  cp | commit | rm | image | info) ;;
  *) exit 2 ;;
esac
