#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >>"$TEST_DOCKER_LOG"

block_worker() {
  [[ ${TEST_HANG_PHASE:-} == "$1" ]] || return 0
  trap 'exit 143' TERM
  printf '%s\n' "$$" >"$TEST_WORKER_READY"
  while :; do
    sleep 1
  done
}

parallel_barrier() {
  [[ -n ${TEST_PARALLEL_DIR:-} ]] || return 0
  local phase=$1 deadline=$((SECONDS + 5)) expected=4 batch=0 index
  local -a platforms=() started
  [[ $phase != verify ]] || expected=${TEST_PARALLEL_VERIFY_COUNT:-4}
  if [[ -n ${TEST_WORKER_PLATFORMS:-} ]]; then
    read -r -a platforms <<<"$TEST_WORKER_PLATFORMS"
    for index in "${!platforms[@]}"; do
      if [[ ${platforms[$index]} == "$PLATFORM" ]]; then
        batch=$((index / TEST_CI_CPUS))
        break
      fi
    done
    expected=0
    for ((index = batch * TEST_CI_CPUS; index < (batch + 1) * TEST_CI_CPUS && index < ${#platforms[@]}; index++)); do
      if [[ $phase == verify && ${platforms[$index]} == "${TEST_BUILD_FAIL:-}" ]]; then
        continue
      fi
      ((expected += 1))
    done
  fi
  # Synchronize each batch instead of relying on timed worker windows.
  if [[ -n ${TEST_WORKER_EVENTS:-} ]]; then
    printf '%s start %s\n' "$phase" "$PLATFORM" >>"$TEST_WORKER_EVENTS"
  fi
  : >"$TEST_PARALLEL_DIR/$phase-$batch-$PLATFORM"
  while :; do
    started=("$TEST_PARALLEL_DIR/$phase-$batch-"*)
    ((${#started[@]} == expected)) && break
    if ((SECONDS >= deadline)); then
      printf 'fixture %s workers did not run in parallel\n' "$phase" >&2
      return 84
    fi
    sleep 0.02
  done
  if [[ -n ${TEST_WORKER_EVENTS:-} ]]; then
    printf '%s end %s\n' "$phase" "$PLATFORM" >>"$TEST_WORKER_EVENTS"
  fi
}

case $1 in
  run)
    if [[ " $* " == *' build '* ]]; then
      parallel_barrier build
      block_worker build
      if [[ ${TEST_BUILD_FAIL:-0} == 1 || ${TEST_BUILD_FAIL:-0} == "$PLATFORM" ]]; then
        printf 'fixture build failure\n'
        exit 81
      fi
      for arg in "$@"; do
        if [[ $arg == *:/out ]]; then
          output_dir=${arg%:/out}
        fi
      done
      if [[ -n ${TEST_DOCKER_SHARED_ROOT:-} &&
        $output_dir != "$TEST_DOCKER_SHARED_ROOT/"* ]]; then
        printf 'fixture output bind is outside the shared checkout\n' >&2
        exit 85
      fi
      archive=dotfiles-${COMMIT_SHA:0:12}-$PLATFORM.tar.gz
      source_archive=$TEST_BUILD_ARCHIVE
      if [[ -n ${TEST_BUILD_ARCHIVES_DIR:-} ]]; then
        source_archive=$TEST_BUILD_ARCHIVES_DIR/$archive
      fi
      cp "$source_archive" "$output_dir/$archive"
      (cd "$output_dir" && sha256sum "$archive" >"$archive.sha256")
      printf 'built %s\n' "$PLATFORM" >>"$TEST_DOCKER_LOG"
      printf 'fixture build succeeded\n'
    elif [[ " $* " == *' verify '* ]]; then
      parallel_barrier verify
      [[ " $* " == *' --init '* && " $* " == *' --network none '* && " $* " == *' --user '* ]] || exit 2
      [[ " $* " == *' install /artifact.tar.gz'* && " $* " == *'tools_runner.sh'* ]] || exit 2
      block_worker verify
      if [[ ${TEST_VERIFY_FAIL:-0} == 1 || ${TEST_VERIFY_FAIL:-0} == "$PLATFORM" ]]; then
        printf 'fixture offline failure\n'
        exit 82
      fi
      printf 'fixture offline health succeeded\n'
    else
      printf 'fixture container started\n'
    fi
    ;;
  pull)
    printf 'fixture image pulled\n'
    ;;
  exec)
    if [[ ${TEST_PREPARE_FAIL:-0} == 1 && " $* " == *' prepare-runtime '* ]]; then
      printf 'fixture runtime preparation failure\n'
      exit 83
    fi
    ;;
  cp)
    [[ -e $2 ]] || exit 1
    ;;
  commit | rm | image | info) ;;
  *)
    exit 2
    ;;
esac
