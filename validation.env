# Python-based YAML validator installed in its own venv, not a native archive.
YAMLLINT_VERSION=1.37.1
# yamllint dependency for matching ignored file paths.
YAMLLINT_PATHSPEC_VERSION=0.12.1
# yamllint dependency for parsing YAML.
YAMLLINT_PYYAML_VERSION=6.0.2

# Repository check tools installed by scripts/install-validation-tool.
declare -ga VALIDATOR_TOOLS=(
  actionlint
  shellcheck
  stylua
  task
  yamllint
  zizmor
)

# Native validator version|HTTPS URL|SHA256 records; Task also serves setup-tools.
declare -gA VALIDATOR_RELEASES=(
  [actionlint]='
1.7.12|https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz|8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
'
  [shellcheck]='
0.11.0|https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz|8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
'
  [stylua]='
2.3.1|https://github.com/JohnnyMorganz/StyLua/releases/download/v2.3.1/stylua-linux-x86_64.zip|f0cfea40b3d72223497fa1650061f866e0d19a93a871aae22d3849f1bc9c2722
'
  [zizmor]='
1.30.0|https://github.com/zizmorcore/zizmor/releases/download/v1.30.0/zizmor-x86_64-unknown-linux-gnu.tar.gz|ec8c95cd800845abb9bbc5f377ec7c57d2eb8e2386a00a201d3a74ee4092e5ed
'
  [task]='
3.53.1|https://github.com/go-task/task/releases/download/v3.53.1/task_linux_amd64.tar.gz|a54a408f6861ff921f6e87774180db31bacd8c1e7c944ca696db9fea49a82fc7
'
)
