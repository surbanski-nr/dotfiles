# Common OS prerequisites for running a prepared offline release.
declare -ga SYSTEM_RUNTIME_PACKAGES=(
  bash
  ca-certificates
  coreutils
  diffutils
  findutils
  gawk
  git
  grep
  gzip
  ncurses-term
  sed
  tar
  unzip
  util-linux
)
# Additional common build tools for disposable release builders.
declare -ga SYSTEM_BUILD_PACKAGES=(
  autoconf
  automake
  bison
  curl
  file
  libtool
  make
  patch
)
# Additional common utilities and build tools for normal host setup.
declare -ga SYSTEM_SETUP_PACKAGES=(
  autoconf
  automake
  bash-completion
  bison
  curl
  dos2unix
  file
  htop
  jq
  less
  libtool
  make
  mc
  patch
  python3
  python3-pip
  tmux
)

# Debian and Ubuntu additions to the offline runtime baseline.
declare -ga SYSTEM_DEBIAN_RUNTIME_PACKAGES=(
  iproute2
  libevent-core-2.1-7t64
  libtinfo6
  ncurses-bin
  passwd
  vim-tiny
  xz-utils
)
# Debian and Ubuntu additions for release compilation.
declare -ga SYSTEM_DEBIAN_BUILD_PACKAGES=(
  build-essential
  libevent-dev
  libncurses-dev
  pkg-config
)
# Debian and Ubuntu additions for interactive use and asdf runtime builds.
declare -ga SYSTEM_DEBIAN_SETUP_PACKAGES=(
  build-essential
  dirmngr
  gnupg
  libbz2-dev
  libevent-dev
  libffi-dev
  liblzma-dev
  libncurses-dev
  libreadline-dev
  libssl-dev
  libsqlite3-dev
  pkg-config
  python3-venv
  tk-dev
  uuid-dev
  vim
  zlib1g-dev
)

# Amazon Linux additions to the offline runtime baseline.
declare -ga SYSTEM_AMZN_RUNTIME_PACKAGES=(
  iproute
  libevent
  ncurses-libs
  shadow-utils
  vim-minimal
  which
  xz
)
# Amazon Linux additions for release compilation.
declare -ga SYSTEM_AMZN_BUILD_PACKAGES=(
  cargo
  clang-devel
  gcc
  gcc-c++
  libevent-devel
  ncurses-devel
  pkgconf
)
# Amazon Linux additions for interactive use and asdf runtime builds.
declare -ga SYSTEM_AMZN_SETUP_PACKAGES=(
  bzip2-devel
  gcc
  gcc-c++
  libevent-devel
  libffi-devel
  ncurses-devel
  openssl-devel
  pkgconf
  readline-devel
  sqlite-devel
  tk-devel
  vim-enhanced
  xz-devel
  zlib-devel
)

# Commands setup-system verifies after either package profile.
declare -ga SYSTEM_RUNTIME_COMMANDS=(
  bash
  cmp
  find
  flock
  git
  ip
  tar
  timeout
  unzip
  vi
  xz
)
# Additional commands setup-system verifies after normal host setup.
declare -ga SYSTEM_SETUP_COMMANDS=(
  curl
  file
  gpg
  gpg-agent
  htop
  jq
  less
  make
  mc
  python3
  tmux
  vi
  vim
)

# Commands each network-using setup entry point needs before it can install.
declare -gA SETUP_PREREQUISITES=(
  [setup-tools]='curl flock sha256sum tar mktemp find mv ln readlink'
  [setup-asdf]='awk cmp curl flock find git sha256sum tar mktemp mv ln readlink'
  [update-offline-python-locks]='curl find mktemp mv sha256sum tar timeout'
)
