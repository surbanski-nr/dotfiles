# Trusted, secret-free Bash data. Install the current OS repository candidates.
# Every role includes the common and distribution-specific runtime packages.

declare -ga SYSTEM_RUNTIME_PACKAGES=(
  bash ca-certificates coreutils diffutils findutils gawk git grep gzip
  ncurses-term sed tar unzip util-linux
)
declare -ga SYSTEM_BUILD_PACKAGES=(
  autoconf automake bison curl file libtool make patch
)
declare -ga SYSTEM_CONNECTED_PACKAGES=(
  autoconf automake bash-completion bison curl dos2unix file htop jq libtool
  make mc patch python3 python3-pip tmux
)

declare -ga SYSTEM_DEBIAN_RUNTIME_PACKAGES=(
  iproute2 libevent-core-2.1-7t64 libtinfo6 ncurses-bin passwd xz-utils
)
declare -ga SYSTEM_DEBIAN_BUILD_PACKAGES=(
  build-essential libevent-dev libncurses-dev pkg-config
)
declare -ga SYSTEM_DEBIAN_CONNECTED_PACKAGES=(
  build-essential dirmngr gnupg libbz2-dev libevent-dev libffi-dev liblzma-dev
  libncurses-dev libreadline-dev libssl-dev libsqlite3-dev pkg-config
  python3-venv tk-dev uuid-dev vim zlib1g-dev
)

declare -ga SYSTEM_AMZN_RUNTIME_PACKAGES=(
  iproute libevent ncurses-libs shadow-utils which xz
)
declare -ga SYSTEM_AMZN_BUILD_PACKAGES=(
  cargo clang-devel gcc gcc-c++ libevent-devel ncurses-devel pkgconf
)
declare -ga SYSTEM_AMZN_CONNECTED_PACKAGES=(
  bzip2-devel gcc gcc-c++ libevent-devel libffi-devel ncurses-devel openssl-devel
  pkgconf readline-devel sqlite-devel tk-devel vim-enhanced vim-minimal xz-devel
  zlib-devel
)

# Package names and the executable names they provide are different contracts.
declare -ga SYSTEM_RUNTIME_COMMANDS=(
  bash cmp find flock git ip tar timeout unzip xz
)
declare -ga SYSTEM_CONNECTED_COMMANDS=(
  curl file gpg gpg-agent htop jq make mc python3 tmux vi vim
)

# Commands required before these connected entry points can begin installation.
declare -gA SETUP_PREREQUISITES=(
  [setup-tools]='curl sha256sum tar mktemp find mv ln readlink'
  [setup-asdf]='awk cmp curl find git sha256sum tar mktemp mv ln readlink'
  [update-offline-python-locks]='curl find mktemp mv sha256sum tar timeout'
)
