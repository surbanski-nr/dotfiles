# version probe arguments shared by setup-tools script checks and release health; default is --version.
declare -gA TOOL_PROBE_ARGS=(
  [kubeconform]='-v'
  [kyverno]='version'
  [k9s]='version --short'
  [kind]='version'
  [kubectl]='version --client'
  [helm]='version --short'
  [oh-my-posh]='version'
  [tmux]='-V'
  [terraform]='version'
  [go]='version'
)

declare -ga RELEASE_TOOL_VERSIONS=(
  'actionlint|ACTIONLINT_VERSION'
  'fd|FD_VERSION'
  'gh|GH_VERSION'
  'go|GO_VERSION'
  'htop|HTOP_VERSION'
  'kind|KIND_VERSION'
  'kubeconform|KUBECONFORM_VERSION'
  'kyverno|KYVERNO_VERSION'
  'uv|UV_VERSION'
  'uvx|UV_VERSION'
  'nvim|NVIM_VERSION'
  'tmux|TMUX_VERSION'
  'node|NODE_VERSION'
  'npm|NPM_VERSION'
  'rg|RG_VERSION'
  'zoxide|ZOXIDE_VERSION'
  'k9s|K9S_VERSION'
  'kubectx|KUBECTX_VERSION'
  'kubens|KUBECTX_VERSION'
  'oh-my-posh|OMP_VERSION'
  'task|TASK_VERSION'
  'shellcheck|SHELLCHECK_VERSION'
  'trivy|TRIVY_VERSION'
  'fzf|FZF_VERSION'
  'terraform|TERRAFORM_VERSION'
  'yq|YQ_VERSION'
)
