#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'nvim2-release: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  nvim2-release build PLATFORM SOURCE_DIR OUTPUT_ROOT
  nvim2-release install ARTIFACT_DIR
  nvim2-release prepare-runtime PLATFORM
  nvim2-release rollback
  nvim2-release verify PLATFORM ARTIFACT_DIR
EOF
  exit 2
}

require_root() {
  [[ $(id -u) -eq 0 ]] || die "$1 must run as root"
}

require_value() {
  local name=$1
  [[ -n ${!name:-} ]] || die "$name is not configured"
}

load_release_config() {
  local source_dir=$1
  local config_file="$source_dir/nvim2-release.env"
  local versions_file="$source_dir/versions.env"
  local library_file="$source_dir/scripts/setup-lib"

  [[ -f $config_file ]] || die "missing release config: $config_file"
  [[ -f $versions_file ]] || die "missing version config: $versions_file"
  [[ -f $library_file ]] || die "missing setup library: $library_file"
  # shellcheck source=setup-lib
  source "$library_file"
  SETUP_PROGRAM=nvim2-release
  # shellcheck source=../versions.env
  source "$versions_file"
  setup_validate_versions || exit
  # shellcheck source=../nvim2-release.env
  source "$config_file"
  NODE_VERSION=${NODEJS_VERSIONS%% *}
  for name in NVIM_VERSION NODE_VERSION NPM_VERSION RG_VERSION \
    DEBIAN_TARGET_USER DEBIAN_TARGET_UID DEBIAN_TARGET_HOME \
    UBUNTU_TARGET_USER UBUNTU_TARGET_UID UBUNTU_TARGET_HOME \
    AMZN_TARGET_USER AMZN_TARGET_UID AMZN_TARGET_HOME \
    DEBIAN_13_IMAGE UBUNTU_2404_IMAGE UBUNTU_2604_IMAGE AMZN_2023_IMAGE; do
    require_value "$name"
  done
}

configure_target() {
  case "$1" in
    debian-13-x86_64)
      TARGET_USER=$DEBIAN_TARGET_USER
      TARGET_UID=$DEBIAN_TARGET_UID
      TARGET_HOME=$DEBIAN_TARGET_HOME
      ;;
    ubuntu-*)
      TARGET_USER=$UBUNTU_TARGET_USER
      TARGET_UID=$UBUNTU_TARGET_UID
      TARGET_HOME=$UBUNTU_TARGET_HOME
      ;;
    amzn-2023-x86_64)
      TARGET_USER=$AMZN_TARGET_USER
      TARGET_UID=$AMZN_TARGET_UID
      TARGET_HOME=$AMZN_TARGET_HOME
      ;;
    *) die "unsupported platform: $1" ;;
  esac
  [[ $TARGET_UID =~ ^[0-9]+$ ]] || die "invalid target UID: $TARGET_UID"
  [[ $TARGET_HOME == "/home/$TARGET_USER" ]] ||
    die "target home $TARGET_HOME does not match user $TARGET_USER"
}

validate_platform() {
  local platform=$1
  local expected_id
  local expected_version
  local expected_arch
  local os_release_file=${NVIM2_OS_RELEASE_FILE:-/etc/os-release}

  case "$platform" in
    debian-13-x86_64)
      expected_id=debian
      expected_version=13
      expected_arch=x86_64
      ;;
    ubuntu-24.04-x86_64)
      expected_id=ubuntu
      expected_version=24.04
      expected_arch=x86_64
      ;;
    ubuntu-26.04-x86_64)
      expected_id=ubuntu
      expected_version=26.04
      expected_arch=x86_64
      ;;
    amzn-2023-x86_64)
      expected_id=amzn
      expected_version=2023
      expected_arch=x86_64
      ;;
    *) die "unsupported platform: $platform" ;;
  esac

  [[ -r $os_release_file ]] || die "cannot read OS identity: $os_release_file"
  unset ID VERSION_ID
  # shellcheck disable=SC1090
  source "$os_release_file"
  [[ $ID == "$expected_id" ]] || die "$platform requires OS ID $expected_id, found $ID"
  [[ $VERSION_ID == "$expected_version" ]] ||
    die "$platform requires OS version $expected_version, found $VERSION_ID"
  [[ $(uname -m) == "$expected_arch" ]] ||
    die "$platform requires architecture $expected_arch, found $(uname -m)"
}

configured_image() {
  case "$1" in
    debian-13-x86_64) printf '%s\n' "$DEBIAN_13_IMAGE" ;;
    ubuntu-24.04-x86_64) printf '%s\n' "$UBUNTU_2404_IMAGE" ;;
    ubuntu-26.04-x86_64) printf '%s\n' "$UBUNTU_2604_IMAGE" ;;
    amzn-2023-x86_64) printf '%s\n' "$AMZN_2023_IMAGE" ;;
    *) die "unsupported platform: $1" ;;
  esac
}

install_packages() {
  local platform=$1
  local role=$2

  case "$platform" in
    debian-* | ubuntu-*)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      if [[ $role == build ]]; then
        apt-get install -y --no-install-recommends \
          ca-certificates curl file g++ gcc git make patch python3 python3-pip \
          python3-venv tar tmux unzip wget xz-utils
      else
        apt-get install -y --no-install-recommends \
          ca-certificates git gzip python3 tar tmux xz-utils
      fi
      ;;
    amzn-2023-x86_64)
      if [[ $role == build ]]; then
        dnf install -y \
          ca-certificates cargo clang-devel file findutils gcc gcc-c++ git \
          gzip make openssh-clients patch python3.12 python3.12-pip \
          shadow-utils tar tmux unzip wget which xz
      else
        dnf install -y \
          ca-certificates findutils git gzip python3.12 shadow-utils tar tmux \
          which xz
      fi
      ;;
    *) die "unsupported platform: $platform" ;;
  esac
}

ensure_target_user() {
  local existing_user
  local existing_group

  if id "$TARGET_USER" >/dev/null 2>&1; then
    [[ $(id -u "$TARGET_USER") -eq $TARGET_UID ]] ||
      die "$TARGET_USER exists with UID $(id -u "$TARGET_USER"), expected $TARGET_UID"
    return
  fi

  existing_user=$(lookup_uid_owner "$TARGET_UID")
  if [[ -n $existing_user ]]; then
    existing_group=$(id -gn "$existing_user")
    usermod --login "$TARGET_USER" --home "$TARGET_HOME" --move-home \
      --shell /bin/bash "$existing_user"
    if [[ $existing_group != "$TARGET_USER" ]]; then
      groupmod --new-name "$TARGET_USER" "$existing_group"
    fi
    return
  fi

  if ! getent group "$TARGET_USER" >/dev/null; then
    groupadd --gid "$TARGET_UID" "$TARGET_USER"
  fi
  useradd --create-home --uid "$TARGET_UID" --gid "$TARGET_USER" \
    --home-dir "$TARGET_HOME" --shell /bin/bash "$TARGET_USER"
}

lookup_uid_owner() {
  local entry
  local status=0

  entry=$(getent passwd "$1") || status=$?
  case "$status" in
    0) printf '%s\n' "${entry%%:*}" ;;
    2) return 0 ;;
    *) return "$status" ;;
  esac
}

link_python() {
  local python_path

  if [[ -x /usr/bin/python3.12 ]]; then
    python_path=/usr/bin/python3.12
  else
    python_path=$(command -v python3)
  fi
  mkdir -p "$TARGET_HOME/bin"
  ln -sfn "$python_path" "$TARGET_HOME/bin/python3"
  ln -sfn "$python_path" "$TARGET_HOME/bin/python"
}

python_identity() {
  PYTHON_PATH=$(readlink -f -- "$(command -v python3)")
  PYTHON_VERSION=$(python3 -c \
    'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
  [[ $PYTHON_PATH == /* && -x $PYTHON_PATH ]] ||
    die "invalid Python interpreter path: $PYTHON_PATH"
  [[ $PYTHON_VERSION =~ ^[0-9]+[.][0-9]+$ ]] ||
    die "invalid Python major/minor version: $PYTHON_VERSION"
}

validate_runtime_python() {
  local expected_path=$1
  local expected_version=$2
  local runtime_path
  local runtime_version

  runtime_path=$(readlink -f -- "$TARGET_HOME/bin/python3")
  [[ -n $runtime_path && -x $runtime_path ]] ||
    die "Python interpreter is missing: $TARGET_HOME/bin/python3"
  runtime_version=$(
    "$TARGET_HOME/bin/python3" -c \
      'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")'
  )
  [[ $runtime_path == "$expected_path" ]] ||
    die "Python path is $runtime_path, artifact requires $expected_path"
  [[ $runtime_version == "$expected_version" ]] ||
    die "Python version is $runtime_version, artifact requires $expected_version"
}

validate_release_identity() {
  local source_dir=$1
  local commit
  local tag_commit

  [[ $SOURCE_COMMIT =~ ^[0-9a-f]{40}$ ]] ||
    die 'SOURCE_COMMIT must be a full lowercase commit SHA'
  [[ $RELEASE_TAG =~ ^nvim2-[0-9a-f]{7,40}$ ]] ||
    die "invalid release tag: $RELEASE_TAG"
  commit=$(git -c safe.directory="$source_dir" -C "$source_dir" rev-parse HEAD)
  [[ $commit == "$SOURCE_COMMIT" ]] ||
    die "source checkout is $commit, expected $SOURCE_COMMIT"
  tag_commit=${RELEASE_TAG#nvim2-}
  [[ $SOURCE_COMMIT == "$tag_commit"* ]] ||
    die 'release tag suffix does not match SOURCE_COMMIT'
  [[ -z $(git -c safe.directory="$source_dir" -C "$source_dir" \
    status --porcelain --untracked-files=normal) ]] ||
    die 'publishable release source must be clean'
}

download_github_asset() {
  local repository=$1
  local tag=$2
  local asset=$3
  local checksum=$4
  local destination=$5

  curl --connect-timeout 30 --max-time 600 \
    --retry 3 --retry-all-errors -fL \
    "https://github.com/$repository/releases/download/$tag/$asset" \
    -o "$destination"
  printf '%s  %s\n' "$checksum" "$destination" | sha256sum --check --strict
}

install_node() {
  local asset="node-v${NODE_VERSION}-linux-x64.tar.xz"
  local base="https://nodejs.org/download/release/v${NODE_VERSION}"
  local archive="$HOME/release-inputs/$asset"
  local checksum=${NODEJS_SHA256_BY_VERSION[$NODE_VERSION]:-}
  local install_dir="$HOME/bin/nodejs-${NODE_VERSION}"

  mkdir -p "$HOME/bin" "$HOME/release-inputs" "$install_dir"
  [[ $checksum =~ ^[0-9a-f]{64}$ ]] || die "missing Node.js checksum for $asset"
  curl --connect-timeout 30 --max-time 600 \
    --retry 3 --retry-all-errors -fL "$base/$asset" -o "$archive"
  printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --strict
  tar -xJf "$archive" -C "$install_dir" --strip-components=1
  for command_name in node npm npx corepack; do
    ln -sfn "nodejs-${NODE_VERSION}/bin/$command_name" "$HOME/bin/$command_name"
  done
  timeout 600s env NPM_CONFIG_AUDIT=false npm install --global "npm@$NPM_VERSION"
}

install_ripgrep() {
  local tag=$RG_VERSION
  local asset="ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz"
  local archive="$HOME/release-inputs/$asset"
  local stage

  stage=$(mktemp -d)
  download_github_asset BurntSushi/ripgrep "$tag" "$asset" "$RG_SHA256" "$archive"
  tar -xzf "$archive" -C "$stage"
  install -m 0755 "$stage/ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" \
    "$HOME/bin/rg-$RG_VERSION"
  ln -sfn "rg-$RG_VERSION" "$HOME/bin/rg"
  find "$stage" -depth -delete
}

install_neovim() {
  local asset=nvim-linux-x86_64.tar.gz
  local archive="$HOME/release-inputs/$asset"
  local install_dir="$HOME/bin/nvim-$NVIM_VERSION"

  mkdir -p "$install_dir"
  download_github_asset neovim/neovim "$NVIM_VERSION" "$asset" "$NVIM_SHA256" "$archive"
  tar -xzf "$archive" -C "$install_dir" --strip-components=1
  ln -sfn "nvim-$NVIM_VERSION/bin/nvim" "$HOME/bin/nvim"
}

install_nvim2_data() {
  local platform=$1
  local tree_sitter_version
  local tree_sitter_root
  local tree_sitter_binary

  [[ ! -e $HOME/.local/share/nvim2 ]] || die "$HOME/.local/share/nvim2 must not exist"
  if [[ $platform == amzn-2023-x86_64 ]]; then
    timeout 2400s env NPM_CONFIG_AUDIT=false NVIM_APPNAME=nvim2 \
      nvim --headless '+MasonToolsInstallSync' '+qa!'
    tree_sitter_version=$(
      NVIM_APPNAME=nvim2 nvim --headless \
        "+lua for _, tool in ipairs(require('custom.lsp').tools) do if tool[1] == 'tree-sitter-cli' then io.write(tool.version) end end" \
        '+qa!'
    )
    tree_sitter_version=${tree_sitter_version#v}
    [[ -n $tree_sitter_version ]] || die 'tree-sitter-cli version is empty'
    tree_sitter_root="$HOME/.local/opt/tree-sitter-cli-$tree_sitter_version"
    tree_sitter_binary=$(readlink -f "$HOME/.local/share/nvim2/mason/bin/tree-sitter")
    timeout 2400s cargo install tree-sitter-cli \
      --version "$tree_sitter_version" \
      --locked \
      --root "$tree_sitter_root"
    install -m 0755 "$tree_sitter_root/bin/tree-sitter" "$tree_sitter_binary"
  fi

  timeout 2400s env NPM_CONFIG_AUDIT=false NVIM_APPNAME=nvim2 \
    nvim --headless '+Nvim2ToolsInstallSync' '+qa!'
}

package_release() {
  local platform=$1
  local output_root=$2
  local repo=$3
  local commit
  local data_root="$HOME/.local/share/nvim2"
  local out="$output_root/$platform"
  local stage
  local nvim_archive=nvim-linux-x86_64.tar.gz
  local node_archive="node-v${NODE_VERSION}-linux-x64.tar.xz"
  local rg_archive="ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz"

  commit=$(git -C "$repo" rev-parse HEAD)
  [[ $commit == "$SOURCE_COMMIT" ]] || die "source commit changed: $commit"
  python_identity
  stage=$(mktemp -d)
  mkdir -p "$out" "$stage/nvim2/site/pack"
  cp -a "$data_root/site/pack/core" "$stage/nvim2/site/pack/"
  cp -a "$data_root/site/parser" "$stage/nvim2/site/"
  cp -a "$data_root/site/parser-info" "$stage/nvim2/site/"
  cp -aL "$data_root/site/queries" "$stage/nvim2/site/"
  cp -a "$data_root/mason" "$stage/nvim2/"
  tar -C "$stage/nvim2" -czf "$out/nvim2-data.tar.gz" .
  find "$stage" -depth -delete

  git -C "$repo" bundle create "$out/dotfiles.bundle" HEAD
  git -C "$repo" bundle verify "$out/dotfiles.bundle"
  cp "$repo/scripts/nvim2-release" "$out/nvim2-release"
  cp "$HOME/release-inputs/$nvim_archive" "$out/"
  cp "$HOME/release-inputs/$node_archive" "$out/"
  cp "$HOME/release-inputs/$rg_archive" "$out/"

  cat >"$out/release.env" <<EOF
RELEASE_ID=$RELEASE_TAG
RELEASE_TAG=$RELEASE_TAG
PLATFORM_ID=$platform
DOTFILES_COMMIT=$commit
NVIM_VERSION=$NVIM_VERSION
NVIM_ARCHIVE=$nvim_archive
NODE_VERSION=$NODE_VERSION
NODE_ARCHIVE=$node_archive
RG_VERSION=$RG_VERSION
RG_ARCHIVE=$rg_archive
BUILDER_IMAGE=$BUILDER_IMAGE
TARGET_USER=$TARGET_USER
TARGET_UID=$TARGET_UID
TARGET_HOME=$TARGET_HOME
PYTHON_PATH=$PYTHON_PATH
PYTHON_VERSION=$PYTHON_VERSION
EOF

  {
    cat /etc/os-release
    uname -a
    getconf GNU_LIBC_VERSION
    nvim --version
    node --version
    npm --version
    python3 --version
    printf 'python_path=%s\n' "$PYTHON_PATH"
    printf 'python_major_minor=%s\n' "$PYTHON_VERSION"
    rg --version | head -n 1
    tmux -V
    "$data_root/mason/bin/tree-sitter" --version
    printf 'tree_sitter_cli_sha256='
    sha256sum "$data_root/mason/packages/tree-sitter-cli/tree-sitter-linux-x64" | awk '{ print $1 }'
    git --version
    printf 'builder_image=%s\n' "$BUILDER_IMAGE"
    printf 'dotfiles_commit=%s\n' "$commit"
    sha256sum "$repo/nvim2/.config/nvim2/nvim-pack-lock.json"
  } >"$out/build-manifest.txt"

  if command -v rpm >/dev/null 2>&1; then
    rpm -qa --qf '%{NAME} %{VERSION}-%{RELEASE} %{ARCH}\n' | sort >"$out/os-packages.txt"
  else
    dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort >"$out/os-packages.txt"
  fi

  (
    cd "$out"
    sha256sum \
      dotfiles.bundle \
      nvim2-release \
      nvim2-data.tar.gz \
      "$nvim_archive" \
      "$node_archive" \
      "$rg_archive" \
      release.env \
      build-manifest.txt \
      os-packages.txt \
      >SHA256SUMS
    sha256sum --check --strict SHA256SUMS
  )
}

build_user() {
  local platform=$1
  local output_root=$2
  local repo="$TARGET_HOME/github.com/surbanski/dotfiles"
  local data_root="$HOME/.local/share/nvim2"

  load_release_config "$repo"
  export PATH="$HOME/bin:/usr/local/bin:/usr/bin:/bin"
  [[ $HOME == "$TARGET_HOME" ]] || die "HOME is $HOME, expected $TARGET_HOME"
  [[ $(git -C "$repo" rev-parse HEAD) == "$SOURCE_COMMIT" ]] || die 'checked-out source does not match release tag'

  install_node
  install_ripgrep
  install_neovim
  node --version
  npm --version
  rg --version
  nvim --version

  cd "$repo"
  ./bstow --dry-run -t "$HOME" stow nvim2
  ./bstow -t "$HOME" stow nvim2
  [[ ! -e $data_root ]] || die "$data_root existed before clean installation"
  install_nvim2_data "$platform"
  NVIM2_BENCHMARK_RUNS=3 bash "$HOME/.config/nvim2/tests/check.sh"

  if find -L "$data_root/mason/bin" -type l -print -quit | grep -q .; then
    die 'Mason contains broken executable links'
  fi
  package_release "$platform" "$output_root" "$repo"
}

build_release() {
  local platform=$1
  local source_dir=$2
  local output_root=$3
  local expected_image
  local repo
  local target_group

  require_root build
  [[ -d $source_dir/.git ]] || die "source is not a Git checkout: $source_dir"
  load_release_config "$source_dir"
  require_value SOURCE_COMMIT
  require_value RELEASE_TAG
  configure_target "$platform"
  expected_image=$(configured_image "$platform")
  BUILDER_IMAGE=${BUILDER_IMAGE:-$expected_image}
  [[ $BUILDER_IMAGE == "$expected_image" ]] ||
    die "builder image does not match pinned image for $platform"
  validate_platform "$platform"
  install_packages "$platform" build
  validate_release_identity "$source_dir"
  ensure_target_user
  link_python

  repo="$TARGET_HOME/github.com/surbanski/dotfiles"
  target_group=$(id -gn "$TARGET_USER")
  mkdir -p "$(dirname "$repo")" "$repo" "$output_root"
  cp -a "$source_dir/." "$repo/"
  chown -R "$TARGET_USER:$target_group" "$TARGET_HOME" "$output_root"

  runuser -u "$TARGET_USER" -- env \
    HOME="$TARGET_HOME" \
    USER="$TARGET_USER" \
    LOGNAME="$TARGET_USER" \
    PATH="$TARGET_HOME/bin:/usr/local/bin:/usr/bin:/bin" \
    NVIM_VERSION="$NVIM_VERSION" \
    NODE_VERSION="$NODE_VERSION" \
    NPM_VERSION="$NPM_VERSION" \
    RG_VERSION="$RG_VERSION" \
    TARGET_USER="$TARGET_USER" \
    TARGET_UID="$TARGET_UID" \
    TARGET_HOME="$TARGET_HOME" \
    SOURCE_COMMIT="$SOURCE_COMMIT" \
    RELEASE_TAG="$RELEASE_TAG" \
    BUILDER_IMAGE="$BUILDER_IMAGE" \
    bash "$repo/scripts/nvim2-release" build-user "$platform" "$output_root"
}

prepare_runtime() {
  local platform=$1

  require_root prepare-runtime
  require_value TARGET_USER
  require_value TARGET_UID
  require_value TARGET_HOME
  validate_platform "$platform"
  install_packages "$platform" runtime
  ensure_target_user
  link_python
  chown -R "$TARGET_USER:$(id -gn "$TARGET_USER")" "$TARGET_HOME"
}

verify_release() {
  local platform=$1
  local artifact_dir=$2
  local repo
  local release_dir
  local nvim_dir
  local node_dir
  local rg_dir
  local rg_stage
  local target_group
  local NVIM_ARCHIVE
  local NODE_ARCHIVE
  local RG_ARCHIVE
  local PYTHON_PATH
  local PYTHON_VERSION

  require_root verify
  [[ -f $artifact_dir/release.env ]] || die "missing $artifact_dir/release.env"
  (cd "$artifact_dir" && sha256sum --check --strict SHA256SUMS)
  # release.env is generated and checksum-verified as part of the artifact.
  # shellcheck disable=SC1091
  source "$artifact_dir/release.env"
  for name in RELEASE_ID PLATFORM_ID DOTFILES_COMMIT NVIM_VERSION NVIM_ARCHIVE \
    NODE_VERSION NODE_ARCHIVE RG_VERSION RG_ARCHIVE TARGET_USER TARGET_UID \
    TARGET_HOME PYTHON_PATH PYTHON_VERSION; do
    require_value "$name"
  done
  [[ $PLATFORM_ID == "$platform" ]] || die "artifact is for $PLATFORM_ID, not $platform"
  validate_platform "$platform"
  [[ $TARGET_HOME == "/home/$TARGET_USER" ]] || die 'target home and user do not match'
  [[ $(id -u "$TARGET_USER") -eq $TARGET_UID ]] || die 'target UID does not match artifact'
  validate_runtime_python "$PYTHON_PATH" "$PYTHON_VERSION"
  timeout 5s getent hosts github.com >/dev/null 2>&1 && die 'offline validation container has external DNS'

  target_group=$(id -gn "$TARGET_USER")
  nvim_dir="$TARGET_HOME/bin/nvim-$NVIM_VERSION"
  node_dir="$TARGET_HOME/bin/nodejs-$NODE_VERSION"
  rg_dir="$TARGET_HOME/bin/rg-$RG_VERSION"
  mkdir -p "$TARGET_HOME/bin" "$nvim_dir" "$node_dir"
  tar -xzf "$artifact_dir/$NVIM_ARCHIVE" -C "$nvim_dir" --strip-components=1
  tar -xJf "$artifact_dir/$NODE_ARCHIVE" -C "$node_dir" --strip-components=1
  rg_stage=$(mktemp -d)
  tar -xzf "$artifact_dir/$RG_ARCHIVE" -C "$rg_stage"
  install -m 0755 "$rg_stage/ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" "$rg_dir"
  find "$rg_stage" -depth -delete

  repo="$TARGET_HOME/github.com/surbanski/dotfiles"
  mkdir -p "$(dirname "$repo")"
  git clone "$artifact_dir/dotfiles.bundle" "$repo"
  git -C "$repo" checkout --detach "$DOTFILES_COMMIT"
  (
    cd "$repo"
    ./bstow --dry-run -t "$TARGET_HOME" stow nvim2
    ./bstow -t "$TARGET_HOME" stow nvim2
  )

  release_dir="$TARGET_HOME/.local/share/nvim2-releases/$RELEASE_ID"
  mkdir -p "$release_dir"
  tar -C "$release_dir" -xzf "$artifact_dir/nvim2-data.tar.gz"
  ln -s "$release_dir" "$TARGET_HOME/.local/share/nvim2"
  ln -s "nvim-$NVIM_VERSION/bin/nvim" "$TARGET_HOME/bin/nvim"
  for command_name in node npm npx corepack; do
    ln -s "nodejs-$NODE_VERSION/bin/$command_name" "$TARGET_HOME/bin/$command_name"
  done
  ln -s "rg-$RG_VERSION" "$TARGET_HOME/bin/rg"
  chown -R "$TARGET_USER:$target_group" "$TARGET_HOME"

  (
    cd "$TARGET_HOME"
    runuser -u "$TARGET_USER" -- env \
      HOME="$TARGET_HOME" \
      USER="$TARGET_USER" \
      LOGNAME="$TARGET_USER" \
      PATH="$TARGET_HOME/bin:/usr/local/bin:/usr/bin:/bin" \
      NVIM_APPNAME=nvim2 \
      NVIM2_BENCHMARK_RUNS=3 \
      timeout 300s bash "$TARGET_HOME/.config/nvim2/tests/check.sh"
  )
}

remove_release_path() {
  local path=$1

  if [[ -d $path && ! -L $path ]]; then
    find "$path" -depth -delete
  elif [[ -e $path || -L $path ]]; then
    unlink "$path"
  fi
}

release_link_is_managed() {
  local kind=$1
  local command_name=$2
  local target=$3

  case "$kind" in
    nvim)
      [[ $target == "$HOME/bin/nvim-"*/bin/nvim ||
        $target == "$HOME/.local/opt/nvim-"*/bin/nvim ]]
      ;;
    node)
      case "$command_name" in
        node) [[ $target == "$HOME/bin/nodejs-"*/bin/node ]] ;;
        npm) [[ $target == "$HOME/bin/nodejs-"*/bin/npm || $target == "$HOME/bin/nodejs-"*/lib/node_modules/npm/bin/npm-cli.js ]] ;;
        npx) [[ $target == "$HOME/bin/nodejs-"*/bin/npx || $target == "$HOME/bin/nodejs-"*/lib/node_modules/npm/bin/npx-cli.js ]] ;;
        corepack) [[ $target == "$HOME/bin/nodejs-"*/bin/corepack || $target == "$HOME/bin/nodejs-"*/lib/node_modules/corepack/dist/corepack.js ]] ;;
        *) return 1 ;;
      esac
      ;;
    rg)
      [[ $target == "$HOME/bin/rg-"* ||
        $target == "$HOME/.local/opt/ripgrep-"*/rg ]]
      ;;
    data)
      [[ $target == "$HOME/.local/share/nvim2-releases/"* ]]
      ;;
    *) return 1 ;;
  esac
}

release_link_points_to() {
  local link=$1
  local target=$2
  local link_resolved
  local target_resolved

  [[ -L $link ]] || return 1
  link_resolved=$(readlink -f -- "$link") || return 1
  target_resolved=$(readlink -f -- "$target") || return 1
  [[ $link_resolved == "$target_resolved" ]]
}

capture_release_link() {
  local prefix=$1
  local link=$2
  local kind=$3
  local command_name=$4
  local raw=
  local target=
  local value_kind=absent

  if [[ -L $link ]]; then
    raw=$(readlink -- "$link")
    target=$(readlink -f -- "$link")
    [[ -n $target && -e $target ]] || die "managed link is broken: $link"
    release_link_is_managed "$kind" "$command_name" "$target" ||
      die "refusing unmanaged link: $link -> $raw"
    value_kind=symlink
  elif [[ -e $link ]]; then
    die "refusing unmanaged path: $link"
  fi

  printf -v "${prefix}_KIND" '%s' "$value_kind"
  printf -v "${prefix}_RAW" '%s' "$raw"
  printf -v "${prefix}_TARGET" '%s' "$target"
}

capture_release_data() {
  local link=$HOME/.local/share/nvim2
  local import_path=$1

  PREVIOUS_DATA_RAW=
  PREVIOUS_DATA_TARGET=
  if [[ -L $link ]]; then
    PREVIOUS_DATA_RAW=$(readlink -- "$link")
    PREVIOUS_DATA_TARGET=$(readlink -f -- "$link")
    [[ -n $PREVIOUS_DATA_TARGET && -d $PREVIOUS_DATA_TARGET ]] ||
      die "Nvim2 data link is broken: $link"
    release_link_is_managed data nvim2 "$PREVIOUS_DATA_TARGET" ||
      die "refusing unmanaged data link: $link -> $PREVIOUS_DATA_RAW"
    PREVIOUS_DATA_KIND=symlink
  elif [[ -d $link ]]; then
    [[ ! -e $import_path && ! -L $import_path ]] ||
      die "retained data destination already exists: $import_path"
    PREVIOUS_DATA_KIND=directory
    PREVIOUS_DATA_TARGET=$import_path
  elif [[ -e $link ]]; then
    die "refusing unmanaged data path: $link"
  else
    PREVIOUS_DATA_KIND=absent
  fi
}

capture_release_repo() {
  local init=$HOME/.config/nvim2/init.lua
  local target

  PREVIOUS_REPO=ABSENT
  if [[ -L $init ]]; then
    target=$(readlink -f -- "$init")
    case "$target" in
      */nvim2/.config/nvim2/init.lua)
        PREVIOUS_REPO=${target%/nvim2/.config/nvim2/init.lua}
        [[ -x $PREVIOUS_REPO/bstow ]] ||
          die "previous Nvim2 repository has no bstow: $PREVIOUS_REPO"
        ;;
      *) die "unknown Nvim2 configuration source: $target" ;;
    esac
  elif [[ -e $init ]]; then
    die "refusing unmanaged Nvim2 configuration: $init"
  fi
}

release_tree_matches() {
  diff --recursive --brief --no-dereference "$1" "$2" >/dev/null &&
    diff --brief \
      <(cd "$1" && find . -printf '%P\t%y\t%m\t%l\n' | LC_ALL=C sort) \
      <(cd "$2" && find . -printf '%P\t%y\t%m\t%l\n' | LC_ALL=C sort) \
      >/dev/null
}

promote_release_tree() {
  local stage=$1
  local destination=$2

  if [[ -e $destination || -L $destination ]]; then
    [[ -d $destination && ! -L $destination ]] ||
      die "release destination is not a directory: $destination"
    release_tree_matches "$stage" "$destination" ||
      die "existing release destination differs: $destination"
    remove_release_path "$stage"
    return
  fi
  mv "$stage" "$destination"
  INSTALL_CREATED_PATHS+=("$destination")
}

promote_release_data() {
  local stage=$1
  local destination=$2
  local artifact_sha=$3
  local marker=.nvim2-release-artifact.sha256

  if [[ -e $destination || -L $destination ]]; then
    [[ -d $destination && ! -L $destination ]] ||
      die "release destination is not a directory: $destination"
    [[ -f $destination/$marker && ! -L $destination/$marker &&
      $(<"$destination/$marker") == "$artifact_sha" ]] ||
      die "existing release destination differs: $destination"
    remove_release_path "$stage"
    return
  fi
  printf '%s\n' "$artifact_sha" >"$stage/$marker"
  chmod 0444 "$stage/$marker"
  mv "$stage" "$destination"
  INSTALL_CREATED_PATHS+=("$destination")
}

promote_release_file() {
  local stage=$1
  local destination=$2

  if [[ -e $destination || -L $destination ]]; then
    [[ -f $destination && ! -L $destination ]] ||
      die "release destination is not a file: $destination"
    cmp -s "$stage" "$destination" ||
      die "existing release destination differs: $destination"
    [[ -x $destination ]] || die "existing release executable is not executable: $destination"
    unlink "$stage"
    return
  fi
  mv "$stage" "$destination"
  INSTALL_CREATED_PATHS+=("$destination")
}

promote_release_repo() {
  local stage=$1
  local destination=$2
  local commit=$3

  if [[ -e $destination || -L $destination ]]; then
    [[ -d $destination && ! -L $destination ]] ||
      die "release repository destination is not a directory: $destination"
    [[ $(git -C "$destination" rev-parse HEAD) == "$commit" ]] ||
      die "existing release repository has a different commit: $destination"
    [[ -z $(git -C "$destination" status --porcelain --untracked-files=normal) ]] ||
      die "existing release repository is dirty: $destination"
    remove_release_path "$stage"
    return
  fi
  mv "$stage" "$destination"
  INSTALL_CREATED_PATHS+=("$destination")
}

write_release_assignment() {
  printf '%s=%q\n' "$1" "$2" >>"$3"
}

switch_release_link() {
  local link=$1
  local target=$2
  local temporary=$3
  local relative

  relative=$(realpath --relative-to="$(dirname "$link")" "$target")
  [[ ! -e $temporary && ! -L $temporary ]] ||
    die "temporary activation link already exists: $temporary"
  ln -s "$relative" "$temporary"
  mv -Tf "$temporary" "$link"
}

release_path_is_previous() {
  local link=$1
  local kind=$2
  local raw=$3
  local target=$4

  case "$kind" in
    absent) [[ ! -e $link && ! -L $link ]] ;;
    symlink)
      [[ -L $link && $(readlink -- "$link") == "$raw" &&
        $(readlink -f -- "$link") == "$target" ]]
      ;;
    directory) [[ -d $link && ! -L $link ]] ;;
    *) return 1 ;;
  esac
}

restore_release_path() {
  local link=$1
  local current_target=$2
  local previous_kind=$3
  local previous_raw=$4
  local previous_target=$5
  local partial=$6
  local temporary=$7
  local actual_target=
  local current_resolved

  if release_path_is_previous "$link" "$previous_kind" "$previous_raw" "$previous_target"; then
    if [[ $previous_kind == symlink ]]; then
      current_resolved=$(readlink -f -- "$current_target" 2>/dev/null || true)
      [[ -n $current_resolved && $previous_target == "$current_resolved" ]] && return 0
    fi
    [[ $partial == 1 ]] && return 0
    die "release path is already rolled back: $link"
  fi
  current_resolved=$(readlink -f -- "$current_target")
  [[ -n $current_resolved && -e $current_resolved ]] ||
    die "current release target is missing: $current_target"
  [[ -L $link ]] || die "current release path is not a link: $link"
  actual_target=$(readlink -f -- "$link")
  [[ $actual_target == "$current_resolved" ]] ||
    die "release path changed after activation: $link"

  case "$previous_kind" in
    absent)
      unlink "$link"
      ;;
    symlink)
      [[ -e $previous_target ]] || die "previous release target is missing: $previous_target"
      ln -s "$previous_raw" "$temporary"
      mv -Tf "$temporary" "$link"
      ;;
    directory)
      [[ -d $previous_target && ! -L $previous_target ]] ||
        die "retained data directory is missing: $previous_target"
      unlink "$link"
      mv "$previous_target" "$link"
      ;;
    *) die "invalid rollback path kind: $previous_kind" ;;
  esac
}

release_repo_is_active() {
  local repo=$1
  local init=$HOME/.config/nvim2/init.lua
  local target=

  [[ $repo != ABSENT && -L $init ]] || return 1
  target=$(readlink -f -- "$init")
  [[ $target == "$repo/nvim2/.config/nvim2/init.lua" ]]
}

restore_release_repo() {
  local current_repo=$1
  local previous_repo=$2
  local partial=$3

  if release_repo_is_active "$previous_repo"; then
    [[ $partial == 1 ]] && return 0
    die 'Nvim2 configuration is already rolled back'
  fi
  if [[ $previous_repo == ABSENT && ! -e $HOME/.config/nvim2/init.lua &&
    ! -L $HOME/.config/nvim2/init.lua ]]; then
    [[ $partial == 1 ]] && return 0
    die 'Nvim2 configuration is already absent'
  fi
  release_repo_is_active "$current_repo" ||
    die 'Nvim2 configuration changed after activation'
  (
    cd "$current_repo"
    ./bstow -t "$HOME" unstow nvim2
  )
  if [[ $previous_repo != ABSENT ]]; then
    (
      cd "$previous_repo"
      ./bstow --force -t "$HOME" stow nvim2
    )
  fi
}

rollback_release_file() {
  local rollback_file=$1
  local partial=${2:-0}
  local CURRENT_REPO PREVIOUS_REPO

  [[ -f $rollback_file ]] || die "missing rollback record: $rollback_file"
  # The rollback record is generated locally with shell-escaped values and mode 0600.
  # shellcheck disable=SC1090
  source "$rollback_file"
  restore_release_repo "$CURRENT_REPO" "$PREVIOUS_REPO" "$partial"
  restore_release_path "$HOME/.local/share/nvim2" "$CURRENT_DATA" \
    "$PREVIOUS_DATA_KIND" "$PREVIOUS_DATA_RAW" "$PREVIOUS_DATA_TARGET" \
    "$partial" "$HOME/.local/share/.nvim2.rollback.$$"
  restore_release_path "$HOME/bin/nvim" "$CURRENT_NVIM" \
    "$PREVIOUS_NVIM_KIND" "$PREVIOUS_NVIM_RAW" "$PREVIOUS_NVIM_TARGET" \
    "$partial" "$HOME/bin/.nvim.rollback.$$"
  restore_release_path "$HOME/bin/node" "$CURRENT_NODE" \
    "$PREVIOUS_NODE_KIND" "$PREVIOUS_NODE_RAW" "$PREVIOUS_NODE_TARGET" \
    "$partial" "$HOME/bin/.node.rollback.$$"
  restore_release_path "$HOME/bin/npm" "$CURRENT_NPM" \
    "$PREVIOUS_NPM_KIND" "$PREVIOUS_NPM_RAW" "$PREVIOUS_NPM_TARGET" \
    "$partial" "$HOME/bin/.npm.rollback.$$"
  restore_release_path "$HOME/bin/npx" "$CURRENT_NPX" \
    "$PREVIOUS_NPX_KIND" "$PREVIOUS_NPX_RAW" "$PREVIOUS_NPX_TARGET" \
    "$partial" "$HOME/bin/.npx.rollback.$$"
  restore_release_path "$HOME/bin/corepack" "$CURRENT_COREPACK" \
    "$PREVIOUS_COREPACK_KIND" "$PREVIOUS_COREPACK_RAW" "$PREVIOUS_COREPACK_TARGET" \
    "$partial" "$HOME/bin/.corepack.rollback.$$"
  restore_release_path "$HOME/bin/rg" "$CURRENT_RG" \
    "$PREVIOUS_RG_KIND" "$PREVIOUS_RG_RAW" "$PREVIOUS_RG_TARGET" \
    "$partial" "$HOME/bin/.rg.rollback.$$"
}

rollback_release() {
  local rollback_file=$HOME/.local/state/nvim2-release-rollback.env

  rollback_release_file "$rollback_file"
  unlink "$rollback_file"
  hash -r
  if [[ -x $HOME/bin/nvim ]]; then
    NVIM_APPNAME=nvim2 "$HOME/bin/nvim" --headless '+qa'
  fi
  printf 'nvim2-release: rollback completed\n'
}

install_release_cleanup() {
  local path
  local index

  for path in "${INSTALL_STAGE_PATHS[@]:-}"; do
    [[ -n $path ]] && remove_release_path "$path"
  done
  if ((INSTALL_COMMITTED == 0)); then
    for ((index = ${#INSTALL_CREATED_PATHS[@]} - 1; index >= 0; index--)); do
      remove_release_path "${INSTALL_CREATED_PATHS[index]}"
    done
  fi
}

install_release() {
  local artifact_dir=$1
  local rollback_file=$HOME/.local/state/nvim2-release-rollback.env
  local rollback_candidate
  local previous_rollback=
  local nvim_dir
  local node_dir
  local rg_path
  local release_dir
  local repo
  local nvim_stage
  local node_stage
  local rg_stage_dir
  local rg_stage
  local data_stage
  local repo_stage
  local import_path
  local data_archive_sha
  local activation_status=0
  local active_release=0
  local name
  local target

  artifact_dir=$(CDPATH='' cd -- "$artifact_dir" && pwd)
  [[ -f $artifact_dir/release.env ]] || die "missing $artifact_dir/release.env"
  (cd "$artifact_dir" && sha256sum --check --strict SHA256SUMS)
  # release.env is generated and checksum-verified as part of the artifact.
  # shellcheck disable=SC1090,SC1091
  source "$artifact_dir/release.env"
  for name in RELEASE_ID PLATFORM_ID DOTFILES_COMMIT NVIM_VERSION NVIM_ARCHIVE \
    NODE_VERSION NODE_ARCHIVE RG_VERSION RG_ARCHIVE TARGET_USER TARGET_UID \
    TARGET_HOME PYTHON_PATH PYTHON_VERSION; do
    require_value "$name"
  done
  [[ $RELEASE_ID =~ ^[A-Za-z0-9._+-]+$ ]] || die "invalid release ID: $RELEASE_ID"
  [[ $DOTFILES_COMMIT =~ ^[0-9a-f]{40}$ ]] || die 'invalid dotfiles commit'
  for name in NVIM_VERSION NODE_VERSION RG_VERSION; do
    [[ ${!name} =~ ^[A-Za-z0-9._+-]+$ ]] || die "invalid $name: ${!name}"
  done
  [[ $HOME == "$TARGET_HOME" ]] || die "HOME is $HOME, artifact requires $TARGET_HOME"
  [[ $(id -u) -eq $TARGET_UID ]] || die "UID is $(id -u), artifact requires $TARGET_UID"
  [[ $(id -un) == "$TARGET_USER" ]] || die "user is $(id -un), artifact requires $TARGET_USER"
  validate_platform "$PLATFORM_ID"
  validate_runtime_python "$PYTHON_PATH" "$PYTHON_VERSION"
  data_archive_sha=$(awk '$2 == "nvim2-data.tar.gz" { print $1 }' \
    "$artifact_dir/SHA256SUMS")
  [[ $data_archive_sha =~ ^[0-9a-f]{64}$ ]] ||
    die 'invalid nvim2-data.tar.gz checksum entry'

  nvim_dir=$HOME/bin/nvim-$NVIM_VERSION
  node_dir=$HOME/bin/nodejs-$NODE_VERSION
  rg_path=$HOME/bin/rg-$RG_VERSION
  release_dir=$HOME/.local/share/nvim2-releases/$RELEASE_ID
  repo=$HOME/github.com/surbanski/dotfiles-$DOTFILES_COMMIT
  import_path=$HOME/.local/share/nvim2-releases/imported-before-$RELEASE_ID

  mkdir -p "$HOME/bin" "$HOME/.local/share/nvim2-releases" \
    "$HOME/.local/state" "$(dirname "$repo")"
  capture_release_link PREVIOUS_NVIM "$HOME/bin/nvim" nvim nvim
  capture_release_link PREVIOUS_NODE "$HOME/bin/node" node node
  capture_release_link PREVIOUS_NPM "$HOME/bin/npm" node npm
  capture_release_link PREVIOUS_NPX "$HOME/bin/npx" node npx
  capture_release_link PREVIOUS_COREPACK "$HOME/bin/corepack" node corepack
  capture_release_link PREVIOUS_RG "$HOME/bin/rg" rg rg
  capture_release_data "$import_path"
  capture_release_repo

  INSTALL_STAGE_PATHS=()
  INSTALL_CREATED_PATHS=()
  INSTALL_COMMITTED=0
  trap install_release_cleanup EXIT
  nvim_stage=$(mktemp -d "$HOME/bin/.nvim-$NVIM_VERSION.stage.XXXXXX")
  node_stage=$(mktemp -d "$HOME/bin/.nodejs-$NODE_VERSION.stage.XXXXXX")
  rg_stage_dir=$(mktemp -d "$HOME/bin/.rg-$RG_VERSION.stage.XXXXXX")
  data_stage=$(mktemp -d "$HOME/.local/share/nvim2-releases/.$RELEASE_ID.stage.XXXXXX")
  repo_stage=$(mktemp -d "$(dirname "$repo")/.dotfiles-$DOTFILES_COMMIT.stage.XXXXXX")
  INSTALL_STAGE_PATHS+=("$nvim_stage" "$node_stage" "$rg_stage_dir" "$data_stage" "$repo_stage")

  tar -xzf "$artifact_dir/$NVIM_ARCHIVE" -C "$nvim_stage" --strip-components=1 ||
    die "failed to extract $NVIM_ARCHIVE"
  tar -xJf "$artifact_dir/$NODE_ARCHIVE" -C "$node_stage" --strip-components=1 ||
    die "failed to extract $NODE_ARCHIVE"
  tar -xzf "$artifact_dir/$RG_ARCHIVE" -C "$rg_stage_dir" ||
    die "failed to extract $RG_ARCHIVE"
  rg_stage=$rg_stage_dir/ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg
  [[ -x $rg_stage ]] || die "ripgrep executable is missing from $RG_ARCHIVE"
  tar -xzf "$artifact_dir/nvim2-data.tar.gz" -C "$data_stage" ||
    die 'failed to extract nvim2-data.tar.gz'
  git clone --quiet "$artifact_dir/dotfiles.bundle" "$repo_stage"
  git -C "$repo_stage" checkout --quiet --detach "$DOTFILES_COMMIT"
  [[ -x $repo_stage/bstow ]] || die 'release repository has no executable bstow'
  "$nvim_stage/bin/nvim" --version >/dev/null
  "$node_stage/bin/node" --version >/dev/null
  "$rg_stage" --version >/dev/null
  [[ -x $data_stage/mason/bin/lua-language-server ]] ||
    die 'release data is missing lua-language-server'
  (
    cd "$repo_stage"
    ./bstow --dry-run --force -t "$HOME" stow nvim2
  )

  promote_release_tree "$nvim_stage" "$nvim_dir"
  promote_release_tree "$node_stage" "$node_dir"
  promote_release_file "$rg_stage" "$rg_path"
  remove_release_path "$rg_stage_dir"
  promote_release_repo "$repo_stage" "$repo" "$DOTFILES_COMMIT"
  promote_release_data "$data_stage" "$release_dir" "$data_archive_sha"
  if release_link_points_to "$HOME/bin/nvim" "$nvim_dir/bin/nvim" &&
    release_link_points_to "$HOME/bin/node" "$node_dir/bin/node" &&
    release_link_points_to "$HOME/bin/npm" "$node_dir/bin/npm" &&
    release_link_points_to "$HOME/bin/npx" "$node_dir/bin/npx" &&
    release_link_points_to "$HOME/bin/corepack" "$node_dir/bin/corepack" &&
    release_link_points_to "$HOME/bin/rg" "$rg_path" &&
    release_link_points_to "$HOME/.local/share/nvim2" "$release_dir" &&
    release_repo_is_active "$repo"; then
    active_release=1
  fi
  "$nvim_dir/bin/nvim" --version >/dev/null
  "$node_dir/bin/node" --version >/dev/null
  "$rg_path" --version >/dev/null
  [[ -x $release_dir/mason/bin/lua-language-server ]] ||
    die 'installed release data is missing lua-language-server'

  if ((active_release)); then
    hash -r
    NVIM_APPNAME=nvim2 "$HOME/bin/nvim" --headless '+qa'
    NVIM2_CHECK_TOOLS=1 bash "$HOME/.config/nvim2/tests/check.sh"
    INSTALL_COMMITTED=1
    trap - EXIT
    install_release_cleanup
    printf 'nvim2-release: release %s is already active and verified\n' "$RELEASE_ID"
    return
  fi

  (
    cd "$repo"
    ./bstow --dry-run --force -t "$HOME" stow nvim2
  )
  rollback_candidate=$(mktemp "$HOME/.local/state/.nvim2-release-rollback.XXXXXX")
  INSTALL_STAGE_PATHS+=("$rollback_candidate")
  chmod 0600 "$rollback_candidate"
  for name in PREVIOUS_DATA_KIND PREVIOUS_DATA_RAW PREVIOUS_DATA_TARGET \
    PREVIOUS_NVIM_KIND PREVIOUS_NVIM_RAW PREVIOUS_NVIM_TARGET \
    PREVIOUS_NODE_KIND PREVIOUS_NODE_RAW PREVIOUS_NODE_TARGET \
    PREVIOUS_NPM_KIND PREVIOUS_NPM_RAW PREVIOUS_NPM_TARGET \
    PREVIOUS_NPX_KIND PREVIOUS_NPX_RAW PREVIOUS_NPX_TARGET \
    PREVIOUS_COREPACK_KIND PREVIOUS_COREPACK_RAW PREVIOUS_COREPACK_TARGET \
    PREVIOUS_RG_KIND PREVIOUS_RG_RAW PREVIOUS_RG_TARGET PREVIOUS_REPO; do
    write_release_assignment "$name" "${!name}" "$rollback_candidate"
  done
  write_release_assignment CURRENT_DATA "$release_dir" "$rollback_candidate"
  write_release_assignment CURRENT_NVIM "$nvim_dir/bin/nvim" "$rollback_candidate"
  write_release_assignment CURRENT_NODE "$node_dir/bin/node" "$rollback_candidate"
  write_release_assignment CURRENT_NPM "$node_dir/bin/npm" "$rollback_candidate"
  write_release_assignment CURRENT_NPX "$node_dir/bin/npx" "$rollback_candidate"
  write_release_assignment CURRENT_COREPACK "$node_dir/bin/corepack" "$rollback_candidate"
  write_release_assignment CURRENT_RG "$rg_path" "$rollback_candidate"
  write_release_assignment CURRENT_REPO "$repo" "$rollback_candidate"
  if [[ -e $rollback_file || -L $rollback_file ]]; then
    previous_rollback=$(mktemp "$HOME/.local/state/.nvim2-release-previous.XXXXXX")
    INSTALL_STAGE_PATHS+=("$previous_rollback")
    cp -a "$rollback_file" "$previous_rollback"
  fi
  mv -f "$rollback_candidate" "$rollback_file"

  if [[ $PREVIOUS_DATA_KIND == directory ]]; then
    mv "$HOME/.local/share/nvim2" "$PREVIOUS_DATA_TARGET" || activation_status=$?
  fi
  if ((activation_status == 0)); then
    switch_release_link "$HOME/.local/share/nvim2" "$release_dir" \
      "$HOME/.local/share/.nvim2.release.$$" || activation_status=$?
  fi
  for name in nvim node npm npx corepack rg; do
    if ((activation_status == 0)); then
      case "$name" in
        nvim) target=$nvim_dir/bin/nvim ;;
        node | npm | npx | corepack) target=$node_dir/bin/$name ;;
        rg) target=$rg_path ;;
      esac
      switch_release_link "$HOME/bin/$name" "$target" \
        "$HOME/bin/.$name.release.$$" || activation_status=$?
    fi
  done
  if ((activation_status == 0)); then
    (
      cd "$repo"
      ./bstow --force -t "$HOME" stow nvim2
    ) || activation_status=$?
  fi
  if ((activation_status == 0)); then
    hash -r
    NVIM_APPNAME=nvim2 "$HOME/bin/nvim" --headless '+qa' || activation_status=$?
  fi
  if ((activation_status == 0)); then
    NVIM2_CHECK_TOOLS=1 bash "$HOME/.config/nvim2/tests/check.sh" || activation_status=$?
  fi
  if ((activation_status != 0)); then
    rollback_release_file "$rollback_file" 1 ||
      die "activation failed with status $activation_status and automatic rollback failed"
    if [[ -n $previous_rollback ]]; then
      mv -f "$previous_rollback" "$rollback_file"
    else
      unlink "$rollback_file"
    fi
    die "activation failed with status $activation_status; previous release restored"
  fi

  INSTALL_COMMITTED=1
  trap - EXIT
  install_release_cleanup
  printf 'nvim2-release: installed release %s\n' "$RELEASE_ID"
}

main() {
  case ${1:-} in
    build)
      [[ $# -eq 4 ]] || usage
      build_release "$2" "$3" "$4"
      ;;
    install)
      [[ $# -eq 2 ]] || usage
      install_release "$2"
      ;;
    build-user)
      [[ $# -eq 3 ]] || usage
      build_user "$2" "$3"
      ;;
    prepare-runtime)
      [[ $# -eq 2 ]] || usage
      prepare_runtime "$2"
      ;;
    rollback)
      [[ $# -eq 1 ]] || usage
      rollback_release
      ;;
    verify)
      [[ $# -eq 3 ]] || usage
      verify_release "$2" "$3"
      ;;
    *) usage ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
