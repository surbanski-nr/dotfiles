#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'day: %s\n' "$*" >&2
  exit 1
}

cleanup_file=
cleanup() {
  local status=$?

  trap - EXIT
  if [[ -n $cleanup_file && -e $cleanup_file ]]; then
    rm -f "$cleanup_file" || true
  fi
  exit "$status"
}
trap cleanup EXIT

[[ $# -eq 0 ]] || die 'usage: day'
command -v date >/dev/null 2>&1 || die 'required command is missing: date'
command -v nvim >/dev/null 2>&1 || die 'required command is missing: nvim'

notes_root=${NOTES:-${SECOND_BRAIN:-}}
[[ -n $notes_root ]] || die 'set NOTES or SECOND_BRAIN to the notes root'
[[ -d $notes_root ]] || die "notes root is not a directory: $notes_root"

today=$(date '+%Y-%m-%d') || die 'failed to read the current date'
yesterday=$(date -d "$today - 1 day" '+%Y-%m-%d') ||
  die 'GNU date is required to compute yesterday'
tomorrow=$(date -d "$today + 1 day" '+%Y-%m-%d') ||
  die 'GNU date is required to compute tomorrow'

notes_dir=$notes_root/periodic-notes/daily-notes
mkdir -p "$notes_dir"
file=$notes_dir/$today.md

if [[ -e $file || -L $file ]]; then
  [[ -f $file && ! -L $file ]] ||
    die "daily note target is not a regular file: $file"
else
  cleanup_file=$(mktemp "$notes_dir/.day.XXXXXX")
  cat >"$cleanup_file" <<EOF_NOTE
# $today

[[$yesterday]] - [[$tomorrow]]

## Intention

What do I want to achieve today and tomorrow?

## Tracking

- [ ] Something to track

## Log
EOF_NOTE
  ln "$cleanup_file" "$file" ||
    die "daily note appeared while it was being created: $file"
  rm "$cleanup_file"
  cleanup_file=
  printf 'Created daily note: %s\n' "$file"
fi

NVIM_APPNAME=nvim2 nvim '+normal Gzzo' "$file"
