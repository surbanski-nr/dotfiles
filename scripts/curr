#!/usr/bin/env bash

set -uo pipefail

die() {
  printf 'curr: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 0 ]] || die 'usage: curr'
command -v kubectl >/dev/null 2>&1 || die 'required command is missing: kubectl'

if ! context=$(kubectl config current-context); then
  die 'failed to read the current Kubernetes context'
fi
if ! namespace=$(kubectl config view --minify -o 'jsonpath={..namespace}'); then
  die 'failed to read the current Kubernetes namespace'
fi
namespace=${namespace:-default}

printf 'Current context:   %s\n' "$context"
printf 'Current namespace: %s\n' "$namespace"
