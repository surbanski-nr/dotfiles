#!/usr/bin/env bash

set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=setup-lib
source "$script_dir/setup-lib"

preflight() {
  local release_file=$RUNNER_TEMP/image-release.json
  local release_error=$RUNNER_TEMP/image-release-error.txt attempt status
  local tags_file=$RUNNER_TEMP/image-tags.txt error_file=$RUNNER_TEMP/package-error.txt
  local release_id commit_sha repository package_endpoint package_scope=users
  local build_image=true attach_compose=true

  if [[ ! $RELEASE_TAG =~ ^dotfiles-[0-9a-f]{7,40}$ ]]; then
    report_error "invalid release tag: $RELEASE_TAG"
  fi
  for attempt in {1..6}; do
    if timeout 30s gh api "repos/$GITHUB_REPOSITORY/releases/tags/$RELEASE_TAG" \
      >"$release_file" 2>"$release_error"; then
      break
    else
      status=$?
    fi
    if ((attempt == 6)) || ! grep -q 'HTTP 404' "$release_error"; then
      cat "$release_error" >&2
      return "$status"
    fi
    printf 'Release %s is not visible yet (%s/6); retrying in 10s.\n' "$RELEASE_TAG" "$attempt"
    sleep 10
  done
  release_id=$(jq -er '.id | numbers' "$release_file")
  commit_sha=$(timeout 30s gh api "repos/$GITHUB_REPOSITORY/commits/$RELEASE_TAG" --jq '.sha')
  if [[ ! $commit_sha =~ ^[0-9a-f]{40}$ || $commit_sha != "${RELEASE_TAG#dotfiles-}"* ]]; then
    report_error "release tag does not match target commit: $commit_sha"
  fi
  printf 'Release %s (ID %s) resolves to commit %s.\n' "$RELEASE_TAG" "$release_id" "$commit_sha"

  if [[ $PACKAGE_OWNER_TYPE == Organization ]]; then
    package_scope=orgs
  fi
  repository=${GITHUB_REPOSITORY,,}
  package_endpoint=$package_scope/${repository%/*}/packages/container/${repository#*/}
  if ! timeout 60s gh api "$package_endpoint/versions" --paginate \
    --jq '.[] | .metadata.container.tags[]?' >"$tags_file" 2>"$error_file"; then
    if ! grep -q 'HTTP 404' "$error_file"; then
      cat "$error_file" >&2
      return 1
    fi
  fi
  if grep -Fxq "$commit_sha" "$tags_file"; then
    build_image=false
    printf 'Commit image exists; skipping build and both tag pushes.\n'
  else
    printf 'Commit image is missing; build required.\n'
  fi
  if jq -e '
    [.assets[].name] |
    index("compose.yaml") != null and index("compose.yaml.sha256") != null
  ' "$release_file" >/dev/null; then
    attach_compose=false
    printf 'Compose assets are complete; skipping uploads.\n'
  fi
  printf '%s\n' \
    "release_id=$release_id" \
    "commit_sha=$commit_sha" \
    "image=ghcr.io/$repository:$commit_sha" \
    "build_image=$build_image" \
    "attach_compose=$attach_compose" >>"$GITHUB_OUTPUT"
}

publish_compose() {
  local source_compose=$1 release_id=${RELEASE_ID:?missing release ID}
  local release_file=$RUNNER_TEMP/image-release.json
  local compose_dir=$RUNNER_TEMP/dotfiles-compose asset asset_id

  timeout 30s gh api "repos/$GITHUB_REPOSITORY/releases/$release_id" >"$release_file"
  mkdir -p "$compose_dir"
  for asset in compose.yaml compose.yaml.sha256; do
    asset_id=$(jq -r --arg name "$asset" \
      '.assets[] | select(.name == $name) | .id' "$release_file")
    if [[ -n $asset_id ]]; then
      timeout 30s gh api "repos/$GITHUB_REPOSITORY/releases/assets/$asset_id" \
        --header 'Accept: application/octet-stream' >"$compose_dir/$asset"
    fi
  done
  if [[ ! -f $compose_dir/compose.yaml ]]; then
    sed \
      -e "s|^    image: .*|    image: $IMAGE|" \
      -e '/^    build: /d' "$source_compose" >"$compose_dir/compose.yaml"
  fi
  cd "$compose_dir"
  if [[ -f compose.yaml.sha256 ]]; then
    sha256sum --check --strict compose.yaml.sha256
  else
    sha256sum compose.yaml >compose.yaml.sha256
  fi
  for asset in compose.yaml compose.yaml.sha256; do
    if jq -e --arg name "$asset" 'any(.assets[]; .name == $name)' "$release_file" >/dev/null; then
      continue
    fi
    printf 'Attaching missing release asset: %s\n' "$asset"
    timeout 60s gh api \
      "https://uploads.github.com/repos/$GITHUB_REPOSITORY/releases/$release_id/assets?name=$asset" \
      --method POST \
      --header 'Content-Type: application/octet-stream' \
      --input "$asset" >/dev/null
  done
}

case ${1:-} in
  preflight)
    preflight
    ;;
  publish-compose)
    if (($# != 2)); then
      report_error 'usage: dotfiles-image-ci publish-compose SOURCE_COMPOSE'
    fi
    publish_compose "$2"
    ;;
  *)
    report_error 'usage: dotfiles-image-ci {preflight|publish-compose}'
    ;;
esac
