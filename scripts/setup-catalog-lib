#!/usr/bin/env bash

# Artifact validation uses the functions in setup-recipes-lib.

validate_version() {
  local name=$1
  local value=$2

  [[ $value =~ ^v?[0-9]+([.][0-9]+){1,3}([0-9A-Za-z.+-]*[0-9A-Za-z])?$ ]] ||
    report_error "$name has an invalid version: $value"
}

validate_digest() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{64}$ ]] || report_error "$name is not a SHA-256 digest"
}

validate_commit() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{40}$ ]] || report_error "$name is not a commit SHA"
}

# Release selectors set RELEASE_VERSION, RELEASE_URL, RELEASE_SHA256 and
# RELEASE_ASSET. Callers must copy values they need before selecting again.

parse_release_record() {
  local catalog_name=$1 tool=$2 record=$3 separators

  if [[ $record == *[[:space:]]* ]]; then
    report_error "${catalog_name}[$tool] contains whitespace"
    return 1
  fi
  separators=${record//[^|]/}
  if ! [[ $separators == '||' ]]; then
    report_error "${catalog_name}[$tool] record must contain exactly three fields"
    return 1
  fi
  IFS='|' read -r RELEASE_VERSION RELEASE_URL RELEASE_SHA256 <<<"$record"
  if ! [[ -n $RELEASE_VERSION && -n $RELEASE_URL && -n $RELEASE_SHA256 ]]; then
    report_error "${catalog_name}[$tool] contains an empty field"
    return 1
  fi
  validate_version "${catalog_name}[$tool]" "$RELEASE_VERSION" || return
  if [[ $RELEASE_URL == - || $RELEASE_SHA256 == - ]]; then
    if ! [[ $RELEASE_URL == - && $RELEASE_SHA256 == - ]]; then
      report_error "${catalog_name}[$tool] must provide both URL and SHA256 or neither"
      return 1
    fi
  else
    if ! [[ $RELEASE_URL == https://* ]]; then
      report_error "${catalog_name}[$tool] URL must use HTTPS: $RELEASE_URL"
      return 1
    fi
    validate_digest "${catalog_name}[$tool] digest" "$RELEASE_SHA256" || return
  fi
  RELEASE_ASSET=${RELEASE_URL##*/}
  if [[ $tool == python && $RELEASE_URL != - ]]; then
    RELEASE_ASSET=${RELEASE_ASSET//%2B/+}
  fi
}

release_versions() {
  local catalog_name=$1 tool=$2 record previous
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  RELEASE_VERSIONS=()
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record" || return
    for previous in "${RELEASE_VERSIONS[@]}"; do
      if [[ $previous == "$RELEASE_VERSION" ]]; then
        report_error "${catalog_name}[$tool] contains duplicate $RELEASE_VERSION"
        return 1
      fi
    done
    RELEASE_VERSIONS+=("$RELEASE_VERSION")
  done <<<"${catalog[$tool]}"
  ((${#RELEASE_VERSIONS[@]} > 0)) || report_error "${catalog_name}[$tool] is empty"
}

select_release() {
  local catalog_name=$1 tool=$2 requested_version=$3 record
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record" || return
    [[ $RELEASE_VERSION == "$requested_version" ]] && return 0
  done <<<"${catalog[$tool]}"
  report_error "${catalog_name}[$tool] has no release $requested_version"
}

select_default_release() {
  local catalog_name=$1 tool=$2 record
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record"
    return
  done <<<"${catalog[$tool]}"
  report_error "${catalog_name}[$tool] is empty"
}

validate_release_catalog() {
  local catalog_name=$1 tool
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  for tool in "${!catalog[@]}"; do
    if ! [[ $tool =~ ^[a-z0-9-]+$ ]]; then
      report_error "$catalog_name contains invalid tool name $tool"
      return 1
    fi
    release_versions "$catalog_name" "$tool" || return
  done
}

validate_tool_list() {
  local tools_name=$1 tool seen=' '
  local -n tools_ref=$tools_name

  if ! declare -p "$tools_name" 2>/dev/null | grep -q '^declare -a'; then
    report_error "$tools_name must be an indexed array"
    return 1
  fi
  if ((${#tools_ref[@]} == 0)); then
    report_error "$tools_name is empty"
    return 1
  fi
  for tool in "${tools_ref[@]}"; do
    if ! [[ $tool =~ ^[a-z0-9-]+$ ]]; then
      report_error "$tools_name contains invalid tool name $tool"
      return 1
    fi
    if [[ $seen == *" $tool "* ]]; then
      report_error "$tools_name contains duplicate $tool"
      return 1
    fi
    seen+="$tool "
  done
}

validate_validation_config() {
  local tool version

  validate_tool_list VALIDATION_TOOLS || return
  validate_release_catalog VALIDATION_RELEASES || return
  validate_version YAMLLINT_VERSION "${YAMLLINT_VERSION:-}" || return
  if [[ -v VALIDATION_RELEASES[yamllint] ]]; then
    report_error 'yamllint version belongs in YAMLLINT_VERSION'
    return 1
  fi
  for tool in "${VALIDATION_TOOLS[@]}"; do
    if [[ $tool == yamllint ]]; then
      continue
    elif ! [[ -v VALIDATION_RELEASES[$tool] ]]; then
      report_error "VALIDATION_RELEASES has no releases for validation tool $tool"
      return 1
    fi
    release_versions VALIDATION_RELEASES "$tool" || return
    for version in "${RELEASE_VERSIONS[@]}"; do
      select_release VALIDATION_RELEASES "$tool" "$version" || return
      if [[ $RELEASE_URL == - ]]; then
        report_error "validation release $tool $version requires an artifact"
        return 1
      fi
      artifact_layout "$tool" "$version" "$RELEASE_ASSET" || return
    done
  done
}

# Git selectors set PLUGIN_REPO and PLUGIN_COMMIT for either plugin catalog.
select_git_plugin() {
  local catalog_name=$1 plugin=$2 record
  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  local -n plugin_catalog=$catalog_name
  if ! [[ $plugin =~ ^[a-z0-9-]+$ ]]; then
    report_error "$catalog_name contains invalid plugin name $plugin"
    return 1
  fi
  if ! [[ -v plugin_catalog[$plugin] ]]; then
    report_error "$catalog_name has no plugin $plugin"
    return 1
  fi
  record=${plugin_catalog[$plugin]}
  if [[ $record == *[[:space:]]* || ${record//[^|]/} != '|' ]]; then
    report_error "${catalog_name}[$plugin] must contain repository|commit"
    return 1
  fi
  IFS='|' read -r PLUGIN_REPO PLUGIN_COMMIT <<<"$record"
  if ! [[ $PLUGIN_REPO == https://*.git ]]; then
    report_error "${catalog_name}[$plugin] has an invalid repository"
    return 1
  fi
  validate_commit "${catalog_name}[$plugin] commit" "$PLUGIN_COMMIT"
}

validate_git_plugin_catalog() {
  local catalog_name=$1 plugin
  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  local -n plugins=$catalog_name
  if ((${#plugins[@]} == 0)); then
    report_error "$catalog_name is empty"
    return 1
  fi
  for plugin in "${!plugins[@]}"; do
    select_git_plugin "$catalog_name" "$plugin" || return
  done
}

validate_tool_delivery() {
  local tools_name=$1 tool version
  local -n tools_ref=$tools_name

  if [[ $tools_name == OFFLINE_RELEASE_TOOLS ]]; then
    validate_tool_dependencies "$tools_name" || return
  fi
  for tool in "${tools_ref[@]}"; do
    [[ $tool == yamllint || -v TMUX_PLUGINS[$tool] ]] && continue
    [[ $tools_name != TOOLS || $tool != python ]] || continue
    if [[ $tools_name == OFFLINE_RELEASE_TOOLS ]]; then
      tool_metadata_fields "$tool" >/dev/null || {
        report_error "unsupported offline tool: $tool"
        return 1
      }
      select_default_release TOOL_RELEASES "$tool" || return
      RELEASE_VERSIONS=("$RELEASE_VERSION")
    else
      release_versions TOOL_RELEASES "$tool" || return
    fi
    for version in "${RELEASE_VERSIONS[@]}"; do
      select_release TOOL_RELEASES "$tool" "$version" || return
      [[ $RELEASE_URL != - ]] || {
        report_error "$tools_name release $tool $version requires an artifact"
        return 1
      }
      artifact_layout "$tool" "$version" "$RELEASE_ASSET" || return
      if [[ $tools_name == TOOLS && ${#SPEC_LINKS[@]} == 0 ]]; then
        report_error "TOOLS tool $tool is not supported by setup-tools"
        return 1
      fi
    done
  done
  if list_has "$tools_name" kubectx && list_has "$tools_name" kubens; then
    # These tools share one version field in release metadata.
    select_default_release TOOL_RELEASES kubectx || return
    local kubectx_version=$RELEASE_VERSION
    select_default_release TOOL_RELEASES kubens || return
    if [[ $RELEASE_VERSION != "$kubectx_version" ]]; then
      report_error 'kubectx and kubens defaults must use the same version'
      return 1
    fi
  fi
  if list_has "$tools_name" nodejs; then
    select_default_release TOOL_RELEASES npm || return
    [[ $RELEASE_URL != - ]] || {
      report_error 'npm default requires an artifact'
      return 1
    }
    artifact_layout npm "$RELEASE_VERSION" "$RELEASE_ASSET" || return
  fi
}

validate_tool_config() {
  local mode=${1:-all} tool list_name

  validate_release_catalog TOOL_RELEASES || return
  validate_git_plugin_catalog ASDF_PLUGINS || return
  validate_git_plugin_catalog TMUX_PLUGINS || return
  for tool in "${!TMUX_PLUGINS[@]}"; do
    if ! [[ $tool =~ ^tmux-[a-z0-9-]+$ ]]; then
      report_error "TMUX_PLUGINS contains invalid tmux plugin name $tool"
      return 1
    fi
    if [[ -v TOOL_RELEASES[$tool] ]]; then
      report_error "$tool cannot belong to both TOOL_RELEASES and TMUX_PLUGINS"
      return 1
    fi
  done
  for list_name in TOOLS OFFLINE_RELEASE_TOOLS; do
    validate_tool_list "$list_name" || return
  done
  for list_name in TOOLS OFFLINE_RELEASE_TOOLS; do
    local -n tools_ref=$list_name
    for tool in "${tools_ref[@]}"; do
      [[ $list_name == OFFLINE_RELEASE_TOOLS && $tool == yamllint ]] && continue
      [[ -v TMUX_PLUGINS[$tool] ]] && continue
      if ! [[ -v TOOL_RELEASES[$tool] ]]; then
        report_error "$list_name references unknown tool $tool"
        return 1
      fi
    done
    unset -n tools_ref
  done
  case $mode in
    all)
      validate_tool_delivery OFFLINE_RELEASE_TOOLS || return
      validate_tool_delivery TOOLS || return
      ;;
    offline)
      validate_tool_delivery OFFLINE_RELEASE_TOOLS || return
      ;;
    online)
      validate_tool_delivery TOOLS || return
      ;;
    asdf)
      ;;
    *)
      report_error "unknown tool validation mode: $mode"
      return 1
      ;;
  esac
  if [[ $mode == all || $mode == asdf ]]; then
    select_default_release TOOL_RELEASES asdf || return
    [[ $RELEASE_URL != - ]] || {
      report_error 'asdf default requires an artifact'
      return 1
    }
    artifact_layout asdf "$RELEASE_VERSION" "$RELEASE_ASSET" || return
  fi
  validate_version PIP_TOOLS_VERSION "${PIP_TOOLS_VERSION:-}" || return

  for tool in "${!ASDF_PLUGINS[@]}"; do
    if ! [[ -v TOOL_RELEASES[$tool] ]]; then
      report_error "ASDF_PLUGINS references unknown tool $tool"
      return 1
    fi
  done
}
