#!/usr/bin/env bash

report_error() {
  printf '%s: %s\n' "${0##*/}" "$*" >&2
  return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || report_error "required command is missing: $1"
}

# The descriptor stays open until process exit. The kernel releases flock when
# its last descriptor closes, even after SIGKILL. Children may keep inherited
# descriptors until they exit. Keep the file in place so concurrent processes
# cannot lock different inodes for the same operation.
acquire_setup_lock() {
  local path=$1 message=$2 descriptor

  if [[ -L $path || -s $path || ( -e $path && ! -f $path ) ]]; then
    report_error "$message (invalid or legacy lock path: $path)"
    return 1
  fi
  exec {descriptor}>"$path" || return
  if ! flock -n "$descriptor"; then
    exec {descriptor}>&-
    report_error "$message"
    return 1
  fi
}

cleanup_setup() {
  local status=$? path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    if [[ -e $path || -L $path ]]; then
      find "$path" -depth -delete
    fi
  done
  exit "$status"
}

acquire_online_setup_lock() {
  local directory=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles

  if [[ -L $directory || ( -e $directory && ! -d $directory ) ]]; then
    report_error "invalid online setup state directory: $directory"
    return 1
  fi
  mkdir -p "$directory" || return
  acquire_setup_lock "$directory/setup.lock" 'another online installer is running'
}

require_setup_commands() {
  local command_name
  local -a commands=()

  read -r -a commands <<<"${SETUP_PREREQUISITES[$1]}"
  for command_name in "${commands[@]}"; do
    require_command "$command_name" || return
  done
}

# shellcheck source=setup-catalog-lib
source "${BASH_SOURCE[0]%/*}/setup-catalog-lib"

verify_sha256() {
  local path=$1
  local digest=$2

  printf '%s  %s\n' "$digest" "$path" | sha256sum --check --strict >/dev/null
}

download_file() {
  local url=$1
  local destination=$2

  curl --fail --location --silent --show-error \
    --connect-timeout 15 --max-time 900 --retry 3 --retry-all-errors \
    --output "$destination" "$url"
}

artifact_layout() {
  local name=$1
  local version=$2
  local asset=$3

  if ! [[ $asset =~ ^[0-9A-Za-z][0-9A-Za-z._+%-]*$ ]]; then
    report_error "unsafe artifact name for $name $version: $asset"
    return 1
  fi
  # Consumed by callers after sourcing this library.
  # shellcheck disable=SC2034
  SPEC_ASSET=$asset
  SPEC_DESTS=()
  SPEC_LINKS=()
  SPEC_SECOND_MEMBER=
  case $name in
    actionlint | asdf | kyverno | task | trivy | k9s | kubeconform | kubectx | kubens | zizmor | zoxide)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=$name
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    gh)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="gh_${version}_linux_amd64/bin/gh"
      SPEC_DESTS=("gh-$version")
      SPEC_LINKS=("gh:gh-$version")
      ;;
    shellcheck)
      SPEC_FORMAT=xz-member
      SPEC_MEMBER="shellcheck-v${version}/shellcheck"
      SPEC_DESTS=("shellcheck-$version")
      SPEC_LINKS=("shellcheck:shellcheck-$version")
      ;;
    oh-my-posh | kubectl | kind | yq)
      SPEC_FORMAT=raw
      SPEC_MEMBER=
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    rg)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="ripgrep-${version}-x86_64-unknown-linux-musl/rg"
      SPEC_DESTS=("rg-$version")
      SPEC_LINKS=("rg:rg-$version")
      ;;
    fd)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="fd-v${version}-x86_64-unknown-linux-musl/fd"
      SPEC_DESTS=("fd-$version")
      SPEC_LINKS=("fd:fd-$version")
      ;;
    uv)
      SPEC_FORMAT=gz-pair
      SPEC_MEMBER=uv-x86_64-unknown-linux-gnu/uv
      SPEC_SECOND_MEMBER=uv-x86_64-unknown-linux-gnu/uvx
      SPEC_DESTS=("uv-$version" "uvx-$version")
      SPEC_LINKS=("uv:uv-$version" "uvx:uvx-$version")
      ;;
    nvim)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=nvim-linux-x86_64
      SPEC_DESTS=("nvim-$version")
      SPEC_LINKS=("nvim:nvim-$version/bin/nvim")
      ;;
    go)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=go
      SPEC_DESTS=("go-$version")
      SPEC_LINKS=("go:go-$version/bin/go" "gofmt:go-$version/bin/gofmt")
      ;;
    helm)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=linux-amd64/helm
      SPEC_DESTS=("helm-$version")
      SPEC_LINKS=("helm:helm-$version")
      ;;
    nodejs)
      SPEC_FORMAT=xz-tree
      SPEC_MEMBER="node-v${version}-linux-x64"
      SPEC_DESTS=("node-$version")
      SPEC_LINKS=()
      ;;
    npm)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=package
      SPEC_DESTS=(npm-package)
      SPEC_LINKS=()
      ;;
    python)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=python
      SPEC_DESTS=("python-$version")
      SPEC_LINKS=()
      ;;
    fzf)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=fzf
      SPEC_DESTS=("fzf-$version")
      SPEC_LINKS=()
      ;;
    stylua | terraform)
      SPEC_FORMAT=zip-member
      SPEC_MEMBER=$name
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    tmux)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER="tmux-$version"
      SPEC_DESTS=("tmux-$version")
      SPEC_LINKS=("tmux:tmux-$version/bin/tmux")
      ;;
    htop)
      SPEC_FORMAT=xz-tree
      SPEC_MEMBER="htop-$version"
      SPEC_DESTS=("htop-$version")
      SPEC_LINKS=("htop:htop-$version/bin/htop")
      ;;
    *)
      report_error "missing artifact mapping for $name"
      ;;
  esac
}

compile_tool_source() {
  local name=$1 source=$2 prefix=$3 jobs
  local -a configure_args=("--prefix=$prefix")

  case $name in
    htop)
      configure_args+=(
        --disable-capabilities
        --disable-delayacct
        --disable-sensors
      )
      ;;
    tmux) ;;
    *)
      report_error "unsupported source build: $name"
      return 1
      ;;
  esac
  jobs=$(getconf _NPROCESSORS_ONLN) || return
  [[ $jobs =~ ^[1-9][0-9]*$ ]] || {
    report_error "invalid processor count: $jobs"
    return 1
  }
  (
    cd "$source" || exit
    ./configure "${configure_args[@]}" || exit
    make -j"$jobs" || exit
    make install || exit
  )
}

validate_tar_archive() {
  local archive=$1 compression=$2 subtree=${3:-}
  local member line type remainder name target resolved listing verbose
  local -a list_args=(-tf) verbose_args=(-tvf)

  case $compression in
    gz)
      list_args=(-tzf)
      verbose_args=(-tvzf)
      ;;
    xz)
      list_args=(-tJf)
      verbose_args=(-tvJf)
      ;;
    *)
      report_error "unsupported tar compression: $compression"
      return
      ;;
  esac
  listing=$(tar "${list_args[@]}" "$archive") || return
  while IFS= read -r member || [[ -n $member ]]; do
    [[ -n $member && $member != /* && $member != ../* && /$member/ != *'/../'* ]] || {
      report_error "unsafe archive member: $member"
      return 1
    }
    if [[ -n $subtree ]]; then
      [[ $member == "$subtree" || $member == "$subtree/"* ]] || {
        report_error "unexpected archive member: $member"
        return 1
      }
    fi
  done <<<"$listing"
  verbose=$(LC_ALL=C tar --numeric-owner --quoting-style=literal \
    "${verbose_args[@]}" "$archive") || return
  while IFS= read -r line || [[ -n $line ]]; do
    type=${line:0:1}
    case $type in
      - | d) ;;
      l)
        read -r _ _ _ _ _ remainder <<<"$line"
        [[ $remainder == *' -> '* ]] || {
          report_error "cannot parse archive link: $line"
          return 1
        }
        name=${remainder% -> *}
        target=${remainder##* -> }
        [[ $target != /* ]] || {
          report_error "absolute archive link: $name -> $target"
          return 1
        }
        resolved=$(readlink -m -- "/archive/$(dirname -- "$name")/$target")
        [[ $resolved == /archive/* ]] || {
          report_error "archive link escapes its root: $name -> $target"
          return 1
        }
        if [[ -n $subtree ]]; then
          [[ $resolved == "/archive/$subtree" || $resolved == "/archive/$subtree/"* ]] || {
            report_error "archive link escapes expected subtree: $name -> $target"
            return 1
          }
        fi
        ;;
      h)
        report_error "archive hard links are not supported: $line"
        return 1
        ;;
      *)
        report_error "archive contains an unsupported member type: $line"
        return 1
        ;;
    esac
  done <<<"$verbose"
}

archive_member_to_file() {
  local archive=$1 format=$2 member=$3 output=$4

  case $format in
    gz-member | gz-pair)
      tar -xOzf "$archive" -- "$member" >"$output" || return
      ;;
    xz-member)
      tar -xOJf "$archive" -- "$member" >"$output" || return
      ;;
    *)
      report_error "invalid member format: $format"
      return
      ;;
  esac
  chmod 0755 "$output"
}

extract_artifact() {
  local archive=$1 destination=$2

  case $SPEC_FORMAT in
    raw)
      install -m 0755 "$archive" "$destination/${SPEC_DESTS[0]}" || return
      ;;
    gz-member | xz-member)
      validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}"
      ;;
    gz-pair)
      validate_tar_archive "$archive" gz || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}" || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_SECOND_MEMBER" \
        "$destination/${SPEC_DESTS[1]}"
      ;;
    gz-tree | xz-tree)
      validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" "$SPEC_MEMBER" || return
      # GNU tar detects compression when reading a named archive.
      tar -xf "$archive" -C "$destination" \
        --no-same-owner --no-same-permissions --keep-directory-symlink -- "$SPEC_MEMBER" || return
      if [[ $SPEC_MEMBER != "${SPEC_DESTS[0]}" ]]; then
        mv -- "$destination/$SPEC_MEMBER" "$destination/${SPEC_DESTS[0]}"
      fi
      ;;
    zip-member)
      unzip -p "$archive" "$SPEC_MEMBER" >"$destination/${SPEC_DESTS[0]}" || return
      chmod 0755 "$destination/${SPEC_DESTS[0]}"
      ;;
    *)
      report_error "invalid artifact format: $SPEC_FORMAT"
      ;;
  esac
}

prepare_artifact() {
  local catalog_name=$1 name=$2 version=$3 archive=$4 destination=$5

  select_release "$catalog_name" "$name" "$version" || return
  if [[ $RELEASE_URL == - ]]; then
    report_error "$name $version has no direct artifact"
    return 1
  fi
  artifact_layout "$name" "$version" "$RELEASE_ASSET" || return
  if ! [[ -f $archive && ! -L $archive ]]; then
    report_error "missing artifact: $archive"
    return 1
  fi
  verify_sha256 "$archive" "$RELEASE_SHA256" || return
  mkdir -p "$destination" || return
  extract_artifact "$archive" "$destination"
}
