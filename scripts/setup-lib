#!/usr/bin/env bash

report_error() {
  printf '%s: %s\n' "${0##*/}" "$*" >&2
  return 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || report_error "required command is missing: $1"
}

# The kernel releases flock when its last descriptor closes, even after SIGKILL.
# Children may hold inherited descriptors until they exit. Keep the file in place
# so concurrent processes cannot lock different inodes for the same operation.
acquire_setup_lock() {
  local path=$1 message=$2 descriptor

  if [[ -L $path || -s $path || ( -e $path && ! -f $path ) ]]; then
    report_error "$message (invalid or legacy lock path: $path)"
    return 1
  fi
  exec {descriptor}>"$path" || return
  if ! flock -n "$descriptor"; then
    exec {descriptor}>&-
    report_error "$message"
    return 1
  fi
  HELD_LOCK_FDS+=("$descriptor")
}

release_setup_locks() {
  local descriptor
  for descriptor in "${HELD_LOCK_FDS[@]}"; do
    exec {descriptor}>&-
  done
}

require_setup_commands() {
  local command_name
  local -a commands=()

  read -r -a commands <<<"${SETUP_PREREQUISITES[$1]}"
  for command_name in "${commands[@]}"; do
    require_command "$command_name" || return
  done
}

validate_version() {
  local name=$1
  local value=$2

  [[ $value =~ ^v?[0-9]+([.][0-9]+){1,3}([0-9A-Za-z.+-]*[0-9A-Za-z])?$ ]] ||
    report_error "$name has an invalid version: $value"
}

validate_digest() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{64}$ ]] || report_error "$name is not a SHA-256 digest"
}

validate_commit() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{40}$ ]] || report_error "$name is not a commit SHA"
}

# Release selectors set RELEASE_VERSION, RELEASE_URL, RELEASE_SHA256 and
# RELEASE_ASSET. Callers must copy values they need before selecting again.

parse_release_record() {
  local catalog_name=$1 tool=$2 record=$3 separators

  if [[ $record == *[[:space:]]* ]]; then
    report_error "${catalog_name}[$tool] contains whitespace"
    return 1
  fi
  separators=${record//[^|]/}
  if ! [[ $separators == '||' ]]; then
    report_error "${catalog_name}[$tool] record must contain exactly three fields"
    return 1
  fi
  IFS='|' read -r RELEASE_VERSION RELEASE_URL RELEASE_SHA256 <<<"$record"
  if ! [[ -n $RELEASE_VERSION && -n $RELEASE_URL && -n $RELEASE_SHA256 ]]; then
    report_error "${catalog_name}[$tool] contains an empty field"
    return 1
  fi
  validate_version "${catalog_name}[$tool]" "$RELEASE_VERSION" || return
  if [[ $RELEASE_URL == - || $RELEASE_SHA256 == - ]]; then
    if ! [[ $RELEASE_URL == - && $RELEASE_SHA256 == - ]]; then
      report_error "${catalog_name}[$tool] must provide both URL and SHA256 or neither"
      return 1
    fi
  else
    if ! [[ $RELEASE_URL == https://* ]]; then
      report_error "${catalog_name}[$tool] URL must use HTTPS: $RELEASE_URL"
      return 1
    fi
    validate_digest "${catalog_name}[$tool] digest" "$RELEASE_SHA256" || return
  fi
  RELEASE_ASSET=${RELEASE_URL##*/}
  if [[ $tool == python && $RELEASE_URL != - ]]; then
    RELEASE_ASSET="cpython-${RELEASE_VERSION}+${PYTHON_STANDALONE_BUILD}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"
  fi
}

release_versions() {
  local catalog_name=$1 tool=$2 record previous
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  RELEASE_VERSIONS=()
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record" || return
    for previous in "${RELEASE_VERSIONS[@]}"; do
      if [[ $previous == "$RELEASE_VERSION" ]]; then
        report_error "${catalog_name}[$tool] contains duplicate $RELEASE_VERSION"
        return 1
      fi
    done
    RELEASE_VERSIONS+=("$RELEASE_VERSION")
  done <<<"${catalog[$tool]}"
  ((${#RELEASE_VERSIONS[@]} > 0)) || report_error "${catalog_name}[$tool] is empty"
}

select_release() {
  local catalog_name=$1 tool=$2 requested_version=$3 record
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record" || return
    [[ $RELEASE_VERSION == "$requested_version" ]] && return 0
  done <<<"${catalog[$tool]}"
  report_error "${catalog_name}[$tool] has no release $requested_version"
}

select_default_release() {
  local catalog_name=$1 tool=$2 record
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  if ! [[ -v catalog[$tool] ]]; then
    report_error "$catalog_name has no releases for $tool"
    return 1
  fi
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    parse_release_record "$catalog_name" "$tool" "$record"
    return
  done <<<"${catalog[$tool]}"
  report_error "${catalog_name}[$tool] is empty"
}

validate_release_catalog() {
  local catalog_name=$1 tool
  local -n catalog=$catalog_name

  if ! declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A'; then
    report_error "$catalog_name must be an associative array"
    return 1
  fi
  for tool in "${!catalog[@]}"; do
    if ! [[ $tool =~ ^[a-z0-9-]+$ ]]; then
      report_error "$catalog_name contains invalid tool name $tool"
      return 1
    fi
    release_versions "$catalog_name" "$tool" || return
  done
}

validate_profile() {
  local profile_name=$1 tool seen=' '
  local -n profile=$profile_name

  if ! declare -p "$profile_name" 2>/dev/null | grep -q '^declare -a'; then
    report_error "$profile_name must be an indexed array"
    return 1
  fi
  if ((${#profile[@]} == 0)); then
    report_error "$profile_name is empty"
    return 1
  fi
  for tool in "${profile[@]}"; do
    if ! [[ $tool =~ ^[a-z0-9-]+$ ]]; then
      report_error "$profile_name contains invalid tool name $tool"
      return 1
    fi
    if [[ $seen == *" $tool "* ]]; then
      report_error "$profile_name contains duplicate $tool"
      return 1
    fi
    seen+="$tool "
  done
}

validate_validator_config() {
  local tool version seen=' '

  validate_profile VALIDATOR_TOOLS || return
  validate_release_catalog VALIDATOR_RELEASES || return
  for tool in "${VALIDATOR_TOOLS[@]}"; do
    seen+="$tool "
    [[ $tool == yamllint ]] && continue
    if ! [[ -v VALIDATOR_RELEASES[$tool] ]]; then
      report_error "VALIDATOR_RELEASES has no releases for $tool"
      return 1
    fi
    release_versions VALIDATOR_RELEASES "$tool" || return
    for version in "${RELEASE_VERSIONS[@]}"; do
      select_release VALIDATOR_RELEASES "$tool" "$version" || return
      if [[ $RELEASE_URL == - ]]; then
        report_error "validation release $tool $version requires an artifact"
        return 1
      fi
      artifact_layout "$tool" "$version" "$RELEASE_ASSET" || return
    done
  done
  for tool in "${!VALIDATOR_RELEASES[@]}"; do
    if [[ $tool == yamllint || $seen != *" $tool "* ]]; then
      report_error "VALIDATOR_RELEASES contains unsupported tool $tool"
      return 1
    fi
  done
  for version in YAMLLINT_VERSION YAMLLINT_PATHSPEC_VERSION YAMLLINT_PYYAML_VERSION; do
    validate_version "$version" "${!version:-}" || return
  done
}

validate_tool_config() {
  local record repository commit tool version profile

  validate_release_catalog TOOL_RELEASES || return
  for profile in TOOLS OFFLINE_RELEASE_TOOLS; do
    validate_profile "$profile" || return
  done
  for profile in TOOLS OFFLINE_RELEASE_TOOLS; do
    local -n profile_tools=$profile
    for tool in "${profile_tools[@]}"; do
      [[ $tool == task ]] && continue
      if ! [[ -v TOOL_RELEASES[$tool] ]]; then
        report_error "$profile references unknown tool $tool"
        return 1
      fi
    done
    unset -n profile_tools
  done
  if [[ -v TOOL_RELEASES[task] ]]; then
    report_error 'task must be pinned only in validation.env'
    return 1
  fi

  for tool in "${OFFLINE_RELEASE_TOOLS[@]}"; do
    [[ $tool == task ]] && continue
    select_default_release TOOL_RELEASES "$tool" || return
    if [[ $RELEASE_URL == - ]]; then
      report_error "offline default $tool $RELEASE_VERSION requires an artifact"
      return 1
    fi
    artifact_layout "$tool" "$RELEASE_VERSION" "$RELEASE_ASSET" || return
  done
  for tool in "${TOOLS[@]}"; do
    [[ $tool == task ]] && continue
    release_versions TOOL_RELEASES "$tool" || return
    for version in "${RELEASE_VERSIONS[@]}"; do
      select_release TOOL_RELEASES "$tool" "$version" || return
      if [[ $RELEASE_URL == - ]]; then
        report_error "TOOLS release $tool $version requires an artifact"
        return 1
      fi
      artifact_layout "$tool" "$version" "$RELEASE_ASSET" || return
      if ((${#SPEC_LINKS[@]} == 0)); then
        report_error "TOOLS tool $tool is not supported by setup-tools"
        return 1
      fi
    done
  done
  for tool in asdf npm; do
    select_default_release TOOL_RELEASES "$tool" || return
    if [[ $RELEASE_URL == - ]]; then
      report_error "$tool default requires an artifact"
      return 1
    fi
    artifact_layout "$tool" "$RELEASE_VERSION" "$RELEASE_ASSET" || return
  done
  validate_version KUBECTX_VERSION "${KUBECTX_VERSION:-}" || return
  for tool in kubectx kubens; do
    select_default_release TOOL_RELEASES "$tool" || return
    if ! [[ $RELEASE_VERSION == "$KUBECTX_VERSION" ]]; then
      report_error "$tool default must use KUBECTX_VERSION"
      return 1
    fi
  done
  validate_version PIP_TOOLS_VERSION "${PIP_TOOLS_VERSION:-}" || return
  if ! [[ $PYTHON_STANDALONE_BUILD =~ ^[0-9]{8}$ ]]; then
    report_error 'PYTHON_STANDALONE_BUILD must use YYYYMMDD'
    return 1
  fi

  if ! declare -p ASDF_PLUGINS 2>/dev/null | grep -q '^declare -A'; then
    report_error 'ASDF_PLUGINS must be an associative array'
    return 1
  fi
  if ((${#ASDF_PLUGINS[@]} == 0)); then
    report_error 'ASDF_PLUGINS is empty'
    return 1
  fi
  for tool in "${!ASDF_PLUGINS[@]}"; do
    if ! [[ $tool =~ ^[a-z0-9-]+$ ]]; then
      report_error "ASDF_PLUGINS contains invalid tool name $tool"
      return 1
    fi
    if ! [[ -v TOOL_RELEASES[$tool] ]]; then
      report_error "ASDF_PLUGINS references unknown tool $tool"
      return 1
    fi
    record=${ASDF_PLUGINS[$tool]}
    if [[ $record == *[[:space:]]* || ${record//[^|]/} != '|' ]]; then
      report_error "ASDF_PLUGINS[$tool] must contain repository|commit"
      return 1
    fi
    IFS='|' read -r repository commit <<<"$record"
    if ! [[ $repository == https://*.git ]]; then
      report_error "ASDF_PLUGINS[$tool] has an invalid repository"
      return 1
    fi
    validate_commit "ASDF_PLUGINS[$tool] commit" "$commit" || return
  done
  for commit in "$TPM_COMMIT" "$TMUX_SENSIBLE_COMMIT" \
    "$TMUX_RESURRECT_COMMIT" "$TMUX_CONTINUUM_COMMIT"; do
    validate_commit 'tmux plugin commit' "$commit" || return
  done
  for repository in "$TPM_REPO" "$TMUX_SENSIBLE_REPO" \
    "$TMUX_RESURRECT_REPO" "$TMUX_CONTINUUM_REPO"; do
    if [[ $repository != https://*.git || $repository == *[[:space:]]* ]]; then
      report_error "invalid tmux plugin repository: $repository"
      return 1
    fi
  done
}

verify_sha256() {
  local path=$1
  local digest=$2

  printf '%s  %s\n' "$digest" "$path" | sha256sum --check --strict >/dev/null
}

download_file() {
  local url=$1
  local destination=$2

  curl --fail --location --silent --show-error \
    --connect-timeout 15 --max-time 900 --retry 3 --retry-all-errors \
    --output "$destination" "$url"
}

artifact_layout() {
  local name=$1
  local version=$2
  local asset=$3

  if ! [[ $asset =~ ^[0-9A-Za-z][0-9A-Za-z._+%-]*$ ]]; then
    report_error "unsafe artifact name for $name $version: $asset"
    return 1
  fi
  # Consumed by callers after sourcing this library.
  # shellcheck disable=SC2034
  SPEC_ASSET=$asset
  SPEC_DESTS=()
  SPEC_LINKS=()
  SPEC_SECOND_MEMBER=
  case $name in
    actionlint | asdf | kyverno | task | trivy | k9s | kubeconform | kubectx | kubens | zizmor | zoxide)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=$name
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    gh)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="gh_${version}_linux_amd64/bin/gh"
      SPEC_DESTS=("gh-$version")
      SPEC_LINKS=("gh:gh-$version")
      ;;
    shellcheck)
      SPEC_FORMAT=xz-member
      SPEC_MEMBER="shellcheck-v${version}/shellcheck"
      SPEC_DESTS=("shellcheck-$version")
      SPEC_LINKS=("shellcheck:shellcheck-$version")
      ;;
    oh-my-posh | kubectl)
      SPEC_FORMAT=raw
      SPEC_MEMBER=
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    rg)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="ripgrep-${version}-x86_64-unknown-linux-musl/rg"
      SPEC_DESTS=("rg-$version")
      SPEC_LINKS=("rg:rg-$version")
      ;;
    fd)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="fd-v${version}-x86_64-unknown-linux-musl/fd"
      SPEC_DESTS=("fd-$version")
      SPEC_LINKS=("fd:fd-$version")
      ;;
    uv)
      SPEC_FORMAT=gz-pair
      SPEC_MEMBER=uv-x86_64-unknown-linux-gnu/uv
      SPEC_SECOND_MEMBER=uv-x86_64-unknown-linux-gnu/uvx
      SPEC_DESTS=("uv-$version" "uvx-$version")
      SPEC_LINKS=("uv:uv-$version" "uvx:uvx-$version")
      ;;
    nvim)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=nvim-linux-x86_64
      SPEC_DESTS=("nvim-$version")
      SPEC_LINKS=("nvim:nvim-$version/bin/nvim")
      ;;
    helm)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=linux-amd64/helm
      SPEC_DESTS=("helm-$version")
      SPEC_LINKS=("helm:helm-$version")
      ;;
    nodejs)
      SPEC_FORMAT=xz-tree
      SPEC_MEMBER="node-v${version}-linux-x64"
      SPEC_DESTS=("node-$version")
      SPEC_LINKS=()
      ;;
    npm)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=package
      SPEC_DESTS=(npm-package)
      SPEC_LINKS=()
      ;;
    python)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=python
      SPEC_DESTS=("python-$version")
      SPEC_LINKS=()
      ;;
    fzf)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=fzf
      SPEC_DESTS=("fzf-$version")
      SPEC_LINKS=()
      ;;
    stylua | terraform)
      SPEC_FORMAT=zip-member
      SPEC_MEMBER=$name
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    tmux)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER="tmux-$version"
      SPEC_DESTS=("tmux-$version")
      # setup-tools does not install tmux, but release artifact preparation does.
      # shellcheck disable=SC2034
      SPEC_LINKS=()
      ;;
    *) report_error "missing artifact mapping for $name" ;;
  esac
}

validate_tar_archive() {
  local archive=$1 compression=$2 subtree=${3:-}
  local member line type remainder name target resolved listing verbose
  local -a list_args=(-tf) verbose_args=(-tvf)

  case $compression in
    gz) list_args=(-tzf); verbose_args=(-tvzf) ;;
    xz) list_args=(-tJf); verbose_args=(-tvJf) ;;
    *) report_error "unsupported tar compression: $compression"; return ;;
  esac
  listing=$(tar "${list_args[@]}" "$archive") || return
  while IFS= read -r member || [[ -n $member ]]; do
    [[ -n $member && $member != /* && $member != ../* && /$member/ != *'/../'* ]] ||
      { report_error "unsafe archive member: $member"; return 1; }
    if [[ -n $subtree ]]; then
      [[ $member == "$subtree" || $member == "$subtree/"* ]] ||
        { report_error "unexpected archive member: $member"; return 1; }
    fi
  done <<<"$listing"
  verbose=$(LC_ALL=C tar --numeric-owner --quoting-style=literal \
    "${verbose_args[@]}" "$archive") || return
  while IFS= read -r line || [[ -n $line ]]; do
    type=${line:0:1}
    case $type in
      - | d) ;;
      l)
        read -r _ _ _ _ _ remainder <<<"$line"
        [[ $remainder == *' -> '* ]] || { report_error "cannot parse archive link: $line"; return 1; }
        name=${remainder% -> *}
        target=${remainder##* -> }
        [[ $target != /* ]] || { report_error "absolute archive link: $name -> $target"; return 1; }
        resolved=$(readlink -m -- "/archive/$(dirname -- "$name")/$target")
        [[ $resolved == /archive/* ]] || { report_error "archive link escapes its root: $name -> $target"; return 1; }
        if [[ -n $subtree ]]; then
          [[ $resolved == "/archive/$subtree" || $resolved == "/archive/$subtree/"* ]] ||
            { report_error "archive link escapes expected subtree: $name -> $target"; return 1; }
        fi
        ;;
      h) report_error "archive hard links are not supported: $line"; return 1 ;;
      *) report_error "archive contains an unsupported member type: $line"; return 1 ;;
    esac
  done <<<"$verbose"
}

archive_member_to_file() {
  local archive=$1 format=$2 member=$3 output=$4

  case $format in
    gz-member | gz-pair) tar -xOzf "$archive" -- "$member" >"$output" || return ;;
    xz-member) tar -xOJf "$archive" -- "$member" >"$output" || return ;;
    *) report_error "invalid member format: $format"; return ;;
  esac
  chmod 0755 "$output"
}

extract_artifact() {
  local archive=$1 destination=$2

  case $SPEC_FORMAT in
    raw)
      install -m 0755 "$archive" "$destination/${SPEC_DESTS[0]}"
      ;;
    gz-member | xz-member)
      validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}"
      ;;
    gz-pair)
      validate_tar_archive "$archive" gz || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}" || return
      archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_SECOND_MEMBER" \
        "$destination/${SPEC_DESTS[1]}"
      ;;
    gz-tree)
      validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" "$SPEC_MEMBER" || return
      tar -xzf "$archive" -C "$destination" \
        --no-same-owner --no-same-permissions --keep-directory-symlink -- "$SPEC_MEMBER" || return
      if [[ $SPEC_MEMBER != "${SPEC_DESTS[0]}" ]]; then
        mv -- "$destination/$SPEC_MEMBER" "$destination/${SPEC_DESTS[0]}"
      fi
      ;;
    xz-tree)
      validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" "$SPEC_MEMBER" || return
      tar -xJf "$archive" -C "$destination" \
        --no-same-owner --no-same-permissions --keep-directory-symlink -- "$SPEC_MEMBER" || return
      if [[ $SPEC_MEMBER != "${SPEC_DESTS[0]}" ]]; then
        mv -- "$destination/$SPEC_MEMBER" "$destination/${SPEC_DESTS[0]}"
      fi
      ;;
    zip-member)
      unzip -p "$archive" "$SPEC_MEMBER" >"$destination/${SPEC_DESTS[0]}" || return
      chmod 0755 "$destination/${SPEC_DESTS[0]}"
      ;;
    *) report_error "invalid artifact format: $SPEC_FORMAT" ;;
  esac
}

prepare_artifact() {
  local catalog_name=$1 name=$2 version=$3 archive=$4 destination=$5

  select_release "$catalog_name" "$name" "$version" || return
  if [[ $RELEASE_URL == - ]]; then
    report_error "$name $version has no direct artifact"
    return 1
  fi
  artifact_layout "$name" "$version" "$RELEASE_ASSET" || return
  if ! [[ -f $archive && ! -L $archive ]]; then
    report_error "missing artifact: $archive"
    return 1
  fi
  verify_sha256 "$archive" "$RELEASE_SHA256" || return
  mkdir -p "$destination" || return
  extract_artifact "$archive" "$destination"
}

system_package_list() {
  local platform=$1 role=$2 family
  local -a role_common=() role_platform=()

  case $platform in
    debian:* | ubuntu:* | debian-*-x86_64 | ubuntu-*-x86_64) family=DEBIAN ;;
    amzn:2023 | amzn-2023-x86_64) family=AMZN ;;
    *) report_error "unsupported system package platform: $platform"; return ;;
  esac
  local -n runtime_platform=SYSTEM_${family}_RUNTIME_PACKAGES
  case $role in
    runtime) ;;
    build | setup)
      local -n common=SYSTEM_${role^^}_PACKAGES
      local -n specific=SYSTEM_${family}_${role^^}_PACKAGES
      role_common=("${common[@]}")
      role_platform=("${specific[@]}")
      ;;
    *) report_error "unknown system package role: $role"; return ;;
  esac
  # Consumed by setup-system and the builder after sourcing this library.
  # shellcheck disable=SC2034
  SETUP_SYSTEM_PACKAGES=(
    "${SYSTEM_RUNTIME_PACKAGES[@]}"
    "${runtime_platform[@]}"
    "${role_common[@]}"
    "${role_platform[@]}"
  )
}

install_system_packages() {
  local platform=$1 role=$2 no_recommends=$3
  shift 3
  local -a root_command=("$@")
  local -a install_args=(install -y)

  system_package_list "$platform" "$role" || return
  case $platform in
    debian:* | ubuntu:* | debian-*-x86_64 | ubuntu-*-x86_64)
      [[ $no_recommends != true ]] || install_args+=(--no-install-recommends)
      "${root_command[@]}" env DEBIAN_FRONTEND=noninteractive apt-get update || return
      "${root_command[@]}" env DEBIAN_FRONTEND=noninteractive apt-get \
        "${install_args[@]}" "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
    amzn:2023 | amzn-2023-x86_64)
      if [[ $role == setup ]]; then
        if rpm -q gnupg2-minimal >/dev/null 2>&1; then
          "${root_command[@]}" dnf swap -y gnupg2-minimal gnupg2 || return
        else
          "${root_command[@]}" dnf install -y gnupg2 || return
        fi
      fi
      "${root_command[@]}" dnf install -y --allowerasing \
        "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
    *) report_error "unsupported system package platform: $platform" ;;
  esac
}
