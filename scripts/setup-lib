#!/usr/bin/env bash

setup_die() {
  printf '%s: %s\n' "${SETUP_PROGRAM:-setup}" "$*" >&2
  return 1
}

setup_need() {
  command -v "$1" >/dev/null 2>&1 || setup_die "required command is missing: $1"
}

setup_validate_version() {
  local name=$1
  local value=$2

  [[ $value =~ ^v?[0-9]+([.][0-9]+){1,3}([0-9A-Za-z.+-]*[0-9A-Za-z])?$ ]] ||
    setup_die "$name has an invalid version: $value"
}

setup_validate_digest() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{64}$ ]] || setup_die "$name is not a SHA-256 digest"
}

setup_validate_commit() {
  local name=$1
  local value=$2

  [[ $value =~ ^[0-9a-f]{40}$ ]] || setup_die "$name is not a commit SHA"
}

setup_release_versions() {
  local catalog_name=$1
  local tool=$2
  local record version url digest separators previous
  local -n catalog=$catalog_name

  declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A' ||
    setup_die "$catalog_name must be an associative array" || return
  [[ -v catalog[$tool] ]] || setup_die "$catalog_name has no releases for $tool" || return
  RELEASE_VERSIONS=()
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    [[ $record != *[[:space:]]* ]] ||
      setup_die "${catalog_name}[$tool] contains whitespace" || return
    separators=${record//[^|]/}
    [[ $separators == '||' ]] ||
      setup_die "${catalog_name}[$tool] record must contain exactly three fields" || return
    IFS='|' read -r version url digest <<<"$record"
    [[ -n $version && -n $url && -n $digest ]] ||
      setup_die "${catalog_name}[$tool] contains an empty field" || return
    setup_validate_version "${catalog_name}[$tool]" "$version" || return
    if [[ $url == - || $digest == - ]]; then
      [[ $url == - && $digest == - ]] ||
        setup_die "${catalog_name}[$tool] must provide both URL and SHA256 or neither" || return
    else
      [[ $url == https://* ]] ||
        setup_die "${catalog_name}[$tool] URL must use HTTPS: $url" || return
      setup_validate_digest "${catalog_name}[$tool] digest" "$digest" || return
    fi
    for previous in "${RELEASE_VERSIONS[@]}"; do
      [[ $previous != "$version" ]] ||
        setup_die "${catalog_name}[$tool] contains duplicate $version" || return
    done
    RELEASE_VERSIONS+=("$version")
  done <<<"${catalog[$tool]}"
  ((${#RELEASE_VERSIONS[@]} > 0)) ||
    setup_die "${catalog_name}[$tool] is empty" || return
}

setup_release_record() {
  local catalog_name=$1
  local tool=$2
  local requested_version=$3
  local record version url digest
  local -n catalog=$catalog_name

  setup_release_versions "$catalog_name" "$tool" || return
  RELEASE_VERSION=
  RELEASE_URL=
  RELEASE_SHA256=
  RELEASE_ASSET=
  while IFS= read -r record || [[ -n $record ]]; do
    [[ -n $record ]] || continue
    IFS='|' read -r version url digest <<<"$record"
    [[ $version == "$requested_version" ]] || continue
    RELEASE_VERSION=$version
    RELEASE_URL=$url
    RELEASE_SHA256=$digest
    RELEASE_ASSET=${url##*/}
    if [[ $tool == python && $url != - ]]; then
      RELEASE_ASSET="cpython-${version}+${PYTHON_STANDALONE_BUILD}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"
    fi
    return 0
  done <<<"${catalog[$tool]}"
  setup_die "${catalog_name}[$tool] has no release $requested_version"
}

setup_release_first() {
  local catalog_name=$1
  local tool=$2

  setup_release_versions "$catalog_name" "$tool" || return
  setup_release_record "$catalog_name" "$tool" "${RELEASE_VERSIONS[0]}"
}

setup_validate_release_catalog() {
  local catalog_name=$1
  shift
  local expected name
  local seen=' '
  local -n catalog=$catalog_name

  declare -p "$catalog_name" 2>/dev/null | grep -q '^declare -A' ||
    setup_die "$catalog_name must be an associative array" || return
  ((${#catalog[@]} == $#)) ||
    setup_die "$catalog_name contains an unexpected number of tools" || return
  for expected in "$@"; do
    [[ -v catalog[$expected] ]] ||
      setup_die "$catalog_name has no releases for $expected" || return
    setup_release_versions "$catalog_name" "$expected" || return
    seen+="$expected "
  done
  for name in "${!catalog[@]}"; do
    [[ $name =~ ^[a-z0-9-]+$ && $seen == *" $name "* ]] ||
      setup_die "$catalog_name contains unsupported tool $name" || return
  done
}

setup_validate_validation_versions() {
  local tool version

  setup_validate_release_catalog VALIDATION_RELEASES \
    actionlint shellcheck stylua zizmor task || return
  for tool in actionlint shellcheck stylua zizmor task; do
    setup_release_versions VALIDATION_RELEASES "$tool" || return
    for version in "${RELEASE_VERSIONS[@]}"; do
      setup_release_record VALIDATION_RELEASES "$tool" "$version" || return
      [[ $RELEASE_URL != - ]] ||
        setup_die "validation release $tool $version requires an artifact" || return
    done
  done
  for version in YAMLLINT_VERSION YAMLLINT_PATHSPEC_VERSION YAMLLINT_PYYAML_VERSION; do
    setup_validate_version "$version" "${!version:-}" || return
  done
}

setup_validate_versions() {
  local plugin record repository commit tool version

  declare -p OFFLINE_TOOLS 2>/dev/null | grep -q '^declare -a' ||
    setup_die 'OFFLINE_TOOLS must be an indexed array' || return
  local expected_tool tool
  local seen_tools=' '
  for tool in "${OFFLINE_TOOLS[@]}"; do
    case $tool in
      nvim | nodejs | python | rg | tmux | oh-my-posh | k9s | zoxide | \
        kubectx | kubens | task | fzf | terraform) ;;
      *) setup_die "OFFLINE_TOOLS contains unsupported tool $tool"; return ;;
    esac
    [[ $seen_tools != *" $tool "* ]] ||
      setup_die "OFFLINE_TOOLS contains duplicate $tool" || return
    seen_tools+="$tool "
  done
  for expected_tool in nvim nodejs python rg tmux oh-my-posh k9s zoxide \
    kubectx kubens task fzf terraform; do
    [[ $seen_tools == *" $expected_tool "* ]] ||
      setup_die "offline profile requires $expected_tool" || return
  done
  ((${#OFFLINE_TOOLS[@]} == 13)) ||
    setup_die 'OFFLINE_TOOLS must contain only the required offline profile' || return

  setup_validate_release_catalog TOOL_RELEASES \
    asdf gh k9s trivy kyverno kubeconform shellcheck rg zoxide uv \
    oh-my-posh kubectx kubens nvim npm python tmux fzf krew terraform \
    kubectl helm nodejs terragrunt || return
  setup_validate_version KUBECTX_VERSION "${KUBECTX_VERSION:-}" || return
  for tool in kubectx kubens; do
    setup_release_versions TOOL_RELEASES "$tool" || return
    ((${#RELEASE_VERSIONS[@]} == 1)) ||
      setup_die "$tool must have exactly one release" || return
    [[ ${RELEASE_VERSIONS[0]} == "$KUBECTX_VERSION" ]] ||
      setup_die "$tool must use KUBECTX_VERSION" || return
  done
  for tool in kubectl helm; do
    setup_release_versions TOOL_RELEASES "$tool" || return
    for version in "${RELEASE_VERSIONS[@]}"; do
      setup_release_record TOOL_RELEASES "$tool" "$version" || return
      [[ $RELEASE_URL != - ]] ||
        setup_die "$tool $version requires a direct artifact" || return
    done
  done
  for tool in nvim nodejs python rg tmux oh-my-posh k9s zoxide kubectx \
    kubens fzf terraform; do
    setup_release_first TOOL_RELEASES "$tool" || return
    [[ $RELEASE_URL != - ]] ||
      setup_die "offline default $tool $RELEASE_VERSION requires an artifact" || return
  done
  setup_validate_version PIP_TOOLS_VERSION "${PIP_TOOLS_VERSION:-}" || return
  [[ $PYTHON_STANDALONE_BUILD =~ ^[0-9]{8}$ ]] ||
    setup_die 'PYTHON_STANDALONE_BUILD must use YYYYMMDD' || return
  declare -p ASDF_TOOLS 2>/dev/null | grep -q '^declare -a' ||
    setup_die 'ASDF_TOOLS must be an indexed array' || return
  declare -p ASDF_PLUGINS 2>/dev/null | grep -q '^declare -A' ||
    setup_die 'ASDF_PLUGINS must be an associative array' || return
  ((${#ASDF_TOOLS[@]} == 6 && ${#ASDF_PLUGINS[@]} == 6)) ||
    setup_die 'ASDF tool and plugin profiles must contain six tools' || return
  local asdf_seen=' '
  for tool in "${ASDF_TOOLS[@]}"; do
    case $tool in terraform | kubectl | helm | python | nodejs | terragrunt) ;; *)
      setup_die "ASDF_TOOLS contains unsupported tool $tool"; return ;; esac
    [[ $asdf_seen != *" $tool "* ]] ||
      setup_die "ASDF_TOOLS contains duplicate $tool" || return
    asdf_seen+="$tool "
    [[ -v ASDF_PLUGINS[$tool] ]] ||
      setup_die "ASDF_PLUGINS has no entry for $tool" || return
    record=${ASDF_PLUGINS[$tool]}
    [[ $record != *[[:space:]]* && ${record//[^|]/} == '|' ]] ||
      setup_die "ASDF_PLUGINS[$tool] must contain repository|commit" || return
    IFS='|' read -r repository commit <<<"$record"
    [[ $repository == https://*.git ]] ||
      setup_die "ASDF_PLUGINS[$tool] has an invalid repository" || return
    setup_validate_commit "ASDF_PLUGINS[$tool] commit" "$commit" || return
  done
  for plugin in "${!ASDF_PLUGINS[@]}"; do
    [[ $asdf_seen == *" $plugin "* ]] ||
      setup_die "ASDF_PLUGINS contains unsupported plugin $plugin" || return
  done
  for commit in "$TPM_COMMIT" "$TMUX_SENSIBLE_COMMIT" \
    "$TMUX_RESURRECT_COMMIT" "$TMUX_CONTINUUM_COMMIT"; do
    setup_validate_commit 'tmux plugin commit' "$commit" || return
  done
}

setup_verify_sha256() {
  local path=$1
  local digest=$2

  printf '%s  %s\n' "$digest" "$path" | sha256sum --check --strict >/dev/null
}

setup_download() {
  local url=$1
  local destination=$2

  curl --fail --location --silent --show-error \
    --connect-timeout 15 --max-time 900 --retry 3 --retry-all-errors \
    --output "$destination" "$url"
}

setup_artifact_layout() {
  local name=$1
  local version=$2
  local asset=$3

  [[ $asset =~ ^[0-9A-Za-z][0-9A-Za-z._+%-]*$ ]] ||
    setup_die "unsafe artifact name for $name $version: $asset" || return
  # Consumed by callers after sourcing this library.
  # shellcheck disable=SC2034
  SPEC_ASSET=$asset
  SPEC_DESTS=()
  SPEC_LINKS=()
  SPEC_SECOND_MEMBER=
  case $name in
    asdf)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=asdf
      SPEC_DESTS=("asdf-$version")
      SPEC_LINKS=("asdf:asdf-$version")
      ;;
    gh)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="gh_${version}_linux_amd64/bin/gh"
      SPEC_DESTS=("gh-$version")
      SPEC_LINKS=("gh:gh-$version")
      ;;
    kyverno)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=kyverno
      SPEC_DESTS=("kyverno-$version")
      SPEC_LINKS=("kyverno:kyverno-$version")
      ;;
    task)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=task
      SPEC_DESTS=("task-$version")
      SPEC_LINKS=("task:task-$version")
      ;;
    trivy)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=trivy
      SPEC_DESTS=("trivy-$version")
      SPEC_LINKS=("trivy:trivy-$version")
      ;;
    k9s)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=k9s
      SPEC_DESTS=("k9s-$version")
      SPEC_LINKS=("k9s:k9s-$version")
      ;;
    kubeconform)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=kubeconform
      SPEC_DESTS=("kubeconform-$version")
      SPEC_LINKS=("kubeconform:kubeconform-$version")
      ;;
    shellcheck)
      SPEC_FORMAT=xz-member
      SPEC_MEMBER="shellcheck-v${version}/shellcheck"
      SPEC_DESTS=("shellcheck-$version")
      SPEC_LINKS=("shellcheck:shellcheck-$version")
      ;;
    oh-my-posh)
      SPEC_FORMAT=raw
      SPEC_MEMBER=
      SPEC_DESTS=("oh-my-posh-$version")
      SPEC_LINKS=("oh-my-posh:oh-my-posh-$version")
      ;;
    kubectx | kubens)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=$name
      SPEC_DESTS=("$name-$version")
      SPEC_LINKS=("$name:$name-$version")
      ;;
    rg)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER="ripgrep-${version}-x86_64-unknown-linux-musl/rg"
      SPEC_DESTS=("rg-$version")
      SPEC_LINKS=("rg:rg-$version")
      ;;
    zoxide)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=zoxide
      SPEC_DESTS=("zoxide-$version")
      SPEC_LINKS=("zoxide:zoxide-$version")
      ;;
    uv)
      SPEC_FORMAT=gz-pair
      SPEC_MEMBER=uv-x86_64-unknown-linux-gnu/uv
      SPEC_SECOND_MEMBER=uv-x86_64-unknown-linux-gnu/uvx
      SPEC_DESTS=("uv-$version" "uvx-$version")
      SPEC_LINKS=("uv:uv-$version" "uvx:uvx-$version")
      ;;
    nvim)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=nvim-linux-x86_64
      SPEC_DESTS=("nvim-$version")
      SPEC_LINKS=("nvim:nvim-$version/bin/nvim")
      ;;
    kubectl)
      SPEC_FORMAT=raw
      SPEC_MEMBER=
      SPEC_DESTS=("kubectl-$version")
      SPEC_LINKS=("kubectl:kubectl-$version")
      ;;
    helm)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=linux-amd64/helm
      SPEC_DESTS=("helm-$version")
      SPEC_LINKS=("helm:helm-$version")
      ;;
    nodejs)
      SPEC_FORMAT=xz-tree
      SPEC_MEMBER="node-v${version}-linux-x64"
      SPEC_DESTS=("node-$version")
      SPEC_LINKS=()
      ;;
    npm)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=package
      SPEC_DESTS=(npm-package)
      SPEC_LINKS=()
      ;;
    python)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER=python
      SPEC_DESTS=("python-$version")
      SPEC_LINKS=()
      ;;
    fzf)
      SPEC_FORMAT=gz-member
      SPEC_MEMBER=fzf
      SPEC_DESTS=("fzf-$version")
      SPEC_LINKS=()
      ;;
    terraform)
      SPEC_FORMAT=zip-member
      SPEC_MEMBER=terraform
      SPEC_DESTS=("terraform-$version")
      SPEC_LINKS=()
      ;;
    tmux)
      SPEC_FORMAT=gz-tree
      SPEC_MEMBER="tmux-$version"
      SPEC_DESTS=("tmux-$version")
      # setup-tools does not install tmux, but release artifact preparation does.
      # shellcheck disable=SC2034
      SPEC_LINKS=()
      ;;
    *) setup_die "missing artifact mapping for $name" ;;
  esac
}

setup_validate_tar_archive() {
  local archive=$1 compression=$2 subtree=${3:-}
  local member line type remainder name target resolved listing verbose
  local -a list_args=(-tf) verbose_args=(-tvf)

  case $compression in
    gz) list_args=(-tzf); verbose_args=(-tvzf) ;;
    xz) list_args=(-tJf); verbose_args=(-tvJf) ;;
    *) setup_die "unsupported tar compression: $compression"; return ;;
  esac
  listing=$(tar "${list_args[@]}" "$archive") || return
  while IFS= read -r member || [[ -n $member ]]; do
    [[ -n $member && $member != /* && $member != ../* && /$member/ != *'/../'* ]] ||
      { setup_die "unsafe archive member: $member"; return 1; }
    if [[ -n $subtree ]]; then
      [[ $member == "$subtree" || $member == "$subtree/"* ]] ||
        { setup_die "unexpected archive member: $member"; return 1; }
    fi
  done <<<"$listing"
  verbose=$(LC_ALL=C tar --numeric-owner --quoting-style=literal \
    "${verbose_args[@]}" "$archive") || return
  while IFS= read -r line || [[ -n $line ]]; do
    type=${line:0:1}
    case $type in
      - | d) ;;
      l)
        read -r _ _ _ _ _ remainder <<<"$line"
        [[ $remainder == *' -> '* ]] || { setup_die "cannot parse archive link: $line"; return 1; }
        name=${remainder% -> *}
        target=${remainder##* -> }
        [[ $target != /* ]] || { setup_die "absolute archive link: $name -> $target"; return 1; }
        resolved=$(readlink -m -- "/archive/$(dirname -- "$name")/$target")
        [[ $resolved == /archive/* ]] || { setup_die "archive link escapes its root: $name -> $target"; return 1; }
        if [[ -n $subtree ]]; then
          [[ $resolved == "/archive/$subtree" || $resolved == "/archive/$subtree/"* ]] ||
            { setup_die "archive link escapes expected subtree: $name -> $target"; return 1; }
        fi
        ;;
      h) setup_die "archive hard links are not supported: $line"; return 1 ;;
      *) setup_die "archive contains an unsupported member type: $line"; return 1 ;;
    esac
  done <<<"$verbose"
}

setup_archive_member_to_file() {
  local archive=$1 format=$2 member=$3 output=$4

  case $format in
    gz-member | gz-pair) tar -xOzf "$archive" -- "$member" >"$output" ;;
    xz-member) tar -xOJf "$archive" -- "$member" >"$output" ;;
    *) setup_die "invalid member format: $format"; return ;;
  esac
  chmod 0755 "$output"
}

setup_extract_artifact() {
  local archive=$1 destination=$2

  case $SPEC_FORMAT in
    raw)
      install -m 0755 "$archive" "$destination/${SPEC_DESTS[0]}"
      ;;
    gz-member | xz-member)
      setup_validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}"
      setup_archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}"
      ;;
    gz-pair)
      setup_validate_tar_archive "$archive" gz
      setup_archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_MEMBER" \
        "$destination/${SPEC_DESTS[0]}"
      setup_archive_member_to_file "$archive" "$SPEC_FORMAT" "$SPEC_SECOND_MEMBER" \
        "$destination/${SPEC_DESTS[1]}"
      ;;
    gz-tree)
      setup_validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" "$SPEC_MEMBER"
      tar -xzf "$archive" -C "$destination" \
        --no-same-owner --no-same-permissions --keep-directory-symlink -- "$SPEC_MEMBER"
      if [[ $SPEC_MEMBER != "${SPEC_DESTS[0]}" ]]; then
        mv -- "$destination/$SPEC_MEMBER" "$destination/${SPEC_DESTS[0]}"
      fi
      ;;
    xz-tree)
      setup_validate_tar_archive "$archive" "${SPEC_FORMAT%%-*}" "$SPEC_MEMBER"
      tar -xJf "$archive" -C "$destination" \
        --no-same-owner --no-same-permissions --keep-directory-symlink -- "$SPEC_MEMBER"
      if [[ $SPEC_MEMBER != "${SPEC_DESTS[0]}" ]]; then
        mv -- "$destination/$SPEC_MEMBER" "$destination/${SPEC_DESTS[0]}"
      fi
      ;;
    zip-member)
      unzip -p "$archive" "$SPEC_MEMBER" >"$destination/${SPEC_DESTS[0]}"
      chmod 0755 "$destination/${SPEC_DESTS[0]}"
      ;;
    *) setup_die "invalid artifact format: $SPEC_FORMAT" ;;
  esac
}

setup_prepare_artifact() {
  local catalog_name=$1 name=$2 version=$3 archive=$4 destination=$5

  setup_release_record "$catalog_name" "$name" "$version" || return
  [[ $RELEASE_URL != - ]] ||
    setup_die "$name $version has no direct artifact" || return
  setup_artifact_layout "$name" "$version" "$RELEASE_ASSET" || return
  [[ -f $archive && ! -L $archive ]] || setup_die "missing artifact: $archive" || return
  setup_verify_sha256 "$archive" "$RELEASE_SHA256"
  mkdir -p "$destination"
  setup_extract_artifact "$archive" "$destination"
}

setup_system_package_list() {
  local platform=$1
  local role=$2
  local -a runtime_common=(
    bash
    ca-certificates
    coreutils
    diffutils
    findutils
    gawk
    git
    grep
    gzip
    ncurses-term
    sed
    tar
    unzip
    util-linux
  )
  local -a build_common=(
    autoconf
    automake
    bison
    curl
    file
    libtool
    make
    patch
  )
  local -a connected_common=(
    autoconf
    automake
    bash-completion
    bison
    curl
    dos2unix
    file
    htop
    jq
    libtool
    make
    mc
    patch
    python3
    python3-pip
    tmux
  )
  local -a runtime_platform=()
  local -a role_common=()
  local -a role_platform=()

  case $platform in
    debian:* | ubuntu:* | debian-*-x86_64 | ubuntu-*-x86_64)
      runtime_platform=(
        iproute2
        libevent-core-2.1-7t64
        libtinfo6
        ncurses-bin
        passwd
        xz-utils
      )
      case $role in
        runtime) ;;
        build)
          role_common=("${build_common[@]}")
          role_platform=(
            build-essential
            libevent-dev
            libncurses-dev
            pkg-config
          )
          ;;
        connected)
          role_common=("${connected_common[@]}")
          role_platform=(
            build-essential
            dirmngr
            gnupg
            libbz2-dev
            libevent-dev
            libffi-dev
            liblzma-dev
            libncurses-dev
            libreadline-dev
            libssl-dev
            libsqlite3-dev
            pkg-config
            python3-venv
            tk-dev
            uuid-dev
            vim
            zlib1g-dev
          )
          ;;
        *) setup_die "unknown system package role: $role"; return ;;
      esac
      ;;
    amzn:2023 | amzn-2023-x86_64)
      runtime_platform=(
        iproute
        libevent
        ncurses-libs
        shadow-utils
        which
        xz
      )
      case $role in
        runtime) ;;
        build)
          role_common=("${build_common[@]}")
          role_platform=(
            cargo
            clang-devel
            gcc
            gcc-c++
            libevent-devel
            ncurses-devel
            pkgconf
          )
          ;;
        connected)
          role_common=("${connected_common[@]}")
          role_platform=(
            bzip2-devel
            gcc
            gcc-c++
            libevent-devel
            libffi-devel
            ncurses-devel
            openssl-devel
            pkgconf
            readline-devel
            sqlite-devel
            tk-devel
            vim-enhanced
            vim-minimal
            xz-devel
            zlib-devel
          )
          ;;
        *) setup_die "unknown system package role: $role"; return ;;
      esac
      ;;
    *) setup_die "unsupported system package platform: $platform"; return ;;
  esac
  # Consumed by setup-system or dotfiles-release after sourcing this library.
  # shellcheck disable=SC2034
  SETUP_SYSTEM_PACKAGES=(
    "${runtime_common[@]}"
    "${runtime_platform[@]}"
    "${role_common[@]}"
    "${role_platform[@]}"
  )
}

setup_install_system_packages() {
  local platform=$1 role=$2 no_recommends=$3
  shift 3
  local -a root_command=("$@")
  local -a install_args=(install -y)

  setup_system_package_list "$platform" "$role" || return
  case $platform in
    debian:* | ubuntu:* | debian-*-x86_64 | ubuntu-*-x86_64)
      [[ $no_recommends != true ]] || install_args+=(--no-install-recommends)
      "${root_command[@]}" env DEBIAN_FRONTEND=noninteractive apt-get update || return
      "${root_command[@]}" env DEBIAN_FRONTEND=noninteractive apt-get \
        "${install_args[@]}" "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
    amzn:2023 | amzn-2023-x86_64)
      if [[ $role == connected ]]; then
        if rpm -q gnupg2-minimal >/dev/null 2>&1; then
          "${root_command[@]}" dnf swap -y gnupg2-minimal gnupg2 || return
        else
          "${root_command[@]}" dnf install -y gnupg2 || return
        fi
      fi
      "${root_command[@]}" dnf install -y --allowerasing \
        "${SETUP_SYSTEM_PACKAGES[@]}"
      ;;
    *) setup_die "unsupported system package platform: $platform" ;;
  esac
}
