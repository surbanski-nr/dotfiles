#!/usr/bin/bash

p=3.14
i=0

cleanup() {
  stty echo 2>/dev/null || true
  setterm --cursor on 2>/dev/null || true
  printf '\033[0m'
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

stty -echo
setterm --cursor off

while true; do
  i=$(bc -l <<< "$i+0.04")
  r=$(bc -l <<< "128+127*s($i)")
  g=$(bc -l <<< "128+127*s($i+$p*(1/3))")
  b=$(bc -l <<< "128+127*s($i+$p*(2/3))")
  printf '\033[48;2;%s;%s;%sm\n' "${r%%.*}" "${g%%.*}" "${b%%.*}"
  sleep .01
done
