#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'validate: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'usage: validate {bash|configs|nvim2|old-nvim|repo|scripts|workflows}' \
    >&2
  exit 2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

repo_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tools_dir=${VALIDATION_TOOLS_DIR:-$repo_dir/.cache/validation-tools}
cleanup_paths=()
cleanup_tmux_home=
cleanup_tmux_socket=
cleanup_tmux_client_pid=
export PATH="$tools_dir/bin:$PATH"
cd "$repo_dir"

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  if [[ -n $cleanup_tmux_client_pid ]]; then
    kill "$cleanup_tmux_client_pid" 2>/dev/null
    wait "$cleanup_tmux_client_pid" 2>/dev/null
  fi
  if [[ -n $cleanup_tmux_home && -n $cleanup_tmux_socket ]] &&
    command -v tmux >/dev/null 2>&1; then
    HOME="$cleanup_tmux_home" tmux -L "$cleanup_tmux_socket" \
      kill-server >/dev/null 2>&1
  fi
  for path in "${cleanup_paths[@]}"; do
    [[ -e $path ]] && find "$path" -depth -delete
  done
  exit "$status"
}
trap cleanup EXIT

check_shell_syntax() {
  local interpreter=$1
  local file
  shift

  for file in "$@"; do
    printf '%s -n: %s\n' "$interpreter" "$file"
    "$interpreter" -n "$file"
  done
}

check_markdown_bash() {
  local document
  local block_file=
  local block_start=0
  local line
  local line_number=0
  local temporary_dir

  temporary_dir=$(mktemp -d)
  cleanup_paths+=("$temporary_dir")
  for document in "$@"; do
    [[ -f $document ]] || continue
    block_file=
    line_number=0
    while IFS= read -r line || [[ -n $line ]]; do
      ((line_number += 1))
      if [[ -z $block_file && $line == '```bash' ]]; then
        block_start=$((line_number + 1))
        block_file="$temporary_dir/block-${document//\//_}-$block_start.sh"
        : >"$block_file"
      elif [[ -n $block_file && $line == '```' ]]; then
        if ! bash -n "$block_file"; then
          die "invalid Bash syntax in $document block starting at line $block_start"
        fi
        block_file=
      elif [[ -n $block_file ]]; then
        printf '%s\n' "$line" >>"$block_file"
      fi
    done <"$document"
    [[ -z $block_file ]] ||
      die "unterminated Bash block in $document at line $block_start"
  done
}

validate_bash() {
  need bash
  need shellcheck
  need timeout
  local files=(
    bash/.bashrc
    bash/.bash_profile
    bash/.bash_aliases
    tests/bash_test.sh
  )

  check_shell_syntax bash "${files[@]}" dotfiles-release.env validation.env versions.env
  check_markdown_bash README.md SETUP.md TOOL_UPDATES.md \
    nvim2/.config/nvim2/offline-releases.md
  shellcheck --shell=bash --external-sources --source-path=SCRIPTDIR \
    "${files[@]}"
  timeout 120s bash tests/bash_test.sh
}

validate_scripts() {
  need bash
  need git
  need jq
  need sha256sum
  need sh
  need shellcheck
  need tar
  need timeout
  local bash_files=()
  local files=(
    bstow
    setup-asdf
    setup-system
    setup-tools
    vim/setup
    tests/bstow_test.sh
    tests/install_validation_tool_test.sh
    tests/dotfiles_release_test.sh
    tests/scripts_test.sh
    tests/setup_asdf_test.sh
    tests/setup_system_test.sh
    tests/setup_tools_test.sh
    tests/validate_test.sh
  )
  local first_line
  local posix_files=()

  while IFS= read -r -d '' file; do
    files+=("$file")
  done < <(find scripts -maxdepth 1 -type f -print0 | sort -z)
  if [[ -d tests/fixtures ]]; then
    while IFS= read -r -d '' file; do
      files+=("$file")
    done < <(find tests/fixtures -type f -print0 | sort -z)
  fi

  for file in "${files[@]}"; do
    IFS= read -r first_line <"$file" || true
    case "$first_line" in
      *bash*) bash_files+=("$file") ;;
      '#!/bin/sh') posix_files+=("$file") ;;
      *) die "unsupported or missing shell shebang: $file" ;;
    esac
  done

  check_shell_syntax bash "${bash_files[@]}"
  check_shell_syntax sh "${posix_files[@]}"
  for file in "${files[@]}"; do
    if [[ $file == tests/fixtures/bash/scenario ]]; then
      shellcheck --exclude=SC1091 "$file"
    else
      shellcheck --external-sources --source-path=SCRIPTDIR "$file"
    fi
  done
  timeout 120s bash tests/bstow_test.sh
  timeout 30s bash tests/install_validation_tool_test.sh
  timeout 300s bash tests/dotfiles_release_test.sh
  timeout 120s bash tests/scripts_test.sh
  timeout 30s bash tests/setup_asdf_test.sh
  timeout 30s bash tests/setup_system_test.sh
  timeout 120s bash tests/setup_tools_test.sh
}

validate_nvim2() {
  need bash
  need jq
  need shellcheck
  need stylua
  local check_script=nvim2/.config/nvim2/tests/check.sh
  local lock_file=nvim2/.config/nvim2/nvim-pack-lock.json

  stylua --check \
    --config-path nvim2/.config/nvim2/.stylua.toml \
    nvim2/.config/nvim2
  bash -n "$check_script"
  shellcheck "$check_script"
  jq -e '
    type == "object" and
    (keys == ["plugins"]) and
    (.plugins | type == "object" and length > 0) and
    ([.plugins | to_entries[] | . as $plugin |
      ($plugin.key | type == "string" and length > 0) and
      ($plugin.value | type == "object") and
      ($plugin.value.src | type == "string" and
        test("^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")) and
      ($plugin.value.rev | type == "string" and test("^[0-9a-f]{40}$"))
    ] | all)
  ' "$lock_file" >/dev/null
}

validate_old_nvim() {
  need stylua
  stylua --check \
    --config-path old-nvim/.config/old-nvim/stylua.toml \
    old-nvim/.config/old-nvim
}

validate_configs() {
  need git
  need jq
  need script
  need tmux
  need yamllint
  local json_files=()
  local socket="dotfiles-validate-$$"
  local client configured_path reloaded_value tmux_config temporary_home
  local client_input client_stderr
  local plugin tpm_root
  local yaml_files=()

  while IFS= read -r -d '' file; do
    [[ -f $file ]] || continue
    case "$file" in
      *.yml | *.yaml)
        [[ $file == .github/workflows/* ]] || yaml_files+=("$file")
        ;;
    esac
  done < <(git ls-files --cached --others --exclude-standard -z | sort -z)
  yamllint --strict --config-file .yamllint.yml "${yaml_files[@]}"

  while IFS= read -r -d '' file; do
    [[ -f $file ]] || continue
    [[ $file == *.json ]] && json_files+=("$file")
  done < <(git ls-files --cached --others --exclude-standard -z | sort -z)
  for file in "${json_files[@]}"; do
    jq empty "$file"
  done

  git config --file git/.gitconfig --null --list >/dev/null
  for plugin in tpm tmux-sensible tmux-resurrect tmux-continuum; do
    git grep -q -e "^set -g @plugin 'tmux-plugins/$plugin'$" -- tmux/.tmux.conf ||
      die "tmux plugin is not declared at top level: $plugin"
  done

  temporary_home=$(mktemp -d)
  cleanup_paths+=("$temporary_home")
  cleanup_tmux_home=$temporary_home
  cleanup_tmux_socket=$socket
  tmux_config=$temporary_home/explicit.tmux.conf
  cp "$repo_dir/tmux/.tmux.conf" "$tmux_config"
  (
    unset TMUX TMUX_OFFLINE_RELEASE_ROOT TMUX_PLUGIN_MANAGER_PATH
    HOME="$temporary_home" timeout 10s tmux -L "$socket" \
      -f "$tmux_config" new-session -d
  )
  HOME="$temporary_home" tmux -L "$socket" show-options -gv prefix >/dev/null
  HOME="$temporary_home" tmux -L "$socket" show-options -gv status-right >/dev/null
  configured_path=$(HOME="$temporary_home" tmux -L "$socket" show-options -gv @dotfiles-config)
  [[ $configured_path == "$tmux_config" ]] ||
    die "tmux reload path does not preserve explicit -f config: $configured_path"
  tpm_root=$(HOME="$temporary_home" tmux -L "$socket" show-options -gv @dotfiles-tpm-root)
  [[ $tpm_root == "$temporary_home/.tmux/plugins/tpm" ]] ||
    die "tmux default TPM root is incorrect: $tpm_root"
  mkdir -p "$temporary_home/custom-plugins/tpm"
  cp tests/fixtures/validation/tpm "$temporary_home/custom-plugins/tpm/tpm"
  HOME="$temporary_home" tmux -L "$socket" set-environment -g \
    TMUX_PLUGIN_MANAGER_PATH "$temporary_home/custom-plugins"
  HOME="$temporary_home" tmux -L "$socket" set-option -g status-position bottom
  client_input=$temporary_home/client-input
  client_stderr=$temporary_home/client-stderr
  mkfifo "$client_input"
  exec {client_input_fd}<>"$client_input"
  HOME="$temporary_home" TERM=xterm-256color timeout 10s \
    script -qefc "tmux -L $socket attach-session" /dev/null \
    <"$client_input" >/dev/null 2>"$client_stderr" &
  cleanup_tmux_client_pid=$!
  client=
  for _ in {1..50}; do
    client=$(HOME="$temporary_home" tmux -L "$socket" \
      list-clients -F '#{client_name}' 2>/dev/null | head -n 1)
    [[ -n $client ]] && break
    sleep 0.02
  done
  [[ -n $client ]] || die 'tmux validation client did not attach'
  HOME="$temporary_home" tmux -L "$socket" send-keys -K -c "$client" C-a R
  reloaded_value=
  for _ in {1..50}; do
    reloaded_value=$(HOME="$temporary_home" tmux -L "$socket" \
      show-options -gqv @validation-tpm-command 2>/dev/null || true)
    [[ $reloaded_value == "$temporary_home/custom-plugins/tpm/tpm" ]] && break
    sleep 0.02
  done
  [[ $reloaded_value == "$temporary_home/custom-plugins/tpm/tpm" ]] ||
    die 'tmux Shift-R did not run the custom TPM command'
  reloaded_value=$(HOME="$temporary_home" tmux -L "$socket" show-options -gv status-position)
  [[ $reloaded_value == top ]] || die 'tmux Shift-R did not apply the configured file'
  tpm_root=$(HOME="$temporary_home" tmux -L "$socket" show-options -gv @dotfiles-tpm-root)
  [[ $tpm_root == "$temporary_home/custom-plugins/tpm" ]] ||
    die "tmux custom TPM root is incorrect after reload: $tpm_root"
  [[ ! -s $client_stderr ]] || die 'tmux reload client wrote to stderr'
  HOME="$temporary_home" tmux -L "$socket" detach-client -t "$client"
  exec {client_input_fd}>&-
  wait "$cleanup_tmux_client_pid"
  cleanup_tmux_client_pid=
}

validate_workflows() {
  need actionlint
  need shellcheck
  need yamllint
  need zizmor
  local token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
  local discovered_token

  actionlint -color
  yamllint --strict --config-file .yamllint.yml .github/workflows
  if [[ -z $token ]] && command -v gh >/dev/null 2>&1; then
    if discovered_token=$(gh auth token 2>/dev/null); then
      token=$discovered_token
    fi
  fi
  if [[ -n $token ]]; then
    GH_TOKEN=$token zizmor --persona=pedantic \
      --config zizmor.yml .
  else
    zizmor --offline --persona=pedantic \
      --config zizmor.yml .
  fi
}

validate_repo() {
  local base=${VALIDATE_BASE_SHA:-}
  local image
  local variable

  check_shell_syntax bash dotfiles-release.env validation.env versions.env
  # shellcheck source=../versions.env
  source versions.env
  # shellcheck source=setup-lib
  source scripts/setup-lib
  SETUP_PROGRAM=validate
  setup_validate_versions
  # shellcheck source=../dotfiles-release.env
  source dotfiles-release.env
  for variable in DEBIAN_13_IMAGE UBUNTU_2404_IMAGE UBUNTU_2604_IMAGE \
    AMZN_2023_IMAGE; do
    image=${!variable}
    [[ $image =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]] ||
      die "$variable is not pinned to a SHA-256 digest"
  done
  if rg -uu --quiet --pcre2 \
    'nvim2-release(?!-rollback[.]env)|NVIM2_RELEASE|TARGET_(USER|UID|HOME)' \
    scripts/dotfiles-release dotfiles-release.env .github/workflows/dotfiles-release.yml; then
    die 'offline release files retain a legacy name or baked target identity'
  fi

  [[ ! -x scripts/setup-lib ]] || die 'source-only library is executable: scripts/setup-lib'
  for file in scripts/* tests/fixtures/*/* \
    bstow vim/setup nvim2/.config/nvim2/tests/check.sh; do
    [[ $file == scripts/setup-lib ]] && continue
    [[ -x $file ]] || die "executable bit is missing: $file"
  done

  timeout 120s bash tests/validate_test.sh

  if [[ $base =~ ^[0-9a-f]{40}$ ]] &&
    [[ $base != 0000000000000000000000000000000000000000 ]] &&
    git cat-file -e "$base^{commit}" 2>/dev/null; then
    git diff --check "$base" HEAD --
  else
    git diff --check HEAD --
  fi
}

case ${1:-} in
  bash) validate_bash ;;
  configs) validate_configs ;;
  nvim2) validate_nvim2 ;;
  old-nvim) validate_old_nvim ;;
  repo) validate_repo ;;
  scripts) validate_scripts ;;
  workflows) validate_workflows ;;
  *) usage ;;
esac
