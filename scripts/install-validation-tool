#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'install-validation-tool: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 1 ]] || die 'usage: install-validation-tool TOOL'

repo_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tools_dir=${VALIDATION_TOOLS_DIR:-$repo_dir/.cache/validation-tools}
bin_dir=$tools_dir/bin
tool=$1

# shellcheck source=setup-lib
source "$repo_dir/scripts/setup-lib"
SETUP_PROGRAM=install-validation-tool
# shellcheck source=../validation.env
source "$repo_dir/validation.env"
setup_validate_validation_versions

mkdir -p "$bin_dir"
export PATH="$bin_dir:$PATH"

tool_version() {
  local executable=$2

  case "$1" in
    actionlint) "$executable" -version 2>/dev/null | head -n 1 ;;
    shellcheck) "$executable" --version 2>/dev/null | awk '/^version:/ { print $2 }' ;;
    stylua) "$executable" --version 2>/dev/null | awk '{ print $2 }' ;;
    task) "$executable" --version 2>/dev/null | awk '{ sub(/^v/, "", $NF); print $NF }' ;;
    yamllint) "$executable" --version 2>/dev/null | awk '{ print $2 }' ;;
    zizmor) "$executable" --version 2>/dev/null | awk '{ print $2 }' ;;
    *) die "unsupported tool: $1" ;;
  esac
}

case $tool in
  actionlint | shellcheck | stylua | task | zizmor)
    setup_release_first VALIDATION_RELEASES "$tool"
    version=$RELEASE_VERSION
    url=$RELEASE_URL
    checksum=$RELEASE_SHA256
    ;;
  yamllint) version=$YAMLLINT_VERSION ;;
  *) die "unsupported tool: $tool" ;;
esac
if [[ -x $bin_dir/$tool ]] &&
  [[ $(tool_version "$tool" "$bin_dir/$tool") == "$version" ]]; then
  exit 0
fi

[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] ||
  die 'automatic tool installation supports Linux x86_64 only'

stage=$(mktemp -d "$tools_dir/install-$tool.XXXXXX")
staged_venv=
cleanup() {
  [[ -z $staged_venv || ! -e $staged_venv ]] ||
    find "$staged_venv" -depth -delete
  find "$stage" -depth -delete
}
trap cleanup EXIT

download() {
  local url=$1
  local checksum=$2
  local destination=$3

  curl --connect-timeout 30 --max-time 300 \
    --retry 3 --retry-all-errors -fL "$url" -o "$destination"
  printf '%s  %s\n' "$checksum" "$destination" |
    sha256sum --check --strict
}

activate_binary() {
  local candidate=$1
  local destination=$bin_dir/$tool
  local previous=$stage/previous-$tool
  local previous_exists=0

  install -m 0755 "$candidate" "$stage/$tool.candidate"
  candidate=$stage/$tool.candidate
  [[ $(tool_version "$tool" "$candidate") == "$version" ]] ||
    die "$tool $version candidate validation failed"

  if [[ -e $destination || -L $destination ]]; then
    cp -a "$destination" "$previous"
    previous_exists=1
  fi
  mv -f "$candidate" "$destination"
  if [[ $(tool_version "$tool" "$destination") == "$version" ]]; then
    return 0
  fi

  rm -f "$destination"
  if ((previous_exists)); then
    mv "$previous" "$destination"
  fi
  die "$tool $version activation failed; restored the previous executable"
}

activate_yamllint() {
  local candidate=$1
  local destination=$bin_dir/yamllint
  local link=$stage/yamllint-link
  local previous=$stage/previous-yamllint
  local previous_exists=0

  [[ $(tool_version yamllint "$candidate/bin/yamllint") == "$version" ]] ||
    die "yamllint $version candidate validation failed"
  ln -s "$candidate/bin/yamllint" "$link"

  if [[ -e $destination || -L $destination ]]; then
    cp -a "$destination" "$previous"
    previous_exists=1
  fi
  mv -Tf "$link" "$destination"
  if [[ $(tool_version yamllint "$destination") == "$version" ]]; then
    staged_venv=
    return 0
  fi

  rm -f "$destination"
  if ((previous_exists)); then
    mv "$previous" "$destination"
  fi
  die "yamllint $version activation failed; restored the previous environment"
}

case "$tool" in
  actionlint)
    archive="$stage/actionlint.tar.gz"
    download "$url" "$checksum" "$archive"
    tar -xzf "$archive" -C "$stage"
    activate_binary "$stage/actionlint"
    ;;
  shellcheck)
    archive="$stage/shellcheck.tar.xz"
    download "$url" "$checksum" "$archive"
    tar -xJf "$archive" -C "$stage"
    activate_binary "$stage/shellcheck-v$version/shellcheck"
    ;;
  stylua)
    archive="$stage/stylua.zip"
    download "$url" "$checksum" "$archive"
    unzip -q "$archive" -d "$stage"
    activate_binary "$stage/stylua"
    ;;
  task)
    archive="$stage/task.tar.gz"
    download "$url" "$checksum" "$archive"
    tar -xzf "$archive" -C "$stage"
    activate_binary "$stage/task"
    ;;
  yamllint)
    venv="$tools_dir/yamllint-$YAMLLINT_VERSION"
    if [[ -e $venv || -L $venv ]]; then
      venv=$tools_dir/yamllint-$YAMLLINT_VERSION-${stage##*.}
    fi
    staged_venv=$venv
    python3 -m venv "$venv"
    "$venv/bin/python" -m pip install --disable-pip-version-check \
      "pathspec==$YAMLLINT_PATHSPEC_VERSION" \
      "PyYAML==$YAMLLINT_PYYAML_VERSION" \
      "yamllint==$YAMLLINT_VERSION"
    activate_yamllint "$venv"
    ;;
  zizmor)
    archive="$stage/zizmor.tar.gz"
    download "$url" "$checksum" "$archive"
    tar -xzf "$archive" -C "$stage"
    activate_binary "$stage/zizmor"
    ;;
esac

[[ $(tool_version "$tool" "$bin_dir/$tool") == "$version" ]] ||
  die "$tool $version installation failed"
