#!/usr/bin/env bash

set -euo pipefail

die() {
  printf 'install-validation-tool: %s\n' "$*" >&2
  exit 1
}

[[ $# -eq 1 ]] || die 'usage: install-validation-tool TOOL'

repo_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
tools_dir=${VALIDATION_TOOLS_DIR:-$repo_dir/bin}
tool=$1

# shellcheck source=setup-lib
source "$repo_dir/scripts/setup-lib"
# shellcheck source=../validation.env
source "$repo_dir/validation.env"
validate_validation_config

supported=false
for configured_tool in "${VALIDATION_TOOLS[@]}"; do
  if [[ $tool == "$configured_tool" ]]; then
    supported=true
    break
  fi
done
[[ $supported == true ]] || die "unsupported tool: $tool"

mkdir -p "$tools_dir"
export PATH="$tools_dir:$PATH"

tool_version() {
  local executable=$1 output

  output=$("$executable" --version 2>/dev/null) || return
  [[ $output =~ v?([0-9]+([.][0-9]+){1,3}([0-9A-Za-z.+-]*[0-9A-Za-z])?) ]] || return
  printf '%s\n' "${BASH_REMATCH[1]}"
}

if [[ $tool == yamllint ]]; then
  version=${YAMLLINT_VERSION:-}
  validate_version YAMLLINT_VERSION "$version"
else
  select_default_release VALIDATION_RELEASES "$tool"
  version=$RELEASE_VERSION
  url=$RELEASE_URL
fi
executable=$tools_dir/$tool
if [[ $tool == python ]]; then
  HELD_LOCK_FDS=()
  acquire_setup_lock "$tools_dir/.install-python.lock" 'another validation Python installation is running'
  executable=$tools_dir/python/bin/python3
elif [[ $tool == yamllint ]]; then
  bash "$repo_dir/scripts/install-validation-tool" python
  python=$(readlink -f -- "$tools_dir/python/bin/python3")
fi
if [[ -x $executable ]] && [[ $(tool_version "$executable") == "$version" ]]; then
  if [[ $tool == yamllint ]]; then
    installed_bin=$(dirname -- "$(readlink -f -- "$executable")")
    installed_python=$(readlink -f -- "$installed_bin/python")
    [[ $installed_python != "$python" ]] || exit 0
  else
    exit 0
  fi
fi

[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] ||
  die 'automatic tool installation supports Linux x86_64 only'

stage=$(mktemp -d "$tools_dir/install-$tool.XXXXXX")
staged_tree=
cleanup() {
  [[ -z $staged_tree || ! -e $staged_tree ]] ||
    find "$staged_tree" -depth -delete
  find "$stage" -depth -delete
}
trap cleanup EXIT

activate_binary() {
  local candidate=$1
  local destination=$tools_dir/$tool
  local previous=$stage/previous-$tool
  local previous_exists=0

  install -m 0755 "$candidate" "$stage/$tool.candidate"
  candidate=$stage/$tool.candidate
  [[ $(tool_version "$candidate") == "$version" ]] ||
    die "$tool $version candidate validation failed"

  if [[ -e $destination || -L $destination ]]; then
    cp -a "$destination" "$previous"
    previous_exists=1
  fi
  mv -f "$candidate" "$destination"
  if [[ $(tool_version "$destination") == "$version" ]]; then
    return 0
  fi

  rm -f "$destination"
  if ((previous_exists)); then
    mv "$previous" "$destination"
  fi
  die "$tool $version activation failed; restored the previous executable"
}

activate_link() {
  local candidate=$1 candidate_executable=$2
  local destination=$tools_dir/$tool
  local link=$stage/$tool-link
  local previous=$stage/previous-$tool
  local previous_exists=0

  [[ $(tool_version "$candidate_executable") == "$version" ]] ||
    die "$tool $version candidate validation failed"
  ln -s "$candidate" "$link"

  if [[ -e $destination || -L $destination ]]; then
    cp -a "$destination" "$previous"
    previous_exists=1
  fi
  mv -Tf "$link" "$destination"
  if [[ $(tool_version "$executable") == "$version" ]]; then
    staged_tree=
    return 0
  fi

  rm -f "$destination"
  if ((previous_exists)); then
    mv "$previous" "$destination"
  fi
  die "$tool $version activation failed; restored the previous environment"
}

if [[ $tool == yamllint ]]; then
  venv="$tools_dir/yamllint-$version"
  if [[ -e $venv || -L $venv ]]; then
    venv=$tools_dir/yamllint-$version-${stage##*.}
  fi
  staged_tree=$venv
  "$python" -I -m venv --symlinks "$venv"
  "$venv/bin/python" -m pip install --disable-pip-version-check \
    "yamllint==$version"
  activate_link "$venv/bin/yamllint" "$venv/bin/yamllint"
else
  archive=$stage/$RELEASE_ASSET
  prepared=$stage/prepared
  download_file "$url" "$archive"
  prepare_artifact VALIDATION_RELEASES "$tool" "$version" "$archive" "$prepared"
  if [[ $tool == python ]]; then
    runtime=$tools_dir/python-$version
    # Existing venvs point here directly, so never replace a published runtime.
    if [[ -e $runtime || -L $runtime ]]; then
      runtime=$runtime-${stage##*.}
    fi
    staged_tree=$runtime
    mv -- "$prepared/${SPEC_DESTS[0]}" "$runtime"
    activate_link "$runtime" "$runtime/bin/python3"
  else
    activate_binary "$prepared/${SPEC_DESTS[0]}"
  fi
fi

[[ $(tool_version "$executable") == "$version" ]] ||
  die "$tool $version installation failed"
