#!/bin/bash

POD_PREFIXES=(
  "api"
  "disc-api"
  "transac-api"
  "web"
  "cdc"
  "search-indexing"
  "invhub-interaction-engine"
  "invhub-prompt-engine"
  "invhub-context-engine"
  "invhub-websearch"
  "copilot-interaction-engine"
  "copilot-prompt-engine"
  "copilot-context-engine"
  "copilot-websearch"
  "copilotv2"
  "copilot-data-adapter"
  "sail-data-agent"
  "eureka-workflows-registry"
  "workflow-canvas-ui"
  "workflow-manager"
  "webhook-service"
  "activity-release"
  "orchestrator-api"
  "workers-release"
)

TIMESTAMP=$(date "+%Y-%m-%d_%H-%M-%S")

LOG_DIR="${TIMESTAMP}_invhub_logs"
mkdir -p "$LOG_DIR"

SINCE_ARGS=()
if [ -n "${1:-}" ]; then
  SINCE_ARGS=("--since=$1")
fi

for PREFIX in "${POD_PREFIXES[@]}"; do
  mapfile -t PODS < <(kubectl get pods --no-headers -o custom-columns=":metadata.name" |
    awk -v prefix="$PREFIX" 'index($0, prefix) == 1')

  for POD in "${PODS[@]}"; do
    LOG_FILE="${LOG_DIR}/${TIMESTAMP}-${POD}.log"
    kubectl logs "${SINCE_ARGS[@]}" "$POD" >"$LOG_FILE"
    echo "Logs for $POD saved to $LOG_FILE"
  done
done
