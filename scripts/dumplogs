#!/usr/bin/env bash

set -uo pipefail

temporary_file=

cleanup() {
  if [[ -n $temporary_file && -e $temporary_file ]]; then
    rm -f "$temporary_file" || true
  fi
}
trap cleanup EXIT

die() {
  printf 'dumplogs: %s\n' "$*" >&2
  exit 1
}

trim() {
  local value=$1

  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  REPLY=$value
}

contains() {
  local needle=$1
  local value
  shift

  for value in "$@"; do
    [[ $value == "$needle" ]] && return 0
  done
  return 1
}

[[ $# -le 1 ]] || die 'usage: dumplogs [SINCE]'
command -v kubectl >/dev/null 2>&1 || die 'required command is missing: kubectl'

prefix_file=$HOME/kube-log-prefixes.txt
[[ -r $prefix_file ]] || die "cannot read pod-prefix list: $prefix_file"

prefixes=()
while IFS= read -r line || [[ -n $line ]]; do
  line=${line%$'\r'}
  trim "$line"
  [[ -n $REPLY && $REPLY != \#* ]] || continue
  if ! contains "$REPLY" "${prefixes[@]}"; then
    prefixes+=("$REPLY")
  fi
done <"$prefix_file"
[[ ${#prefixes[@]} -gt 0 ]] || die "pod-prefix list is empty: $prefix_file"

if ! pod_output=$(kubectl get pods -o 'jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}'); then
  die 'failed to list pods'
fi

pods=()
if [[ -n $pod_output ]]; then
  mapfile -t pods <<<"$pod_output"
fi

matched_pods=()
for prefix in "${prefixes[@]}"; do
  for pod in "${pods[@]}"; do
    if [[ $pod == "$prefix"* ]] && ! contains "$pod" "${matched_pods[@]}"; then
      matched_pods+=("$pod")
    fi
  done
done

if [[ ${#matched_pods[@]} -eq 0 ]]; then
  printf 'No pods matched the configured prefixes.\n'
  exit 0
fi

timestamp=$(date '+%Y-%m-%d_%H-%M-%S') || die 'failed to read current time'
log_dir=${timestamp}_kubernetes-logs
mkdir "$log_dir" || die "cannot create output directory: $log_dir"

since_args=()
if [[ $# -eq 1 && -n $1 ]]; then
  since_args+=("--since=$1")
fi

status=0
failed_pods=()
for pod in "${matched_pods[@]}"; do
  log_file=$log_dir/$timestamp-$pod.log
  temporary_file=$(mktemp "$log_dir/.${timestamp}-${pod}.XXXXXX") || {
    printf 'dumplogs: cannot create temporary log for pod: %s\n' "$pod" >&2
    failed_pods+=("$pod")
    status=1
    continue
  }
  if kubectl logs "$pod" "${since_args[@]}" >"$temporary_file"; then
    if mv "$temporary_file" "$log_file"; then
      temporary_file=
      printf 'Logs for %s saved to %s\n' "$pod" "$log_file"
    else
      rm -f "$temporary_file"
      temporary_file=
      printf 'dumplogs: cannot save log for pod: %s\n' "$pod" >&2
      failed_pods+=("$pod")
      status=1
    fi
  else
    rm -f "$temporary_file"
    temporary_file=
    printf 'dumplogs: failed to download logs for pod: %s\n' "$pod" >&2
    failed_pods+=("$pod")
    status=1
  fi
done

if [[ ${#failed_pods[@]} -gt 0 ]]; then
  printf 'dumplogs: failed pods (%d): %s\n' \
    "${#failed_pods[@]}" "${failed_pods[*]}" >&2
fi
trap - EXIT
cleanup
exit "$status"
