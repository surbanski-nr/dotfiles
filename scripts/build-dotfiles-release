#!/usr/bin/env bash

set -euo pipefail

export DOTFILES_IGNORE_USER_BIN=1
unset VIRTUAL_ENV

builder_script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=setup-lib
source "$builder_script_dir/setup-lib"
# shellcheck source=setup-system-lib
source "$builder_script_dir/setup-system-lib"

TEMP_PATHS=()
NODE_UPSTREAM_NPM_VERSION=
declare -A BUILD_VERSIONS=()

usage() {
  cat <<'EOF'
Usage:
  build-dotfiles-release build PLATFORM SOURCE_DIR OUTPUT_DIR
  build-dotfiles-release prepare-runtime PLATFORM USER UID HOME

Platforms: debian-13-x86_64, ubuntu-24.04-x86_64,
           ubuntu-26.04-x86_64, amzn-2023-x86_64
EOF
}

cleanup() {
  local status=$?
  local path

  trap - EXIT
  set +e
  for path in "${TEMP_PATHS[@]:-}"; do
    cleanup_path "$path"
  done
  exit "$status"
}
trap cleanup EXIT

load_build_config() {
  local source_dir=$1

  [[ -f $source_dir/tools.env ]] || {
    report_error "missing $source_dir/tools.env"
    return 1
  }
  [[ -f $source_dir/release.env ]] || {
    report_error "missing $source_dir/release.env"
    return 1
  }
  [[ -f $source_dir/scripts/setup-lib ]] || {
    report_error "missing $source_dir/scripts/setup-lib"
    return 1
  }
  # shellcheck source=setup-lib
  source "$source_dir/scripts/setup-lib" || return
  source "$source_dir/scripts/setup-catalog-lib" || return
  source "$source_dir/scripts/setup-recipes-lib" || return
  source "$source_dir/scripts/setup-tools-lib" || return
  source "$source_dir/scripts/setup-system-lib" || return
  # shellcheck source=setup-tmux-lib
  source "$source_dir/scripts/setup-tmux-lib" || return
  load_system_config "$source_dir/system.env" || return
  load_tool_catalog "$source_dir/tools.env" || return
  validate_tool_config offline || return
  validate_tool_selection OFFLINE_RELEASE_TOOLS offline || return
  local tool
  BUILD_VERSIONS=()
  BUILD_TMUX_PLUGINS=()
  for tool in "${OFFLINE_RELEASE_TOOLS[@]}"; do
    if [[ -v TMUX_PLUGINS[$tool] ]]; then
      BUILD_TMUX_PLUGINS+=("$tool")
      continue
    fi
    [[ $tool == yamllint ]] && continue
    select_default_release TOOL_RELEASES "$tool" || return
    [[ $RELEASE_URL != - ]] || {
      report_error "offline default $tool $RELEASE_VERSION has no artifact"
      return 1
    }
    BUILD_VERSIONS[$tool]=$RELEASE_VERSION
    artifact_layout "$tool" "$RELEASE_VERSION" "$RELEASE_ASSET" || return
    if [[ $tool == python ]]; then
      [[ $RELEASE_URL =~ /releases/download/([0-9]{8})/ ]] || {
        report_error 'Python release URL must include its YYYYMMDD build date'
        return 1
      }
    fi

  done
  if list_has OFFLINE_RELEASE_TOOLS nodejs; then
    select_default_release TOOL_RELEASES npm || return
    BUILD_VERSIONS[npm]=$RELEASE_VERSION
    artifact_layout npm "$RELEASE_VERSION" "$RELEASE_ASSET" || return
  fi
  load_platform_config "$source_dir/release.env" || return
}

install_build_packages() {
  local platform=$1 role=$2

  if ! declare -p SYSTEM_RUNTIME_PACKAGES >/dev/null 2>&1; then
    load_system_config "$builder_script_dir/../system.env" || return
  fi
  install_system_packages "$platform" "$role" true
}

prepare_release_artifact() {
  local catalog=$1 name=$2 version=$3 inputs=$4
  local archive stage npm_archive

  select_release "$catalog" "$name" "$version" || return
  [[ $RELEASE_URL != - ]] || {
    report_error "$name $version has no direct artifact"
    return 1
  }
  artifact_layout "$name" "$version" "$RELEASE_ASSET" || return
  archive=$inputs/$name-$version-$RELEASE_ASSET
  download_file "$RELEASE_URL" "$archive" || return
  stage=$(mktemp -d) || return
  TEMP_PATHS+=("$stage")
  if ((${#SPEC_LINKS[@]})); then
    prepare_tool_artifact "$name" "$version" "$RELEASE_ASSET" "$RELEASE_SHA256" "$archive" "$stage" || return
  else
    prepare_artifact "$name" "$version" "$RELEASE_ASSET" "$RELEASE_SHA256" "$archive" "$stage" || return
  fi
  if [[ $name == nodejs ]]; then
    select_default_release TOOL_RELEASES npm || return
    npm_archive=$inputs/npm-$RELEASE_ASSET
    download_file "$RELEASE_URL" "$npm_archive" || return
    prepare_node_npm "$stage/${SPEC_DESTS[0]}" "$npm_archive" "$RELEASE_VERSION" "$RELEASE_SHA256" || return
  fi
  PREPARED_STAGE=$stage
  PREPARED_ARCHIVE=$archive
}

write_launchers() {
  local release=$1 tool

  for tool in nvim tmux go; do
    list_has OFFLINE_RELEASE_TOOLS "$tool" || continue
    unlink -- "$release/bin/$tool" || return
    install -m 0755 "$release/dotfiles/scripts/offline-$tool" "$release/bin/$tool" || return
  done
  for tool in kubectl helm; do
    list_has OFFLINE_RELEASE_TOOLS "$tool" || continue
    unlink -- "$release/bin/$tool" || return
    install -m 0755 "$release/dotfiles/scripts/offline-kubernetes-client" \
      "$release/bin/$tool" || return
  done
}

install_release_tools() {
  local release=$1 inputs=$2 tool version selected entry command_name target canonical
  local -a versions=()

  mkdir -p "$release/bin" "$release/tools/bin" "$inputs" || return
  for tool in "${OFFLINE_RELEASE_TOOLS[@]}"; do
    if [[ $tool == yamllint || $tool == helm-schema || -v TMUX_PLUGINS[$tool] ]]; then
      continue
    fi
    selected=${BUILD_VERSIONS[$tool]}
    versions=("$selected")
    if [[ $tool == kubectl || $tool == helm ]]; then
      release_versions TOOL_RELEASES "$tool" || return
      versions=("${RELEASE_VERSIONS[@]}")
    fi
    for version in "${versions[@]}"; do
      printf 'build-dotfiles-release: installing %s %s\n' "$tool" "$version"
      prepare_release_artifact TOOL_RELEASES "$tool" "$version" "$inputs" || return
      publish_tool_artifact "$PREPARED_STAGE" "$release/tools" || return
      if [[ $tool == kubectl || $tool == helm ]]; then
        target=${SPEC_LINKS[0]#*:}
        ln -s -- "$target" "$release/bin/$tool-$version" || return
      fi
    done
    artifact_layout "$tool" "$selected" retained || return
    if [[ $SPEC_FORMAT == *-tree ]]; then
      canonical=${SPEC_DESTS[0]%-"$selected"}
      ln -s -- "${SPEC_DESTS[0]}" "$release/tools/$canonical" || return
    fi
    for entry in "${SPEC_LINKS[@]}"; do
      command_name=${entry%%:*}
      target=${entry#*:}
      ln -s -- "$target" "$release/bin/$command_name" || return
    done
    if [[ $tool == kubectl || $tool == helm ]]; then
      ln -s -- "$tool-$selected" "$release/tools/bin/$tool" || return
    fi
  done
  if list_has OFFLINE_RELEASE_TOOLS nodejs; then
    NODE_UPSTREAM_NPM_VERSION=$(<"$release/tools/node/.upstream-npm-version")
  fi
  write_launchers "$release" || return
}

install_release_tmux_plugins() {
  local plugin root=$1/share/tmux/plugins

  for plugin in "${BUILD_TMUX_PLUGINS[@]}"; do
    select_git_plugin TMUX_PLUGINS "$plugin" || return
    preflight_tmux_plugin "$plugin" "$root" "$PLUGIN_REPO" || return
  done
  for plugin in "${BUILD_TMUX_PLUGINS[@]}"; do
    select_git_plugin TMUX_PLUGINS "$plugin" || return
    install_tmux_plugin "$plugin" "$root" "$PLUGIN_REPO" "$PLUGIN_COMMIT" || return
  done
}

install_helm_schema_plugin() {
  local release=$1 inputs=$2 plugin
  local version=${BUILD_VERSIONS['helm-schema']}

  prepare_release_artifact TOOL_RELEASES helm-schema "$version" "$inputs" || return
  plugin=$release/share/helm/plugins/helm-values-schema-json
  mkdir -p "$plugin" || return
  install -m 0755 "$PREPARED_STAGE/${SPEC_DESTS[0]}" "$plugin/schema" || return
  tar -xOzf "$PREPARED_ARCHIVE" -- LICENSE >"$plugin/LICENSE" || return
  [[ -s $plugin/LICENSE ]] || {
    report_error 'Helm schema plugin license is missing'
    return 1
  }
  cat >"$plugin/plugin.yaml" <<EOF
name: schema
version: "$version"
usage: generate values.schema.json from values yaml
description: Helm plugin for generating values.schema.json from multiple values files.
ignoreFlags: false
platformCommand:
  - os: linux
    command: "\$HELM_PLUGIN_DIR/schema"
EOF
}

write_nvim_inventory() {
  local release=$1 package version extra
  local data=$release/share/nvim2/mason

  DOTFILES_NVIM_CONFIG="$release/config/nvim2" \
    DOTFILES_MASON_PACKAGES="$data/packages" \
    DOTFILES_INVENTORY_ROOT="$release" \
    "$release/bin/nvim" --headless -u NONE -l /dev/stdin <<'LUA' || return
vim.opt.runtimepath:prepend(vim.env.DOTFILES_NVIM_CONFIG)
local mason, python = {}, {}
for _, package in ipairs(require('custom.tools').inventory(vim.env.DOTFILES_MASON_PACKAGES)) do
  local commands = '-'
  if #package.commands > 0 then
    commands = table.concat(package.commands, ',')
  end
  mason[#mason + 1] = table.concat({
    package.name,
    package.version,
    package.python or '-',
    commands,
  }, '\t')
  if package.python then
    python[#python + 1] = package.python .. '\t' .. package.version
  end
end
assert(vim.fn.writefile(mason, vim.env.DOTFILES_INVENTORY_ROOT .. '/share/nvim2/mason/inventory.tsv') == 0)
assert(vim.fn.writefile(python, vim.env.DOTFILES_INVENTORY_ROOT .. '/python-locks/inventory.tsv') == 0)
LUA
  while IFS=$'\t' read -r package version extra; do
    cp "$release/config/nvim2/python-locks/$package.in" \
      "$release/config/nvim2/python-locks/$package.lock" "$release/python-locks/" || return
  done <"$release/python-locks/inventory.tsv"
}

write_debug_launchers() {
  local release=$1 command_name
  local source=$release/dotfiles/scripts/offline-debug-adapter

  [[ -d $release/share/nvim2/mason/packages/debugpy ]] || return 0

  for command_name in debugpy debugpy-adapter; do
    [[ -x $release/share/nvim2/mason/packages/debugpy/$command_name ]] || {
      report_error "debug adapter launcher is missing: $command_name"
      return 1
    }
    install -m 0755 "$source" \
      "$release/share/nvim2/mason/packages/debugpy/$command_name" || return
  done
}

prepare_nvim_payload() {
  local release=$1 build_home=$2 platform=$3
  local python="$release/tools/python-${BUILD_VERSIONS[python]:-}/bin/python3"
  local data=$release/share/nvim2
  local package receipt link target relative lua_launcher command_name package_output mason_package link_list
  local tree_sitter_version tree_sitter_root tree_sitter_binary dependency

  mkdir -p "$build_home/.cache" "$release/share" || return
  export HOME=$build_home
  export PATH="$release/bin:$release/tools/python-${BUILD_VERSIONS[python]:-}/bin:$release/tools/node/bin:$release/tools/bin:/usr/local/bin:/usr/bin:/bin"
  export NVIM_APPNAME=nvim2
  export XDG_CACHE_HOME=$build_home/.cache
  export GOTOOLCHAIN=local
  export CGO_ENABLED=0
  mkdir -p "$data/mason/bin" "$data/mason/packages" || return
  DOTFILES_NVIM_REQUIREMENTS="$data/mason/requirements.txt" \
    timeout 300s "$release/bin/nvim" --headless '+lua dofile("/dev/stdin")' '+qa!' <<'LUA' || return
local ok, message = xpcall(function()
  require('custom.tools').check_configuration()
  assert(vim.fn.writefile(require('custom.tools').requirements(), vim.env.DOTFILES_NVIM_REQUIREMENTS) == 0)
end, debug.traceback)
if not ok then
  io.stderr:write(message .. '\n')
  vim.cmd 'cquit 1'
end
LUA
  while IFS= read -r dependency; do
    list_has OFFLINE_RELEASE_TOOLS "$dependency" || {
      report_error "configured Neovim tools require $dependency in OFFLINE_RELEASE_TOOLS"
      return 1
    }
  done <"$data/mason/requirements.txt"
  if [[ $platform == amzn-2023-x86_64 ]]; then
    timeout 2400s "$release/bin/nvim" --headless '+lua dofile("/dev/stdin")' '+qa!' <<'LUA' || return
local ok, message = xpcall(function()
  if #require('custom.lsp').tools > 0 then
    vim.cmd 'MasonToolsInstallSync'
  end
end, debug.traceback)
if not ok then
  io.stderr:write(message .. '\n')
  vim.cmd 'cquit 1'
end
LUA
    tree_sitter_version=$("$release/bin/nvim" --headless \
      "+lua
for _, tool in ipairs(require('custom.lsp').tools) do
  if tool[1] == 'tree-sitter-cli' then
    io.write(tool.version)
  end
end" \
      '+qa!') || return
    tree_sitter_version=${tree_sitter_version#v}
    if [[ -n $tree_sitter_version ]]; then
      tree_sitter_root=$build_home/.local/opt/tree-sitter-cli-$tree_sitter_version
      tree_sitter_binary=$(readlink -f -- "$data/mason/bin/tree-sitter") || return
      timeout 2400s cargo install tree-sitter-cli \
        --version "$tree_sitter_version" --locked --root "$tree_sitter_root" || return
      install -m 0755 "$tree_sitter_root/bin/tree-sitter" "$tree_sitter_binary" || return
    fi
  fi
  timeout 2400s nvim --headless '+lua dofile("/dev/stdin")' '+qa!' <<'LUA' || return
local ok, message = xpcall(function()
  vim.cmd 'Nvim2ToolsInstallSync'
end, debug.traceback)
if not ok then
  io.stderr:write(message .. '\n')
  vim.cmd 'cquit 1'
end
LUA
  write_debug_launchers "$release" || return
  write_nvim_inventory "$release" || return
  package_output=$(python_inventory_packages "$release") || return
  if [[ -d $data/mason/packages/ansible-lint ]]; then
    for command_name in ansible ansible-config ansible-playbook; do
      ln -s "../packages/ansible-lint/venv/bin/$command_name" \
        "$data/mason/bin/$command_name" || return
    done
  fi
  if [[ -d $data/mason/packages/eslint_d ]]; then
    install -m 0755 "$release/dotfiles/scripts/offline-eslint-d" "$data/mason/packages/eslint_d/eslint_d" || return
    unlink "$data/mason/bin/eslint_d" || return
    ln -s ../packages/eslint_d/eslint_d "$data/mason/bin/eslint_d" || return
  fi
  verify_nvim_inventory "$release" installed OFFLINE_RELEASE_TOOLS || return
  TEST_BASHRC="$release/dotfiles/bash/.bashrc" NVIM2_BENCHMARK_RUNS=3 timeout 1200s \
    bash "$release/config/nvim2/tests/check_runner.sh" || return
  link_list=$(mktemp) || return
  TEMP_PATHS+=("$link_list")
  find "$release/share/nvim2" -type l -print0 >"$link_list" || return
  while IFS= read -r -d '' link; do
    target=$(readlink -- "$link") || return
    [[ $target == /* ]] || continue
    case $target in
      "$release"/*)
        ;;
      *)
        report_error "generated Neovim link points outside its payload: $link -> $target"
        return 1
        ;;
    esac
    relative=$(realpath -m --relative-to="$(dirname -- "$link")" "$target") || return
    unlink "$link" || return
    ln -s "$relative" "$link" || return
  done <"$link_list"

  lua_launcher=$release/share/nvim2/mason/packages/lua-language-server/lua-language-server
  if [[ -d $data/mason/packages/lua-language-server ]]; then
    [[ -x $lua_launcher &&
      -x $release/share/nvim2/mason/packages/lua-language-server/libexec/bin/lua-language-server ]] || {
      report_error 'lua-language-server payload is incomplete'
      return 1
    }
    cat >"$lua_launcher" <<'BASH' || return
#!/usr/bin/env bash
set -euo pipefail
self=$(readlink -f -- "${BASH_SOURCE[0]}")
package_dir=${self%/lua-language-server}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
log_dir=$state_home/nvim2/lua-language-server
mkdir -p "$log_dir"
exec "$package_dir/libexec/bin/lua-language-server" --logpath="$log_dir" "$@"
BASH
    chmod 0755 "$lua_launcher" || return
    cleanup_path "$release/share/nvim2/mason/packages/lua-language-server/libexec/log" || return

  fi
  mkdir -p "$release/python-wheelhouse" || return
  if [[ -n $package_output ]]; then
    while IFS= read -r package; do
      mason_package=$(python_mason_package "$release" "$package") || return
      receipt="$release/share/nvim2/mason/packages/$mason_package/mason-receipt.json"
      [[ -f $receipt ]] || {
        report_error "Mason receipt is missing for $package"
        return 1
      }
      cleanup_path "$release/share/nvim2/mason/packages/$mason_package/venv" || return
      "$python" -I -m pip download --disable-pip-version-check --require-hashes \
        --only-binary=:all: --dest "$release/python-wheelhouse" \
        -r "$release/python-locks/$package.lock" || return
    done <<<"$package_output"
  fi
  if list_has OFFLINE_RELEASE_TOOLS yamllint; then
    ln -s ../share/nvim2/mason/packages/yamllint/venv/bin/yamllint \
      "$release/bin/yamllint" || return
  fi
}

verify_release_symlinks() {
  local release=$1 link target resolved links

  links=$(mktemp) || return
  TEMP_PATHS+=("$links")
  find "$release" -type l -print0 >"$links" || return
  while IFS= read -r -d '' link; do
    target=$(readlink -- "$link") || return
    if [[ $target == /* ]]; then
      resolved=$(readlink -m -- "$target")
    else
      resolved=$(readlink -m -- "$(dirname -- "$link")/$target")
    fi
    [[ $resolved == "$release" || $resolved == "$release"/* ]] || {
      report_error "release symlink escapes its root: $link -> $target"
      return 1
    }
  done <"$links"
}

write_release_metadata() {
  local release=$1 platform=$2 source_commit=$3 source_tree=$4 image=$5 inputs=$6
  local release_id=${release##*/} tool
  local manifest package origin plugin_commit value command_name check
  local -a arguments=()

  printf '%s\n' \
    "RELEASE_ID=$release_id" \
    "PLATFORM_ID=$platform" \
    "SOURCE_COMMIT=$source_commit" \
    "SOURCE_TREE=$source_tree" \
    "BUILDER_IMAGE=$image" \
    "OFFLINE_RELEASE_TOOLS=$(
      IFS=,
      printf '%s' "${OFFLINE_RELEASE_TOOLS[*]}"
    )" \
    'PAYLOAD_PATHS=bin,config,dotfiles,python-locks,python-wheelhouse,share,tools' \
    >"$release/release.env" || return
  write_tool_metadata OFFLINE_RELEASE_TOOLS "$release/release.env" "$NODE_UPSTREAM_NPM_VERSION" || return

  {
    printf 'source_commit=%s\nsource_tree=%s\nplatform=%s\nbuilder_image=%s\n' \
      "$source_commit" "$source_tree" "$platform" "$image"
    value=$(date -u +%FT%TZ) || return
    printf 'built_at_utc=%s\n' "$value" || return
    value=$(getconf GNU_LIBC_VERSION) || return
    printf 'glibc=%s\n' "$value" || return
    for tool in "${OFFLINE_RELEASE_TOOLS[@]}"; do
      if [[ $tool == python ]]; then
        "$release/tools/python/bin/python3" --version || return
        continue
      fi
      value=$(tool_commands "$tool") || return
      [[ -n $value ]] || continue
      command_name=${value%%$'\n'*}
      check=${TOOL_CHECKS[$command_name]:-}
      [[ -n $check ]] || continue
      read -r -a arguments <<<"${check#*|}"
      (("${#arguments[@]}" > 0)) || arguments=(--version)
      "$release/bin/$command_name" "${arguments[@]}" || return
    done
    if list_has OFFLINE_RELEASE_TOOLS tmux; then
      printf 'tmux_configure=--prefix=tools/tmux\n'
      ldd "$release/tools/tmux/bin/tmux" || return
    fi
    printf 'builder_packages:\n'
    printf '  %s\n' "${SETUP_SYSTEM_PACKAGES[@]}"
    printf 'input_archives_sha256:\n'
    (cd "$inputs" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum) || return
    if list_has OFFLINE_RELEASE_TOOLS nvim; then
      printf 'python_locks_sha256:\n'
      (cd "$release/python-locks" &&
        find . -maxdepth 1 -type f -name '*.lock' -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum) || return
      printf 'python_wheels_sha256:\n'
      (cd "$release/python-wheelhouse" &&
        find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum) || return
      value=$(sha256sum "$release/config/nvim2/nvim-pack-lock.json" | cut -d ' ' -f1) || return
      printf 'nvim_pack_lock_sha256=%s\n' "$value" || return
    fi
    for package in "${BUILD_TMUX_PLUGINS[@]}"; do
      origin=$(git -C "$release/share/tmux/plugins/$package" config --get remote.origin.url) || return
      plugin_commit=$(git -C "$release/share/tmux/plugins/$package" rev-parse HEAD) || return
      printf '%s_origin=%s\n' "$package" "$origin" || return
      printf '%s_commit=%s\n' "$package" "$plugin_commit" || return
    done
  } >"$release/build-manifest.txt" || return

  (
    cd "$release" || exit
    manifest=$(mktemp "$release/.SHA256SUMS.XXXXXX") || exit
    find . -type f ! -name SHA256SUMS ! -name '.SHA256SUMS.*' -print0 |
      LC_ALL=C sort -z | xargs -0 sha256sum >"$manifest" || exit
    mv "$manifest" SHA256SUMS || exit
    sha256sum --check --strict SHA256SUMS >/dev/null || exit
  ) || return
}

pack_dotfiles_source() {
  local source_dir=$1 release=$2 tool package
  local -a paths=(bash git ssh vim scripts tools.env)

  for tool in "${OFFLINE_RELEASE_TOOLS[@]}"; do
    package=$(tool_config_package "$tool") || return
    [[ -z $package ]] || paths+=("$package")
  done
  git -c safe.directory="$source_dir" -C "$source_dir" archive HEAD -- "${paths[@]}" |
    tar -x -C "$release/dotfiles" || return
}

build_release() {
  local platform=$1 source_dir=$2 output_dir=$3
  local source_commit source_tree source_status release_id image work release inputs build_home archive

  [[ $(id -u) -eq 0 ]] || {
    report_error 'build must run as root in a disposable builder'
    return 1
  }
  system_validate_release_host "$platform" || return
  [[ -d $source_dir/.git ]] || {
    report_error "source is not a Git checkout: $source_dir"
    return 1
  }
  load_build_config "$source_dir" || return
  image=${DOCKER_IMAGES[$platform]:-}
  [[ $image =~ ^[^[:space:]@]+@sha256:[0-9a-f]{64}$ ]] || {
    report_error "no pinned Docker image configured for $platform"
    return 1
  }
  [[ ${BUILDER_IMAGE:-$image} == "$image" ]] || {
    report_error 'builder image does not match the configured digest'
    return 1
  }
  install_build_packages "$platform" build || return
  source_commit=$(git -c safe.directory="$source_dir" -C "$source_dir" rev-parse HEAD) || return
  source_tree=$(git -c safe.directory="$source_dir" -C "$source_dir" rev-parse 'HEAD^{tree}') || return
  source_status=$(git -c safe.directory="$source_dir" -C "$source_dir" \
    status --porcelain --untracked-files=normal) || return
  [[ -z $source_status ]] || {
    report_error 'build source must be clean'
    return 1
  }
  release_id=dotfiles-${source_commit:0:12}

  work=$(mktemp -d /tmp/dotfiles-release-build.XXXXXX) || return
  TEMP_PATHS+=("$work")
  release=$work/$release_id
  inputs=$work/inputs
  build_home=$work/build-home
  mkdir -p "$release/bin" "$release/config" "$release/dotfiles" "$release/share" \
    "$release/tools" "$release/python-locks" "$release/python-wheelhouse" "$build_home" || return
  pack_dotfiles_source "$source_dir" "$release" || return
  if list_has OFFLINE_RELEASE_TOOLS nvim; then
    cp -a "$release/dotfiles/nvim2/.config/nvim2" "$release/config/nvim2" || return
  fi
  bash "$source_dir/scripts/build-standalone-script" "$source_dir" "$release/dotfiles-release" || return
  install_release_tools "$release" "$inputs" || return
  if list_has OFFLINE_RELEASE_TOOLS helm-schema; then
    install_helm_schema_plugin "$release" "$inputs" || return
  fi
  ln -s ../dotfiles-release "$release/bin/dotfiles-release" || return
  if (("${#BUILD_TMUX_PLUGINS[@]}" > 0)); then
    install_release_tmux_plugins "$release" || return
  fi
  if list_has OFFLINE_RELEASE_TOOLS nvim; then
    prepare_nvim_payload "$release" "$build_home" "$platform" || return
  fi
  verify_release_symlinks "$release" || return
  write_release_metadata "$release" "$platform" "$source_commit" "$source_tree" \
    "$image" "$inputs" || return

  mkdir -p "$output_dir" || return
  archive=$output_dir/$release_id-$platform.tar.gz
  tar -C "$work" -czf "$archive" "$release_id" || return
  (cd "$output_dir" && sha256sum "${archive##*/}" >"${archive##*/}.sha256") || return
  chmod -R a+rX "$output_dir" || return
  printf '%s: built %s\n' "${0##*/}" "$archive"
}

# Used by the release workflow to create a minimal image for network-free tests.
prepare_runtime() {
  local platform=$1 user=$2 uid=$3 home=$4 group

  [[ $(id -u) -eq 0 ]] || {
    report_error 'prepare-runtime must run as root'
    return 1
  }
  [[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || {
    report_error "invalid user name: $user"
    return 1
  }
  [[ $uid =~ ^[0-9]+$ ]] || {
    report_error "invalid UID: $uid"
    return 1
  }
  [[ $home == /* && $home != / ]] || {
    report_error "invalid home: $home"
    return 1
  }
  system_validate_release_host "$platform" || return
  install_build_packages "$platform" runtime || return
  if ! id "$user" >/dev/null 2>&1; then
    group=$user
    getent group "$group" >/dev/null 2>&1 || groupadd --gid "$uid" "$group" || return
    useradd --uid "$uid" --gid "$group" --home-dir "$home" --create-home \
      --shell /bin/bash "$user" || return
  fi
  [[ $(id -u "$user") -eq $uid ]] || {
    report_error "$user does not have UID $uid"
    return 1
  }
  mkdir -p "$home" || return
  chown "$user:$(id -gn "$user")" "$home" || return
}

main() {
  local command=${1:-}

  case $command in
    build)
      if (($# != 4)); then
        usage
        return 2
      fi
      build_release "$2" "$3" "$4"
      ;;
    prepare-runtime)
      if (($# != 5)); then
        usage
        return 2
      fi
      prepare_runtime "$2" "$3" "$4" "$5"
      ;;
    -h | --help)
      usage
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
