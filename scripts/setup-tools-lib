#!/usr/bin/env bash

configure_online_paths() {
  local root=${DOTFILES_RELEASE_ROOT:-$HOME/dotfiles-releases}

  ONLINE_ROOT=${root%/}/online
  BIN_DIR=$ONLINE_ROOT/bin
  PAYLOAD_DIR=$ONLINE_ROOT/tools
  TMUX_PLUGIN_DIR=$ONLINE_ROOT/share/tmux/plugins
}

prepare_online_directories() {
  local path target

  for path in "$ONLINE_ROOT" "$BIN_DIR" "$PAYLOAD_DIR" "$PAYLOAD_DIR/bin" \
    "$ONLINE_ROOT/state" "$ONLINE_ROOT/config" "$ONLINE_ROOT/share" \
    "$ONLINE_ROOT/share/tmux" "$TMUX_PLUGIN_DIR"; do
    if [[ -L $path || ( -e $path && ! -d $path ) ]]; then
      report_error "invalid online directory: $path"
      return 1
    fi
    mkdir -p -- "$path" || return
  done
  path=$ONLINE_ROOT/release.env
  if [[ -e $path || -L $path ]]; then
    if ! [[ -f $path && ! -L $path &&
      $(head -n 1 "$path") == RELEASE_ID=online ]]; then
      report_error "refusing unmanaged online metadata: $path"
      return 1
    fi
  fi
  path=$ONLINE_ROOT/dotfiles
  if [[ -e $path || -L $path ]]; then
    if ! [[ -L $path && ( $(readlink -- "$path") == "$REPO_DIR" ||
      -f $ONLINE_ROOT/release.env ) ]]; then
      report_error "refusing unmanaged online checkout: $path"
      return 1
    fi
  fi
  path=$BIN_DIR/dotfiles-release
  target=../dotfiles/scripts/dotfiles-release
  if [[ -e $path || -L $path ]]; then
    if ! [[ -L $path && $(readlink -- "$path") == "$target" ]]; then
      report_error "refusing unmanaged manager command: $path"
      return 1
    fi
  fi
  if list_has TOOLS nvim; then
    path=$ONLINE_ROOT/config/nvim2
    target=../dotfiles/nvim2/.config/nvim2
    if [[ -e $path || -L $path ]]; then
      if ! [[ -L $path && $(readlink -- "$path") == "$target" ]]; then
        report_error "refusing unmanaged online configuration: $path"
        return 1
      fi
    fi
    path=$ONLINE_ROOT/share/nvim2
    if [[ -L $path || ( -e $path && ! -d $path ) ]]; then
      report_error "invalid online data directory: $path"
      return 1
    fi
  fi
}

tool_content_digest() {
  local root=$1
  shift

  tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
    -C "$root" -cf - -- "$@" | sha256sum | awk '{print $1}'
}

read_tool_state() {
  local path=$1 payloads extra payload

  RECORDED_INSTALL_PHASE=
  RECORDED_ARTIFACT_SHA256=
  RECORDED_PAYLOAD_SHA256=
  RECORDED_PAYLOAD_PATHS=()
  if ! [[ -f $path && ! -L $path && $(wc -l <"$path") == 1 ]]; then
    return 1
  fi
  IFS=$'\t' read -r RECORDED_INSTALL_PHASE RECORDED_ARTIFACT_SHA256 \
    RECORDED_PAYLOAD_SHA256 payloads extra <"$path" || return 1
  if ! [[ ( $RECORDED_INSTALL_PHASE == pending || $RECORDED_INSTALL_PHASE == complete ) &&
    $RECORDED_ARTIFACT_SHA256 =~ ^[0-9a-f]{64}$ &&
    $RECORDED_PAYLOAD_SHA256 =~ ^[0-9a-f]{64}$ && -z $extra &&
    -n $payloads && $payloads != *, ]]; then
    return 1
  fi
  IFS=, read -r -a RECORDED_PAYLOAD_PATHS <<<"$payloads"
  for payload in "${RECORDED_PAYLOAD_PATHS[@]}"; do
    if ! [[ $payload =~ ^[A-Za-z0-9][A-Za-z0-9./+_-]*$ &&
      /$payload/ != *'/../'* && /$payload/ != *'/./'* && $payload != */ ]]; then
      return 1
    fi
  done
}

write_tool_metadata() {
  local tools_name=$1 file=$2 tool fields field value
  local -n metadata_tools=$tools_name
  local -A emitted=()

  for tool in "${metadata_tools[@]}"; do
    fields=$(tool_metadata_fields "$tool") || return
    if [[ -z $fields ]]; then
      continue
    fi
    while IFS= read -r field; do
      if [[ -v emitted[$field] ]]; then
        continue
      fi
      case $field in
        *_COMMIT)
          select_git_plugin TMUX_PLUGINS "$tool" || return
          value=$PLUGIN_COMMIT
          ;;
        *_VERSIONS)
          release_versions TOOL_RELEASES "$tool" || return
          value=$(
            IFS=,
            printf '%s' "${RELEASE_VERSIONS[*]}"
          )
          ;;
        PYTHON_BUILD)
          if [[ $tools_name == TOOLS ]]; then
            continue
          fi
          select_default_release TOOL_RELEASES python || return
          if ! [[ $RELEASE_URL =~ /releases/download/([0-9]{8})/ ]]; then
            return 1
          fi
          value=${BASH_REMATCH[1]}
          ;;
        NODE_UPSTREAM_NPM_VERSION)
          value=$NODE_UPSTREAM_NPM_VERSION
          ;;
        NPM_VERSION)
          select_default_release TOOL_RELEASES npm || return
          value=$RELEASE_VERSION
          ;;
        *)
          select_default_release TOOL_RELEASES "$tool" || return
          value=$RELEASE_VERSION
          ;;
      esac
      printf '%s=%s\n' "$field" "$value" >>"$file" || return
      emitted[$field]=1
    done <<<"$fields"
  done
}

finish_online_setup() {
  local repository=$1 metadata temporary old_source='' config target

  if [[ -L $ONLINE_ROOT/dotfiles ]]; then
    old_source=$(readlink -- "$ONLINE_ROOT/dotfiles") || return
  fi
  metadata=$(mktemp "$ONLINE_ROOT/.release-env.XXXXXX") || return
  TEMP_PATHS+=("$metadata")
  printf 'RELEASE_ID=online\nTOOLS=%s\n' "$(
    IFS=,
    printf '%s' "${TOOLS[*]}"
  )" >"$metadata" || return
  NODE_UPSTREAM_NPM_VERSION=${NODE_UPSTREAM_NPM_VERSION:-}
  if list_has TOOLS nodejs; then
    NODE_UPSTREAM_NPM_VERSION=$(<"$PAYLOAD_DIR/node/.upstream-npm-version")
  fi
  write_tool_metadata TOOLS "$metadata" || return

  temporary=$ONLINE_ROOT/.dotfiles.link.$$
  TEMP_PATHS+=("$temporary")
  ln -s -- "$repository" "$temporary" || return
  mv -T -- "$temporary" "$ONLINE_ROOT/dotfiles" || return
  if ! mv -T -- "$metadata" "$ONLINE_ROOT/release.env"; then
    if [[ -n $old_source ]]; then
      ln -s -- "$old_source" "$temporary" || return
      mv -T -- "$temporary" "$ONLINE_ROOT/dotfiles" || return
    else
      unlink -- "$ONLINE_ROOT/dotfiles" || return
    fi
    return 1
  fi
  if list_has TOOLS nvim; then
    config=$ONLINE_ROOT/config/nvim2
    target=../dotfiles/nvim2/.config/nvim2
    if [[ ! -L $config ]]; then
      ln -s -- "$target" "$config" || return
    fi
    mkdir -p -- "$ONLINE_ROOT/share/nvim2" || return
  fi
  temporary=$BIN_DIR/.dotfiles-release.link.$$
  TEMP_PATHS+=("$temporary")
  ln -s ../dotfiles/scripts/dotfiles-release "$temporary" || return
  mv -T -- "$temporary" "$BIN_DIR/dotfiles-release"
}

list_has() {
  local list_name=$1 requested=$2 item
  local -n items_ref=$list_name

  for item in "${items_ref[@]}"; do
    if [[ $item == "$requested" ]]; then
      return 0
    fi
  done
  return 1
}

tool_commands() {
  case $1 in
    nodejs)
      printf '%s\n' node npm npx corepack
      ;;
    go)
      printf '%s\n' go gofmt
      ;;
    uv)
      printf '%s\n' uv uvx
      ;;
    python | helm-schema | tmux-*)
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

tool_metadata_fields() {
  local tool=$1 field

  case $tool in
    nodejs)
      printf '%s\n' NODE_VERSION NPM_VERSION NODE_UPSTREAM_NPM_VERSION
      ;;
    python)
      printf '%s\n' PYTHON_VERSION PYTHON_BUILD
      ;;
    kubectl | helm)
      printf '%s_VERSIONS\n' "${tool^^}"
      ;;
    helm-schema)
      printf '%s\n' HELM_SCHEMA_PLUGIN_VERSION
      ;;
    yamllint)
      ;;
    tmux-sensible | tmux-resurrect | tmux-continuum)
      field=${tool^^}
      printf '%s_COMMIT\n' "${field//-/_}"
      ;;
    node | npm | uvx)
      return 1
      ;;
    *)
      field=${TOOL_CHECKS[$tool]:-}
      field=${field%%|*}
      if [[ -z $field ]]; then
        return 1
      fi
      printf '%s\n' "$field"
      ;;
  esac
}

tool_dependencies() {
  case $1 in
    nvim)
      printf '%s\n' rg
      ;;
    yamllint)
      printf '%s\n' nvim
      ;;
    helm-schema)
      printf '%s\n' helm
      ;;
    tmux-sensible | tmux-resurrect | tmux-continuum)
      printf '%s\n' tmux
      ;;
  esac
}

validate_tool_dependencies() {
  local tools_name=$1 tool dependency dependencies
  local -n tools_ref=$tools_name

  for tool in "${tools_ref[@]}"; do
    dependencies=$(tool_dependencies "$tool") || return
    if [[ -z $dependencies ]]; then
      continue
    fi
    while IFS= read -r dependency; do
      if ! list_has "$tools_name" "$dependency"; then
        printf '%s requires %s in %s\n' "$tool" "$dependency" "$tools_name" >&2
        return 1
      fi
    done <<<"$dependencies"
  done
}

tool_config_package() {
  case $1 in
    nvim)
      printf '%s\n' nvim2
      ;;
    tmux | oh-my-posh | k9s)
      printf '%s\n' "$1"
      ;;
  esac
}

tool_payload_paths() {
  local tool=$1 package commands command_name

  package=$(tool_config_package "$tool") || return
  if [[ -n $package ]]; then
    printf 'dotfiles/%s\n' "$package"
  fi
  case $tool in
    nvim)
      printf '%s\n' config/nvim2 share/nvim2 tools/nvim 'tools/nvim-*'
      ;;
    nodejs)
      printf '%s\n' tools/node 'tools/node-*'
      ;;
    python)
      printf '%s\n' tools/python 'tools/python-*'
      ;;
    go | htop | tmux)
      printf 'tools/%s\ntools/%s-*\n' "$tool" "$tool"
      ;;
    helm-schema)
      printf '%s\n' share/helm/plugins/helm-values-schema-json
      ;;
    tmux-sensible | tmux-resurrect | tmux-continuum)
      printf 'share/tmux/plugins/%s\n' "$tool"
      ;;
    kubectl | helm)
      printf 'tools/bin/%s*\n' "$tool"
      ;;
    yamllint)
      ;;
    *)
      commands=$(tool_commands "$tool") || return
      while IFS= read -r command_name; do
        printf 'tools/bin/%s*\n' "$command_name"
      done <<<"$commands"
      ;;
  esac
}

known_tool_names() {
  local tool

  printf '%s\n' nodejs python yamllint helm-schema tmux-sensible tmux-resurrect tmux-continuum
  for tool in "${!TOOL_CHECKS[@]}"; do
    case $tool in
      node | npm | uvx)
        continue
        ;;
    esac
    printf '%s\n' "$tool"
  done
}

verify_nvim_inventory() {
  local release=$1 mode=$2 tools_name=$3
  local inventory=$release/share/nvim2/mason/inventory.tsv
  local requirements=$release/share/nvim2/mason/requirements.txt
  local package version python commands extra command_name path dependency
  local seen=' ' python_rows='' expected_python actual_python
  local -a launchers=()

  if ! [[ -f $inventory && ! -L $inventory &&
    -f $requirements && ! -L $requirements ]]; then
    die 'Neovim tool inventory or requirements are missing'
    return 1
  fi
  while IFS=$'\t' read -r package version python commands extra; do
    if ! [[ -z $extra && $package =~ ^[a-z0-9][a-z0-9_-]*$ &&
      $version =~ ^v?[0-9]+[.][0-9]+[.][0-9]+([+-][A-Za-z0-9.+-]+)?$ &&
      $python =~ ^(-|[a-z0-9][a-z0-9-]*)$ &&
      $commands =~ ^(-|[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*)$ &&
      $seen != *" $package "* ]]; then
      die 'Neovim tool inventory contains invalid or duplicate data'
      return 1
    fi
    seen+="$package "
    path=$release/share/nvim2/mason/packages/$package
    if ! [[ -d $path && ! -L $path &&
      -f $path/mason-receipt.json && ! -L $path/mason-receipt.json ]]; then
      die "declared Mason package or receipt is missing: $package"
      return 1
    fi
    if [[ $python != - ]]; then
      python_rows+="$python"$'\t'"$version"$'\n'
    fi
    if [[ $commands == - ]]; then
      continue
    fi
    IFS=, read -r -a launchers <<<"$commands"
    for command_name in "${launchers[@]}"; do
      path=$release/share/nvim2/mason/bin/$command_name
      if [[ $mode == archive && $python != - ]]; then
        if [[ ! -L $path ]]; then
          die "declared Mason launcher is missing: $command_name"
          return 1
        fi
      else
        if [[ ! -x $path ]]; then
          die "declared Mason launcher is missing or not executable: $command_name"
          return 1
        fi
      fi
    done
  done <"$inventory"
  for path in "$release/share/nvim2/mason/packages"/*; do
    if [[ ! -e $path && ! -L $path ]]; then
      continue
    fi
    package=${path##*/}
    if [[ $seen != *" $package "* ]]; then
      die "undeclared Mason package is bundled: $package"
      return 1
    fi
  done
  expected_python=$(printf '%s' "$python_rows" | LC_ALL=C sort) || return
  actual_python=$(LC_ALL=C sort "$release/python-locks/inventory.tsv") || return
  if [[ $expected_python != "$actual_python" ]]; then
    die 'Python inventory differs from declared Mason packages'
    return 1
  fi
  seen=' '
  while IFS= read -r dependency; do
    case $dependency in
      nodejs | python | go | rg | terraform)
        ;;
      *)
        die "invalid Neovim tool requirement: $dependency"
        return 1
        ;;
    esac
    if [[ $seen == *" $dependency "* ]]; then
      die "duplicate Neovim tool requirement: $dependency"
      return 1
    fi
    seen+="$dependency "
    if ! list_has "$tools_name" "$dependency"; then
      die "configured Neovim tools require $dependency in OFFLINE_RELEASE_TOOLS"
      return 1
    fi
  done <"$requirements"
  if [[ -n $python_rows ]]; then
    if ! list_has "$tools_name" python; then
      die 'Python-backed Mason packages require bundled Python'
      return 1
    fi
  fi
  if list_has "$tools_name" yamllint; then
    if [[ $expected_python != *yamllint$'\t'* ]]; then
      die 'the public yamllint command requires yamllint in custom.lsp M.tools'
      return 1
    fi
  fi
}

python_inventory_packages() {
  local release=$1 inventory input_count lock_count
  inventory=$release/python-locks/inventory.tsv
  local package version extra requirement lock seen=' '
  local -a packages=()

  if ! [[ -f $inventory && ! -L $inventory ]]; then
    die 'Python package inventory is missing'
    return 1
  fi
  while IFS=$'\t' read -r package version extra; do
    if ! [[ -z $extra && $package =~ ^[a-z0-9][a-z0-9-]*$ &&
      $version =~ ^[0-9]+([.][0-9]+){1,3}([0-9A-Za-z.+-]*[0-9A-Za-z])?$ ]]; then
      die 'Python package inventory contains invalid data'
      return 1
    fi
    if [[ $seen == *" $package "* ]]; then
      die "duplicate Python package in inventory: $package"
      return 1
    fi
    seen+="$package "
    for lock in "$release/python-locks/$package.in" "$release/python-locks/$package.lock"; do
      if ! [[ -f $lock && ! -L $lock ]]; then
        die "Python input or lock is missing: $package"
        return 1
      fi
    done
    requirement=$(awk '!/^#/ && NF { print; exit }' "$release/python-locks/$package.in") || return
    if [[ $requirement != "$package==$version" ]]; then
      die "Python input does not match Mason inventory: $package==$version"
      return 1
    fi
    if ! awk -v requirement="$package==$version" \
      '$1 == requirement { found = 1 } END { exit !found }' \
      "$release/python-locks/$package.lock"; then
      die "Python lock does not match Mason inventory: $package==$version"
      return 1
    fi
    packages+=("$package")
  done <"$inventory"
  input_count=$(find "$release/python-locks" -maxdepth 1 -type f -name '*.in' -printf '.\n' |
    wc -l) || return
  lock_count=$(find "$release/python-locks" -maxdepth 1 -type f -name '*.lock' -printf '.\n' |
    wc -l) || return
  if ! [[ $input_count -eq ${#packages[@]} &&
    $lock_count -eq ${#packages[@]} ]]; then
    die 'Python lock set differs from the Mason inventory'
    return 1
  fi
  if ((${#packages[@]} > 0)); then
    printf '%s\n' "${packages[@]}"
  fi
}

python_mason_package() {
  local release=$1 python_package=$2
  local inventory=$release/share/nvim2/mason/inventory.tsv
  if ! awk -F '\t' -v package="$python_package" '
    $3 == package {
      name = $1
      count++
    }
    END {
      if (count != 1) {
        exit 1
      }
      print name
    }
  ' "$inventory"; then
    die "Python package has no unique Mason owner: $python_package"
    return 1
  fi
}
