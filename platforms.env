DEFAULT_DEV_PLATFORM=debian13

declare -gA PLATFORM_ALIASES=(
  [debian13]=debian-13-x86_64
  [ubuntu2404]=ubuntu-24.04-x86_64
  [ubuntu2604]=ubuntu-26.04-x86_64
  [amazonlinux2023]=amzn-2023-x86_64
)

declare -gA DOCKER_IMAGES=(
  [debian-13-x86_64]=docker.io/library/debian:13@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c
  [ubuntu-24.04-x86_64]=docker.io/library/ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316
  [ubuntu-26.04-x86_64]=docker.io/library/ubuntu:26.04@sha256:889d056d5c6c0bfb55789ff3710681d68e50713cb562d2196dc07110599c7a6f
  [amzn-2023-x86_64]=public.ecr.aws/amazonlinux/amazonlinux:2023@sha256:35c799f6759bc336f396e3cb26d6d7037c6bdcf8eed18ac0f8bd59dda66fa267
)

# Remote VM images use remote:fingerprint; direct QCOW2 downloads use "URL|SHA256".
# Remote pins resolved on 2026-11-14; comments retain their aliases and build dates.
declare -gA LXD_IMAGES=(
  [debian-13-x86_64]=images:d3116ba8b3d8c0df16ffc417f9bc59614070b5db84acdaf6075b2b05936cb658 # debian/13/cloud (20261113_0336)
  [ubuntu-24.04-x86_64]=ubuntu:a80e9c9fd0d484dec024da3e9e264bbad4ce159b5312d6e149ef6ad532e18e43 # 24.04 (20261017)
  [ubuntu-26.04-x86_64]=ubuntu:881c273c21f4b25aee6b336e8af993166766b6c263032f9db7a61bdb037bc6a6 # 26.04 (20261016)
  [amzn-2023-x86_64]="https://cdn.amazonlinux.com/al2023/os-images/2023.12.20261026.1/kvm/al2023-kvm-2023.12.20261026.1-kernel-6.1-x86_64.xfs.gpt.qcow2|547b7e403b5b78aad57cdaf4c4adcb6815534fa50ce7ae43e2c14dc36d8b759f"
)

# platforms built and installed by the default `task test`.
declare -ga OFFLINE_TEST_PLATFORMS=(
  debian-13-x86_64
  ubuntu-24.04-x86_64
  ubuntu-26.04-x86_64
  amzn-2023-x86_64
)

# platforms published by the GitHub offline-release workflow.
# This must be a subset of OFFLINE_TEST_PLATFORMS.
declare -ga OFFLINE_RELEASE_PLATFORMS=(
  debian-13-x86_64
  # ubuntu-24.04-x86_64 # publishing is paused
  # ubuntu-26.04-x86_64 # publishing is paused
  amzn-2023-x86_64
)
